{"jsonapi":{"version":"1.1","meta":{"links":{"self":{"href":"http:\/\/jsonapi.org\/format\/1.1\/"}}}},"data":{"type":"node--issue_unit","id":"4db008ba-e676-4d1c-90e7-2588383b5843","links":{"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/4db008ba-e676-4d1c-90e7-2588383b5843?resourceVersion=id%3A218005"}},"attributes":{"drupal_internal__nid":94905,"drupal_internal__vid":218005,"langcode":"hu","revision_timestamp":"2026-10-02T10:28:41+00:00","status":true,"title":"A F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1csa \u00fajb\u00f3li l\u00e9trehoz\u00e1s\u00e1val kapcsolatos egyes feladatok ell\u00e1t\u00e1s\u00e1r\u00f3l, valamint a\u00a0F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1cs\u00e1r\u00f3l sz\u00f3l\u00f3 1509\/2018.\u00a0(X. 17.) Korm.\u00a0hat\u00e1rozat hat\u00e1lyon k\u00edv\u00fcl helyez\u00e9s\u00e9r\u0151l","created":"2026-10-02T09:42:59+00:00","changed":"2026-10-02T10:34:45+00:00","promote":false,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":"published","path":{"alias":"\/fovarosi-kozfejlesztesek-tanacsa-ujboli-letrehozasaval-kapcsolatos-egyes-feladatok-ellatasarol","pid":19564,"langcode":"hu"},"content_translation_source":"und","content_translation_outdated":false,"api_endpoint_url":[{"uri":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/4db008ba-e676-4d1c-90e7-2588383b5843","title":"4db008ba-e676-4d1c-90e7-2588383b5843","options":[]},{"uri":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit","title":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit","options":[]}],"body":{"value":"\u003Cp\u003EA Korm\u00e1ny a\u0026nbsp;Budapest \u00e9s az\u0026nbsp;agglomer\u00e1ci\u00f3 fejleszt\u00e9s\u00e9vel \u00f6sszef\u00fcgg\u0151 \u00e1llami feladatokr\u00f3l, valamint egyes fejleszt\u00e9sek megval\u00f3s\u00edt\u00e1s\u00e1r\u00f3l, tov\u00e1bb\u00e1 egyes\u0026nbsp;t\u00f6rv\u00e9nyeknek a\u0026nbsp;Magyarorsz\u00e1g filmszakmai t\u00e1mogat\u00e1si programj\u00e1r\u00f3l sz\u00f3l\u00f3 SA.50768\u0026nbsp;sz\u00e1m\u00fa Eur\u00f3pai Bizotts\u00e1gi hat\u00e1rozattal \u00f6sszef\u00fcgg\u0151 m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2018.\u0026nbsp;\u00e9vi XLIX.\u0026nbsp;t\u00f6rv\u00e9ny 4\/B.\u0026nbsp;\u00a7-\u00e1ban foglaltakra tekintettel a\u0026nbsp;k\u00f6vetkez\u0151 hat\u00e1rozatot hozza:\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E1.\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1csa \u2013 a\u0026nbsp;Budapest \u00e9s az\u0026nbsp;agglomer\u00e1ci\u00f3 fejleszt\u00e9s\u00e9vel \u00f6sszef\u00fcgg\u0151 \u00e1llami feladatokr\u00f3l, valamint egyes fejleszt\u00e9sek megval\u00f3s\u00edt\u00e1s\u00e1r\u00f3l, tov\u00e1bb\u00e1 egyes\u0026nbsp;t\u00f6rv\u00e9nyeknek a\u0026nbsp;Magyarorsz\u00e1g filmszakmai t\u00e1mogat\u00e1si programj\u00e1r\u00f3l sz\u00f3l\u00f3 SA.50768\u0026nbsp;sz\u00e1m\u00fa Eur\u00f3pai Bizotts\u00e1gi hat\u00e1rozattal \u00f6sszef\u00fcgg\u0151 m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2018.\u0026nbsp;\u00e9vi XLIX.\u0026nbsp;t\u00f6rv\u00e9ny 4\/B.\u0026nbsp;\u00a7-a szerinti \u2013 l\u00e9trehoz\u00e1s\u00e1hoz kapcsol\u00f3d\u00f3an a\u0026nbsp;korm\u00e1nyoldal r\u00e9sz\u00e9r\u0151l a\u0026nbsp;F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1csa m\u0171k\u00f6d\u00e9s\u00e9vel, az\u0026nbsp;\u00fcl\u00e9sek el\u0151k\u00e9sz\u00edt\u00e9s\u00e9vel, a\u0026nbsp;d\u00f6nt\u00e9sekb\u0151l fakad\u00f3 int\u00e9zked\u00e9sek v\u00e9grehajt\u00e1s\u00e1nak korm\u00e1nyzati \u00f6sszehangol\u00e1s\u00e1val, valamint azok megval\u00f3sul\u00e1s\u00e1nak nyomon k\u00f6vet\u00e9s\u00e9vel \u00f6sszef\u00fcgg\u0151 feladatokat a\u0026nbsp;k\u00f6zleked\u00e9si \u00e9s beruh\u00e1z\u00e1si miniszter l\u00e1tja el.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E2.\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EEz\u0026nbsp;a\u0026nbsp;hat\u00e1rozat a\u0026nbsp;k\u00f6zz\u00e9t\u00e9tel\u00e9t k\u00f6vet\u0151\u0026nbsp;napon l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E3.\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EHat\u00e1ly\u00e1t veszti a\u0026nbsp;F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1cs\u00e1r\u00f3l sz\u00f3l\u00f3 1509\/2018.\u0026nbsp;(X.17.) Korm.\u0026nbsp;hat\u00e1rozat.\u003C\/p\u003E","format":"full_html","processed":"\u003Cp\u003EA Korm\u00e1ny a\u0026nbsp;Budapest \u00e9s az\u0026nbsp;agglomer\u00e1ci\u00f3 fejleszt\u00e9s\u00e9vel \u00f6sszef\u00fcgg\u0151 \u00e1llami feladatokr\u00f3l, valamint egyes fejleszt\u00e9sek megval\u00f3s\u00edt\u00e1s\u00e1r\u00f3l, tov\u00e1bb\u00e1 egyes\u0026nbsp;t\u00f6rv\u00e9nyeknek a\u0026nbsp;Magyarorsz\u00e1g filmszakmai t\u00e1mogat\u00e1si programj\u00e1r\u00f3l sz\u00f3l\u00f3 SA.50768\u0026nbsp;sz\u00e1m\u00fa Eur\u00f3pai Bizotts\u00e1gi hat\u00e1rozattal \u00f6sszef\u00fcgg\u0151 m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2018.\u0026nbsp;\u00e9vi XLIX.\u0026nbsp;t\u00f6rv\u00e9ny 4\/B.\u0026nbsp;\u00a7-\u00e1ban foglaltakra tekintettel a\u0026nbsp;k\u00f6vetkez\u0151 hat\u00e1rozatot hozza:\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E1.\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1csa \u2013 a\u0026nbsp;Budapest \u00e9s az\u0026nbsp;agglomer\u00e1ci\u00f3 fejleszt\u00e9s\u00e9vel \u00f6sszef\u00fcgg\u0151 \u00e1llami feladatokr\u00f3l, valamint egyes fejleszt\u00e9sek megval\u00f3s\u00edt\u00e1s\u00e1r\u00f3l, tov\u00e1bb\u00e1 egyes\u0026nbsp;t\u00f6rv\u00e9nyeknek a\u0026nbsp;Magyarorsz\u00e1g filmszakmai t\u00e1mogat\u00e1si programj\u00e1r\u00f3l sz\u00f3l\u00f3 SA.50768\u0026nbsp;sz\u00e1m\u00fa Eur\u00f3pai Bizotts\u00e1gi hat\u00e1rozattal \u00f6sszef\u00fcgg\u0151 m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2018.\u0026nbsp;\u00e9vi XLIX.\u0026nbsp;t\u00f6rv\u00e9ny 4\/B.\u0026nbsp;\u00a7-a szerinti \u2013 l\u00e9trehoz\u00e1s\u00e1hoz kapcsol\u00f3d\u00f3an a\u0026nbsp;korm\u00e1nyoldal r\u00e9sz\u00e9r\u0151l a\u0026nbsp;F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1csa m\u0171k\u00f6d\u00e9s\u00e9vel, az\u0026nbsp;\u00fcl\u00e9sek el\u0151k\u00e9sz\u00edt\u00e9s\u00e9vel, a\u0026nbsp;d\u00f6nt\u00e9sekb\u0151l fakad\u00f3 int\u00e9zked\u00e9sek v\u00e9grehajt\u00e1s\u00e1nak korm\u00e1nyzati \u00f6sszehangol\u00e1s\u00e1val, valamint azok megval\u00f3sul\u00e1s\u00e1nak nyomon k\u00f6vet\u00e9s\u00e9vel \u00f6sszef\u00fcgg\u0151 feladatokat a\u0026nbsp;k\u00f6zleked\u00e9si \u00e9s beruh\u00e1z\u00e1si miniszter l\u00e1tja el.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E2.\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EEz\u0026nbsp;a\u0026nbsp;hat\u00e1rozat a\u0026nbsp;k\u00f6zz\u00e9t\u00e9tel\u00e9t k\u00f6vet\u0151\u0026nbsp;napon l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E3.\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EHat\u00e1ly\u00e1t veszti a\u0026nbsp;F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1cs\u00e1r\u00f3l sz\u00f3l\u00f3 1509\/2018.\u0026nbsp;(X.17.) Korm.\u0026nbsp;hat\u00e1rozat.\u003C\/p\u003E\n","summary":""},"field_ai_summary":{"value":"\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyhat\u00e1rozat kijel\u00f6li, hogy a F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1cs\u00e1val kapcsolatos korm\u00e1nyzati feladatokat a k\u00f6zleked\u00e9si \u00e9s beruh\u00e1z\u00e1si miniszter l\u00e1tja el.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA miniszter feladatai k\u00f6z\u00e9 tartozik a Tan\u00e1cs m\u0171k\u00f6d\u00e9s\u00e9vel kapcsolatos teend\u0151k ell\u00e1t\u00e1sa, az \u00fcl\u00e9sek el\u0151k\u00e9sz\u00edt\u00e9se, a d\u00f6nt\u00e9sekb\u0151l k\u00f6vetkez\u0151 int\u00e9zked\u00e9sek korm\u00e1nyzati \u00f6sszehangol\u00e1sa, a v\u00e9grehajt\u00e1s nyomon k\u00f6vet\u00e9se.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyhat\u00e1rozat a k\u00f6zz\u00e9t\u00e9tel\u00e9t k\u00f6vet\u0151 napon l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EEzzel egyidej\u0171leg hat\u00e1ly\u00e1t veszti a F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1cs\u00e1r\u00f3l sz\u00f3l\u00f3 kor\u00e1bbi, 1509\/2018. (X. 17.) Korm. hat\u00e1rozat.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003C\/ul\u003E\n","format":"full_html","processed":"\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyhat\u00e1rozat kijel\u00f6li, hogy a F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1cs\u00e1val kapcsolatos korm\u00e1nyzati feladatokat a k\u00f6zleked\u00e9si \u00e9s beruh\u00e1z\u00e1si miniszter l\u00e1tja el.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA miniszter feladatai k\u00f6z\u00e9 tartozik a Tan\u00e1cs m\u0171k\u00f6d\u00e9s\u00e9vel kapcsolatos teend\u0151k ell\u00e1t\u00e1sa, az \u00fcl\u00e9sek el\u0151k\u00e9sz\u00edt\u00e9se, a d\u00f6nt\u00e9sekb\u0151l k\u00f6vetkez\u0151 int\u00e9zked\u00e9sek korm\u00e1nyzati \u00f6sszehangol\u00e1sa, a v\u00e9grehajt\u00e1s nyomon k\u00f6vet\u00e9se.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyhat\u00e1rozat a k\u00f6zz\u00e9t\u00e9tel\u00e9t k\u00f6vet\u0151 napon l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EEzzel egyidej\u0171leg hat\u00e1ly\u00e1t veszti a F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1cs\u00e1r\u00f3l sz\u00f3l\u00f3 kor\u00e1bbi, 1509\/2018. (X. 17.) Korm. hat\u00e1rozat.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003C\/ul\u003E\n"},"field_correction":false,"field_njt_url":null,"field_page_number":4,"field_regulation_number":"1320\/2026. (X. 1.) Korm. hat\u00e1rozat","field_regulation_title":"A F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1csa \u00fajb\u00f3li l\u00e9trehoz\u00e1s\u00e1val kapcsolatos egyes feladatok ell\u00e1t\u00e1s\u00e1r\u00f3l, valamint a\u00a0F\u0151v\u00e1rosi K\u00f6zfejleszt\u00e9sek Tan\u00e1cs\u00e1r\u00f3l sz\u00f3l\u00f3 1509\/2018.\u00a0(X. 17.) Korm.\u00a0hat\u00e1rozat hat\u00e1lyon k\u00edv\u00fcl helyez\u00e9s\u00e9r\u0151l","field_synonym":"gyermekgondoz\u00e1st seg\u00edt\u0151 ell\u00e1t\u00e1s\nnyaral\u00f3\nrecept"},"relationships":{"node_type":{"data":{"type":"node_type--node_type","id":"2de4f0c4-1ed1-4766-9521-6ae4441af5d5","meta":{"drupal_internal__target_id":"issue_unit"}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/4db008ba-e676-4d1c-90e7-2588383b5843\/node_type?resourceVersion=id%3A218005"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/4db008ba-e676-4d1c-90e7-2588383b5843\/relationships\/node_type?resourceVersion=id%3A218005"}}},"revision_uid":{"data":{"type":"user--user","id":"88687bb7-61de-4013-a5bd-0bddeed53e90","meta":{"drupal_internal__target_