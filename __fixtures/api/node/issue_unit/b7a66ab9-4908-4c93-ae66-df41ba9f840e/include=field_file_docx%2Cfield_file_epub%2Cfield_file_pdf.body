/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Es\u00ed\u00f6lt\u00f6ny\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E47\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6212\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EMelltart\u00f3, cs\u00edp\u0151szor\u00edt\u00f3, f\u0171z\u0151, nadr\u00e1gtart\u00f3, harisnyatart\u00f3, zoknitart\u00f3 \u00e9s hasonl\u00f3 \u00e1ru \u00e9s ezek r\u00e9szei, k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Emelltart\u00f3\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Ecs\u00edp\u0151szor\u00edt\u00f3, f\u0171z\u0151, nadr\u00e1gtart\u00f3, harisnyatart\u00f3, zoknitart\u00f3\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6214\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKend\u0151, s\u00e1l, nyaks\u00e1l, mantilla, f\u00e1tyol \u00e9s hasonl\u00f3\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKend\u0151, s\u00e1l, nyaks\u00e1l\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Emantilla, f\u00e1tyol\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6215\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyakkend\u0151, csokornyakkend\u0151 \u00e9s krav\u00e1tli\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyakkend\u0151, csokornyakkend\u0151 \u00e9s krav\u00e1tli\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E50\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6216\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKeszty\u0171, ujjatlan \u00e9s egyujjas keszty\u0171 is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKeszty\u0171, ujjatlan \u00e9s egyujjas keszty\u0171 is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E51\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6217\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s konfekcion\u00e1lt ruh\u00e1zati kell\u00e9kek \u00e9s tartoz\u00e9kok; ruh\u00e1k vagy ruh\u00e1zati kell\u00e9kek \u00e9s tartoz\u00e9kok r\u00e9szei, a\u0026nbsp;6212\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3k kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E52\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd rowspan=\u00226\u0022\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd rowspan=\u00226\u0022\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e1bbelik\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd rowspan=\u00226\u0022\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E64\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6401\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EV\u00edzhatlan l\u00e1bbeli gumi- vagy m\u0171anyag k\u00fcls\u0151 talppal \u00e9s fels\u0151r\u00e9sszel, ha a\u0026nbsp;fels\u0151r\u00e9sz a\u0026nbsp;talphoz sem t\u0171z\u00e9ssel, szegecsel\u00e9ssel, sz\u00f6gel\u00e9ssel, csavaroz\u00e1ssal vagy hasonl\u00f3 elj\u00e1r\u00e1ssal nincs hozz\u00e1er\u0151s\u00edtve vagy \u00f6ssze\u00e1ll\u00edtva\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E-\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E53\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6402\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s l\u00e1bbeli gumi- vagy m\u0171anyag k\u00fcls\u0151 talppal \u00e9s fels\u0151r\u00e9sszel\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESportcip\u0151 (6402 12), L\u00e1bbelik, p\u00e1ntb\u00f3l vagy sz\u00edjb\u00f3l \u00e1ll\u00f3 fels\u0151r\u00e9sze a\u0026nbsp;talphoz szegeccsel er\u0151s\u00edtve (6402 20)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ES\u00edcip\u0151, s\u00edbakancs, s\u00edfut\u00f3cip\u0151 \u00e9s h\u00f3deszkacip\u0151 (6402 12)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E54\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6403\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e1bbeli gumi-, m\u0171anyag, b\u0151r- vagy mesters\u00e9ges b\u0151r k\u00fcls\u0151 talppal \u00e9s b\u0151r fels\u0151r\u00e9sszel\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESportcip\u0151 (6403 12)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ES\u00edcip\u0151, s\u00edbakancs, s\u00edfut\u00f3cip\u0151 \u00e9s h\u00f3deszkacip\u0151 (6403 12)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E55\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6404\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e1bbeli gumi-, m\u0171anyag, b\u0151r- vagy mesters\u00e9ges b\u0151r k\u00fcls\u0151 talppal \u00e9s textilanyag fels\u0151r\u00e9sszel\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e1bbeli, gumi- vagy m\u0171anyag k\u00fcls\u0151 talppal (6404 11) Sportcip\u0151; tornacip\u0151, edz\u0151cip\u0151 \u00e9s hasonl\u00f3 (6404 11)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETeniszcip\u0151, kos\u00e1rlabdacip\u0151 (6404\u0026nbsp;11)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E56\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6405\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s l\u00e1bbeli\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E57\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6406\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e1bbelir\u00e9sz (bele\u00e9rtve a\u0026nbsp;fels\u0151r\u00e9szt is, a\u0026nbsp;bels\u0151 talphoz er\u0151s\u00edtve is); kiemelhet\u0151 talpb\u00e9l\u00e9s, sarokemel\u0151 \u00e9s hasonl\u00f3 \u00e1ru; l\u00e1bsz\u00e1rv\u00e9d\u0151, bokav\u00e9d\u0151 \u00e9s hasonl\u00f3 \u00e1ru \u00e9s ezek r\u00e9szei\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKivehet\u0151 talpbet\u00e9t \u00e9s m\u00e1s kivehet\u0151 r\u00e9szek (6406 90 50)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EFels\u0151r\u00e9sz \u00e9s r\u00e9szei, a\u0026nbsp;k\u00e9reg kiv\u00e9tel\u00e9vel (6406 10), K\u00fcls\u0151 talp \u00e9s sarok gumib\u00f3l vagy m\u0171anyagb\u00f3l (6406 20), M\u00e1s (6406\u0026nbsp;90), Fels\u0151r\u00e9sz-\u00f6ssze\u00e1ll\u00edt\u00e1sok, a\u0026nbsp;talpb\u00e9l\u00e9shez vagy m\u00e1s talpr\u00e9szhez er\u0151s\u00edtve, de a\u0026nbsp;k\u00fcls\u0151 talp n\u00e9lk\u00fcl (6406 90 30), K\u00fcls\u0151 talp b\u0151rb\u0151l vagy mesters\u00e9ges b\u0151rb\u0151l (6406 90 60)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E58\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd rowspan=\u00223\u0022\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd rowspan=\u00223\u0022\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKalapok, sapk\u00e1k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd rowspan=\u00223\u0022\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E65\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6504\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EB\u00e1rmilyen anyag\u00fa szalagb\u00f3l fon\u00e1ssal vagy m\u00e1s m\u00f3don \u00f6ssze\u00e1ll\u00edtott kalap \u00e9s m\u00e1s fejfed\u0151, b\u00e9lelve vagy d\u00edsz\u00edtve is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u0026nbsp;\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E59\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6505\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKalap \u00e9s m\u00e1s fejfed\u0151 k\u00f6t\u00f6tt vagy hurkolt kelm\u00e9b\u0151l vagy csipk\u00e9b\u0151l, nemezb\u0151l vagy m\u00e1s textilanyagb\u00f3l (de nem szalagb\u00f3l) el\u0151\u00e1ll\u00edtva, b\u00e9lelve vagy d\u00edsz\u00edtve is; hajh\u00e1l\u00f3 b\u00e1rmilyen anyagb\u00f3l, b\u00e9lelve vagy d\u00edsz\u00edtve is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E60\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6506\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u0026nbsp;\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s fejfed\u0151, b\u00e9lelve vagy d\u00edsz\u00edtve is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E61\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati tartoz\u00e9kok\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E39\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E392620\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek \u00e9s ruh\u00e1zati tartoz\u00e9kok (bele\u00e9rtve a\u0026nbsp;keszty\u0171t, az\u0026nbsp;ujjatlan \u00e9s egyujjas keszty\u0171t is)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E62\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGy\u00f3gyszerek \u00e9s t\u00e1pl\u00e1l\u00e9kkieg\u00e9sz\u00edt\u0151k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ET\u00e1pl\u00e1l\u00e9kkieg\u00e9sz\u00edt\u0151k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E29\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E2936\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETerm\u00e9szetes vagy szintetikus \u00faton el\u0151\u00e1ll\u00edtott provitaminok \u00e9s vitaminok (term\u00e9szetes koncentr\u00e1tum is), ezek sz\u00e1rmaz\u00e9kai, amelyeket els\u0151dlegesen, mint vitamint haszn\u00e1lnak, valamint ezek egym\u00e1s k\u00f6zti kever\u00e9kei, b\u00e1rmilyen old\u00f3szerben is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EVitaminok \u00e9s sz\u00e1rmaz\u00e9kaik, nem kevertek (2936\u0026nbsp;21), A-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936 21), B1-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936 22), B2-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936\u0026nbsp;23), D- vagy DL-pantot\u00e9nsav (B5 vitamin) \u00e9s sz\u00e1rmaz\u00e9kai (2936\u0026nbsp;24), B6-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936 25), B12-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936 26), C-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936\u0026nbsp;27), E-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936 28)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E63\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGy\u00f3gy\u00e1szati seg\u00e9deszk\u00f6z\u00f6k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBraille t\u00e1bla\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E39, 83\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E392690, 8310\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u0171anyagb\u00f3l k\u00e9sz\u00fclt m\u00e1s \u00e1ruk \u00e9s a\u0026nbsp;3901\u20133914 vtsz. al\u00e1 tartoz\u00f3 m\u00e1s anyagokb\u00f3l k\u00e9sz\u00fclt \u00e1ruk.\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EJelz\u0151t\u00e1bla, n\u00e9vt\u00e1bla,\u0026nbsp;c\u00edmt\u00e1bla \u00e9s hasonl\u00f3 t\u00e1bla, sz\u00e1m, bet\u0171 \u00e9s m\u00e1s jel nem nemesf\u00e9mb\u0151l, a\u0026nbsp;9405 vtsz. al\u00e1 tartoz\u00f3 kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u0171anyag Braille t\u00e1bla (3926 90 97 90),\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9m Braille t\u00e1bla (8310 00 00 00)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EA megnevezett term\u00e9ken k\u00edv\u00fcl b\u00e1rmi m\u00e1s, a\u0026nbsp;kateg\u00f3ri\u00e1ba tartoz\u00f3 term\u00e9k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E64\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGy\u00f3gy\u00e1szati seg\u00e9deszk\u00f6z\u00f6k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00e9zi\u0026nbsp;pontoz\u00f3\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E82\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8205\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1shol nem eml\u00edtett k\u00e9ziszersz\u00e1m (bele\u00e9rtve a\u0026nbsp;gy\u00e9m\u00e1nthegy\u0171 \u00fcvegv\u00e1g\u00f3t is); forraszt\u00f3l\u00e1mpa; satu, befog\u00f3pofa \u00e9s hasonl\u00f3, a\u0026nbsp;szersz\u00e1mg\u00e9p vagy v\u00edzsugaras v\u00e1g\u00f3g\u00e9p tartoz\u00e9ka \u00e9s alkatr\u00e9sze kiv\u00e9tel\u00e9vel; \u00fcll\u0151; hordozhat\u00f3 kov\u00e1cst\u0171zhely; \u00e1llv\u00e1nyra szerelt, k\u00e9zi vagy l\u00e1bmeghajt\u00e1ssal m\u0171k\u00f6d\u0151 k\u00f6sz\u00f6r\u0171k\u0151\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00e9zi\u0026nbsp;pontoz\u00f3 vakoknak (8205 59 80 00)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EA megnevezett term\u00e9ken k\u00edv\u00fcl b\u00e1rmi m\u00e1s, a\u0026nbsp;kateg\u00f3ri\u00e1ba tartoz\u00f3 term\u00e9k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E65\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGy\u00f3gy\u00e1szati seg\u00e9deszk\u00f6z\u00f6k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EOrtop\u00e9diai eszk\u00f6z, fogyat\u00e9koss\u00e1g korrig\u00e1l\u00e1s\u00e1ra szolg\u00e1l\u00f3 eszk\u00f6z\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E90\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9021\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EOrtop\u00e9diai berendez\u00e9s, mank\u00f3, seb\u00e9szeti \u00f6v \u00e9s s\u00e9rvk\u00f6t\u0151; s\u00edn \u00e9s t\u00f6r\u00e9sn\u00e9l alkalmazhat\u00f3 m\u00e1s eszk\u00f6z; m\u0171testr\u00e9sz; hall\u00f3k\u00e9sz\u00fcl\u00e9k, tov\u00e1bb\u00e1 fogyat\u00e9koss\u00e1g vagy rokkants\u00e1g korrig\u00e1l\u00e1s\u00e1ra szolg\u00e1l\u00f3 \u00e9s testen viselhet\u0151 vagy hordozhat\u00f3, vagy szervezetbe be\u00fcltethet\u0151 m\u00e1s k\u00e9sz\u00fcl\u00e9k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EOrtop\u00e9diai vagy csontt\u00f6r\u00e9sn\u00e9l alkalmazott berendez\u00e9sek (9021 10), M\u00e1s m\u0171testr\u00e9sz (9021 31), Nagyothall\u00f3-k\u00e9sz\u00fcl\u00e9k, az\u0026nbsp;alkatr\u00e9sz \u00e9s tartoz\u00e9k kiv\u00e9tel\u00e9vel (9021 40), Sz\u00edvritmus-szab\u00e1lyoz\u00f3 k\u00e9sz\u00fcl\u00e9k (pacemaker), az\u0026nbsp;alkatr\u00e9sz \u00e9s tartoz\u00e9k kiv\u00e9tel\u00e9vel (9021 50)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u0171fog \u00e9s fogp\u00f3tl\u00e1s (9021 21)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E66\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGy\u00f3gy\u00e1szati seg\u00e9deszk\u00f6z\u00f6k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESzem\u00fcveg\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E90\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9004\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESzem\u00fcveg, v\u00e9d\u0151szem\u00fcveg \u00e9s hasonl\u00f3, l\u00e1t\u00e1sjav\u00edt\u00f3, v\u00e9d\u0151- vagy m\u00e1s szem\u00fcveg\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENapszem\u00fcveg optikailag megmunk\u00e1lt lencs\u00e9vel (9004 10)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E67\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EOptikai eszk\u00f6z\u00f6k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENagy\u00edt\u00f3\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E90\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e9zer, a\u0026nbsp;l\u00e9zerdi\u00f3da kiv\u00e9tel\u00e9vel; ebben az\u0026nbsp;\u00e1rucsoportban m\u00e1shol nem eml\u00edtett m\u00e1s optikai k\u00e9sz\u00fcl\u00e9k \u00e9s m\u0171szer\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00e9zi nagy\u00edt\u00f3 (9013 80 80 00)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ET\u00e1vcs\u0151, teleszk\u00f3p, l\u00e9zer\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E68\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis \u00e9s m\u0171szaki cikkek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESz\u00e1mol\u00f3g\u00e9p\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E84\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E847010, 847021, 847030\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EElektronikus sz\u00e1mol\u00f3g\u00e9p, k\u00fcls\u0151 elektromos \u00e1ramforr\u00e1s n\u00e9lk\u00fcl m\u0171k\u00f6d\u0151 \u00e9s sz\u00e1mol\u00f3 funkci\u00f3val ell\u00e1tott zsebm\u00e9ret\u0171 adatr\u00f6gz\u00edt\u0151, el\u0151h\u00edv\u00f3 \u00e9s megjelen\u00edt\u0151g\u00e9p, M\u00e1s elektronikus sz\u00e1mol\u00f3g\u00e9p, M\u00e1s sz\u00e1mol\u00f3g\u00e9p\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E69\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis \u00e9s m\u0171szaki cikkek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis nagy\u00edt\u00f3\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E85\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8528\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EMonitorok \u00e9s kivet\u00edt\u0151k, be\u00e9p\u00edtett telev\u00edzi\u00f3vev\u0151-k\u00e9sz\u00fcl\u00e9k n\u00e9lk\u00fcl; telev\u00edzi\u00f3s ad\u00e1s v\u00e9tel\u00e9re alkalmas k\u00e9sz\u00fcl\u00e9k, r\u00e1di\u00f3m\u0171sor-vev\u0151k\u00e9sz\u00fcl\u00e9ket vagy hang- vagy k\u00e9pfelvev\u0151 vagy -lej\u00e1tsz\u00f3 k\u00e9sz\u00fcl\u00e9ket mag\u00e1ban\u0026nbsp;foglal\u00f3\u0026nbsp;is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis nagy\u00edt\u00f3 (8528)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;Telev\u00edzi\u00f3 k\u00e9sz\u00fcl\u00e9kek, sz\u00e1m\u00edt\u00f3g\u00e9p monitorok, projektorok\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E70\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis \u00e9s m\u0171szaki cikkek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EHangosk\u00f6nyv lej\u00e1tsz\u00f3\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E85\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8519\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EHangfelvev\u0151- vagy hanglej\u00e1tsz\u00f3 k\u00e9sz\u00fcl\u00e9k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EHangosk\u00f6nyv lej\u00e1tsz\u00f3 (8518 81)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EZeneg\u00e9pek, zenelej\u00e1tsz\u00f3k (8519\u0026nbsp;20), lemezj\u00e1tsz\u00f3k (8519 30)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E71\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis \u00e9s m\u0171szaki cikkek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPendrive, hangosk\u00f6nyv\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E85\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8523, 8543\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ELemezek, szalagok, szil\u00e1rd, \u00e1lland\u00f3 nem felejt\u0151 t\u00e1rol\u00f3 eszk\u00f6z\u00f6k, \u201cintelligens k\u00e1rty\u00e1k\u201d \u00e9s m\u00e1s adathordoz\u00f3k hang vagy m\u00e1s jel r\u00f6gz\u00edt\u00e9s\u00e9re, r\u00f6gz\u00edtett is, bele\u00e9rtve a\u0026nbsp;matric\u00e1t \u00e9s a\u0026nbsp;mesterlemezt lemezek gy\u00e1rt\u00e1s\u00e1hoz, a\u0026nbsp;37. \u00e1rucsoportba tartoz\u00f3 term\u00e9kek kiv\u00e9tel\u00e9vel.\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EEbben az\u0026nbsp;\u00e1rucsoportban m\u00e1shol nem eml\u00edtett elektromos g\u00e9p \u00e9s k\u00e9sz\u00fcl\u00e9k egyedi feladatokra\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9lvezet\u0151 adathordoz\u00f3 (8523 51),\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBraille kijelz\u0151 (8543)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EOptikai adathordoz\u00f3 (8523\u0026nbsp;41), M\u00e1gneses adathordoz\u00f3 (8523\u0026nbsp;21)\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EA megnevezett term\u00e9ken k\u00edv\u00fcl b\u00e1rmi m\u00e1s, a\u0026nbsp;kateg\u00f3ri\u00e1ba tartoz\u00f3 term\u00e9k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E72\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis \u00e9s m\u0171szaki cikkek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESz\u00e1m\u00edt\u00f3g\u00e9p \u00e9s perif\u00e9ri\u00e1i\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E84\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8471\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EAutomatikus adatfeldolgoz\u00f3 g\u00e9p \u00e9s egys\u00e9gei; m\u00e1gneses vagy optikai leolvas\u00f3, adat\u00e1t\u00edr\u00f3 g\u00e9p a\u0026nbsp;k\u00f3dolt adat adathordoz\u00f3ra t\u00f6rt\u00e9n\u0151 \u00e1t\u00edr\u00e1s\u00e1ra \u00e9s m\u00e1shol nem eml\u00edtett g\u00e9p ilyen adatok feldolgoz\u00e1s\u00e1hoz\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E10 kg-n\u00e1l nem nehezebb hordozhat\u00f3 automatikus adatfeldolgoz\u00f3 g\u00e9p, amely legal\u00e1bb egy k\u00f6zponti feldolgoz\u00f3egys\u00e9get, egy billenty\u0171zetet \u00e9s egy megjelen\u00edt\u0151 egys\u00e9get tartalmaz (8471 30), M\u00e1s automatikus adatfeldolgoz\u00f3 g\u00e9p (8471 41), Feldolgoz\u00f3egys\u00e9g a\u0026nbsp;8471\u0026nbsp;41\u0026nbsp;vagy a\u0026nbsp;8471 49 alsz\u00e1m al\u00e1 tartoz\u00f3k kiv\u00e9tel\u00e9vel, ak\u00e1r tartalmaz egy burkolaton bel\u00fcl a\u0026nbsp;k\u00f6vetkez\u0151 egys\u00e9gekb\u0151l egyet vagy kett\u0151t, ak\u00e1r nem: t\u00e1rol\u00f3egys\u00e9g, inputegys\u00e9g, outputegys\u00e9g (8471\u0026nbsp;50), Input- vagy outputegys\u00e9g, t\u00e1rol\u00f3egys\u00e9ggel egy\u0026nbsp;burkolatban is (8471\u0026nbsp;60), T\u00e1rol\u00f3egys\u00e9g (8471 70), M\u00e1s\u0026nbsp;egys\u00e9g automatikus adatfeldolgoz\u00f3 g\u00e9pekhez (8471 80)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E73\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIrodai g\u00e9p\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBraille nyomtat\u00f3\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESpeci\u00e1lis Braille \u00edr\u00f3g\u00e9p\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E84\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8443, 84729080\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyomdaipari g\u00e9p, amely nyom\u00f3lapok, nyom\u00f3hengerek \u00e9s m\u00e1s, a\u0026nbsp;8442 vtsz. al\u00e1 tartoz\u00f3 nyom\u00f3alkatr\u00e9szek seg\u00edts\u00e9g\u00e9vel m\u0171k\u00f6dik; m\u00e1s\u0026nbsp;nyomtat\u00f3k, m\u00e1sol\u00f3g\u00e9pek \u00e9s faxg\u00e9pek, kombin\u00e1lva is; ezek\u0026nbsp;alkatr\u00e9szei \u00e9s tartoz\u00e9kai. M\u00e1s irodai g\u00e9p-M\u00e1s-M\u00e1s\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBraille nyomtat\u00f3 (8443)\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s (84729080)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EA megnevezett term\u00e9ken k\u00edv\u00fcl b\u00e1rmi m\u00e1s, a\u0026nbsp;kateg\u00f3ri\u00e1ba tartoz\u00f3 term\u00e9k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E74\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EJ\u00e1t\u00e9kok\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EFejleszt\u0151j\u00e1t\u00e9kok\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E95\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9503, 95049080\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETriciklik, rollerek, ped\u00e1los aut\u00f3k \u00e9s hasonl\u00f3 kerekes j\u00e1t\u00e9kok; j\u00e1t\u00e9k babakocsik; bab\u00e1k; m\u00e1s j\u00e1t\u00e9kok; cs\u00f6kkentett m\u00e9ret\u0171 (\u201cm\u00e9retar\u00e1nyos\u201d) modellek \u00e9s sz\u00f3rakoz\u00e1sra sz\u00e1nt hasonl\u00f3 modellek, m\u0171k\u00f6d\u0151 is; mindenf\u00e9le kirak\u00f3s j\u00e1t\u00e9kok (puzzle).\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EAsztali vagy t\u00e1rsasj\u00e1t\u00e9k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKiz\u00e1r\u00f3lag embert \u00e1br\u00e1zol\u00f3 j\u00e1t\u00e9kbaba, \u00e9s r\u00e9sz \u00e9s tartoz\u00e9k (9503 00 21), M\u00e1s \u00e9p\u00edt\u0151k\u00e9szlet \u00e9s \u00e9p\u00edt\u0151j\u00e1t\u00e9k (9503 00\u0026nbsp;35), J\u00e1t\u00e9k hangszer \u00e9s k\u00e9sz\u00fcl\u00e9k (9503 00 55), Kirak\u00f3s j\u00e1t\u00e9k (puzzle) (9503 00 61), M\u00e1s j\u00e1t\u00e9k k\u00e9szletben (9503 00 70),\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s (95049080)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETriciklik, rollerek, ped\u00e1los aut\u00f3k \u00e9s hasonl\u00f3 kerekes j\u00e1t\u00e9kok; j\u00e1t\u00e9k babakocsik (9503 00 10), Villanyvonat, v\u00e1g\u00e1ny, jelz\u0151l\u00e1mpa \u00e9s m\u00e1s tartoz\u00e9kai; cs\u00f6kkentett m\u00e9ret\u0171 \u201cm\u00e9retar\u00e1nyos\u201d \u00f6sszeszerelhet\u0151 modell k\u00e9szletben, m\u0171k\u00f6d\u0151\u0026nbsp;is (9503\u0026nbsp;00\u0026nbsp;30), \u00c1llatot vagy nem embert \u00e1br\u00e1zol\u00f3 j\u00e1t\u00e9k (9503\u0026nbsp;00\u0026nbsp;41), Be\u00e9p\u00edtett motorral m\u0171k\u00f6d\u0151 m\u00e1s j\u00e1t\u00e9k \u00e9s modell (9503 00\u0026nbsp;75)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003C\/tbody\u003E\n\u003C\/table\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E2. mell\u00e9klet a 223\/2026. (X. 1.) Korm. rendelethez\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003EAz iskolakezd\u00e9si utalv\u00e1ny tartalmi \u00e9s formai felt\u00e9telei\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003EAz iskolakezd\u00e9si utalv\u00e1ny\u003C\/p\u003E\n\u003Cp\u003E1.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E6 darab 5000, 6 darab 2000, 8 darab 1000 forintos c\u00edmlet\u0171 vagy az R. 3. \u00a7 (4) bekezd\u00e9se szerinti esetben 3\u0026nbsp;darab 5000 forint, 3 darab 2000 forint, 4 darab 1000 forint c\u00edmlet\u0171,\u003C\/p\u003E\n\u003Cp\u003E2.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Esorsz\u00e1mozott \u00e9s vonalk\u00f3ddal ell\u00e1tott,\u003C\/p\u003E\n\u003Cp\u003E3.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Eegyedi v\u00edzjelet tartalmaz,\u003C\/p\u003E\n\u003Cp\u003E4.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Etartalmazza a kibocs\u00e1t\u00f3 megnevez\u00e9s\u00e9t,\u003C\/p\u003E\n\u003Cp\u003E5.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Etartalmazza az \u00e9rv\u00e9nyess\u00e9gi idej\u00e9t,\u003C\/p\u003E\n\u003Cp\u003E6.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea kincst\u00e1r \u00e1ltal meghat\u00e1rozott \u00e9s a honlapj\u00e1n nyilv\u00e1noss\u00e1gra hozott biztons\u00e1gi elemekkel rendelkezik.\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n","summary":""},"field_ai_summary":{"value":"\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyrendelet az iskolakezd\u00e9si t\u00e1mogat\u00e1s utalv\u00e1nyos form\u00e1j\u00e1nak r\u00e9szletes szab\u00e1lyait hat\u00e1rozza meg, vagyis azt, hogyan k\u00e9sz\u00fcl, k\u00e9zbes\u00edtik, haszn\u00e1lj\u00e1k fel \u00e9s v\u00e1ltj\u00e1k be az iskolakezd\u00e9si utalv\u00e1nyt.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz iskolakezd\u00e9si utalv\u00e1ny pap\u00edralap\u00fa fizet\u00e9si eszk\u00f6z, amelyet a Magyar \u00c1llamkincst\u00e1r bocs\u00e1t ki, \u00e9s csak meghat\u00e1rozott iskolaszerek, iskolakezd\u00e9shez kapcsol\u00f3d\u00f3 term\u00e9kek v\u00e1s\u00e1rl\u00e1s\u00e1ra lehet felhaszn\u00e1lni.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA jogosult f\u0151szab\u00e1ly szerint \u00f6sszesen 50 000 forint \u00e9rt\u00e9k\u0171 utalv\u00e1nyt kap, 6 darab 5000 forintos, 6 darab 2000 forintos, 8 darab 1000 forintos c\u00edmletben.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EEgyes k\u00fcl\u00f6n szab\u00e1lyozott esetekben a jogosultat 25 000 forint \u00e9rt\u00e9k\u0171 utalv\u00e1ny illeti meg, 3 darab 5000 forintos, 3 darab 2000 forintos, 4 darab 1000 forintos c\u00edmletben.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1nyok el\u0151\u00e1ll\u00edt\u00e1s\u00e1ban \u00e9s k\u00e9zbes\u00edt\u00e9sre el\u0151k\u00e9sz\u00edt\u00e9s\u00e9ben a Magyar \u00c1llamkincst\u00e1r mellett a NISZ Zrt. m\u0171k\u00f6dik k\u00f6zre, a k\u00e9zbes\u00edt\u00e9st az egyetemes postai szolg\u00e1ltat\u00f3 v\u00e9gzi.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1nyokat 2026. november 30-\u00e1ig kell k\u00e9zbes\u00edteni vagy legal\u00e1bb megk\u00eds\u00e9relni k\u00e9zbes\u00edteni a jogosultaknak.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA posta csak egyszer k\u00eds\u00e9rli meg a k\u00e9zbes\u00edt\u00e9st, sikertelen k\u00e9zbes\u00edt\u00e9s eset\u00e9n az ism\u00e9telt kik\u00fcld\u00e9st a Magyar \u00c1llamkincst\u00e1rn\u00e1l lehet k\u00e9rni, legk\u00e9s\u0151bb 2027. janu\u00e1r 8-\u00e1ig.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EHa az utalv\u00e1nyt a c\u00edmzett hal\u00e1la miatt nem lehet k\u00e9zbes\u00edteni, akkor k\u00e9relemre \u00e1tadhat\u00f3 annak, aki a gyermekr\u0151l saj\u00e1t h\u00e1ztart\u00e1s\u00e1ban gondoskodik, illetve int\u00e9zm\u00e9nyi elhelyez\u00e9s eset\u00e9n az int\u00e9zm\u00e9nyvezet\u0151nek; a k\u00e9relem hat\u00e1rideje 2027. febru\u00e1r 15.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1ny 2027. m\u00e1rcius 15-\u00e9ig haszn\u00e1lhat\u00f3 fel.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1nyt az iskolaszert \u00e1rus\u00edt\u00f3, a rendeletben meghat\u00e1rozott tev\u00e9kenys\u00e9gi k\u00f6r\u0171 keresked\u0151k k\u00f6telesek elfogadni iskolaszer v\u00e1s\u00e1rl\u00e1sa eset\u00e9n.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA keresked\u0151nek ellen\u0151riznie kell az utalv\u00e1ny formai \u00e9s biztons\u00e1gi elemeit, csak megfelel\u0151 utalv\u00e1nyt fogadhat el, az utalv\u00e1nyt n\u00e9v\u00e9rt\u00e9ken sz\u00e1m\u00edthatja be, k\u00e9szp\u00e9nzre nem v\u00e1lthatja \u00e1t.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA keresked\u0151k az elfogadott utalv\u00e1nyokat 2027. m\u00e1jus 15-\u00e9ig v\u00e1lthatj\u00e1k be p\u00e9nzforgalmi szolg\u00e1ltat\u00f3n\u00e1l.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA bev\u00e1lt\u00e1skor a p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 ellen\u0151rzi az utalv\u00e1ny eredetis\u00e9g\u00e9t, sorsz\u00e1m\u00e1t \u00e9s biztons\u00e1gi elemeit, majd az ellen\u00e9rt\u00e9ket a keresked\u0151nek kifizeti, legfeljebb 1% bev\u00e1lt\u00e1si d\u00edj levon\u00e1s\u00e1val.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA p\u00e9nzforgalmi szolg\u00e1ltat\u00f3k fel\u00e9 az utalv\u00e1nyok ellen\u00e9rt\u00e9k\u00e9t a Magyar \u00c1llamkincst\u00e1r t\u00e9r\u00edti meg, heti elsz\u00e1mol\u00e1ssal; a v\u00e9gs\u0151 elsz\u00e1mol\u00e1s hat\u00e1rideje 2027. augusztus 15.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1ny kibocs\u00e1t\u00e1s\u00e1nak, gy\u00e1rt\u00e1s\u00e1nak \u00e9s k\u00e9zbes\u00edt\u00e9s\u00e9nek k\u00f6lts\u00e9geit a k\u00f6zponti k\u00f6lts\u00e9gvet\u00e9s fedezi, az utalv\u00e1nyok ellen\u00e9rt\u00e9k\u00e9nek elsz\u00e1mol\u00e1sa a csal\u00e1di p\u00f3tl\u00e9k kifizet\u00e9s\u00e9re szolg\u00e1l\u00f3 k\u00f6lts\u00e9gvet\u00e9si el\u0151ir\u00e1nyzatb\u00f3l t\u00f6rt\u00e9nik.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EFogyaszt\u00f3v\u00e9delmi \u00fcgynek min\u0151s\u00fcl, ha a keresked\u0151 a szab\u00e1lyok ellen\u00e9re nem fogadja el az utalv\u00e1nyt, vagy nem megfelel\u0151en kezeli annak felhaszn\u00e1lhat\u00f3s\u00e1g\u00e1t.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1nnyal megv\u00e1s\u00e1rolhat\u00f3 term\u00e9kek k\u00f6r\u00e9t a Korm\u00e1nyrendelet mell\u00e9klete r\u00e9szletezi, ide tartoznak p\u00e9ld\u00e1ul pap\u00edr\u00e1ruk, f\u00fczetek, \u00edr\u00f3szerek, k\u00f6nyvek, iskolat\u00e1sk\u00e1k, rajzeszk\u00f6z\u00f6k, sz\u00e1mol\u00f3g\u00e9pek, egyes sz\u00e1m\u00edt\u00e1stechnikai eszk\u00f6z\u00f6k, ruh\u00e1zati cikkek, l\u00e1bbelik, tornafelszerel\u00e9s, fejleszt\u0151j\u00e1t\u00e9kok, valamint egyes gy\u00f3gy\u00e1szati \u00e9s fogyat\u00e9koss\u00e1got seg\u00edt\u0151 eszk\u00f6z\u00f6k.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA mell\u00e9klet t\u00f6bb term\u00e9kn\u00e9l kiz\u00e1r\u00e1sokat is tartalmaz, p\u00e9ld\u00e1ul bizonyos sporteszk\u00f6z\u00f6k, s\u00edfelszerel\u00e9sek, egyes speci\u00e1lis l\u00e1bbelik, nem iskolakezd\u00e9shez kapcsol\u00f3d\u00f3 m\u0171szaki eszk\u00f6z\u00f6k vagy nem megjel\u00f6lt kateg\u00f3ri\u00e1j\u00fa term\u00e9kek nem v\u00e1s\u00e1rolhat\u00f3k meg utalv\u00e1nnyal.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1ny k\u00f6telez\u0151 formai elemei k\u00f6z\u00e9 tartozik a c\u00edmlet, a sorsz\u00e1m, a vonalk\u00f3d, az egyedi v\u00edzjel, a kibocs\u00e1t\u00f3 megnevez\u00e9se, az \u00e9rv\u00e9nyess\u00e9gi id\u0151 \u00e9s a Magyar \u00c1llamkincst\u00e1r \u00e1ltal k\u00f6zz\u00e9tett biztons\u00e1gi elemek.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyrendelet m\u00f3dos\u00edtja a kor\u00e1bbi, iskolakezd\u00e9si t\u00e1mogat\u00e1sr\u00f3l sz\u00f3l\u00f3 rendeletet is: ha a p\u00e9nzbeli foly\u00f3s\u00edt\u00e1s 2026. augusztus 24-\u00e9ig nem t\u00f6rt\u00e9nt meg, a Magyar \u00c1llamkincst\u00e1r 2026. szeptember 5-i adatok alapj\u00e1n fel\u00fclvizsg\u00e1lja a jogosults\u00e1got.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA fel\u00fclvizsg\u00e1lat alapj\u00e1n a p\u00e9nzbeli t\u00e1mogat\u00e1s foly\u00f3s\u00edt\u00e1s\u00e1r\u00f3l a rendelet hat\u00e1lybal\u00e9p\u00e9s\u00e9t\u0151l sz\u00e1m\u00edtott 15 napon bel\u00fcl, az utalv\u00e1nyos t\u00e1mogat\u00e1s eljuttat\u00e1s\u00e1r\u00f3l pedig 2026. november 30-\u00e1ig kell gondoskodni.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyrendelet f\u0151szab\u00e1ly szerint a kihirdet\u00e9s\u00e9t k\u00f6vet\u0151 napon l\u00e9p hat\u00e1lyba, az utalv\u00e1nyok bev\u00e1lt\u00e1s\u00e1ra, elsz\u00e1mol\u00e1s\u00e1ra \u00e9s egyes k\u00f6lts\u00e9gvet\u00e9si szab\u00e1lyokra vonatkoz\u00f3 rendelkez\u00e9sek pedig 2026. november 1-j\u00e9n l\u00e9pnek hat\u00e1lyba.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003C\/ul\u003E\n","format":"full_html","processed":"\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyrendelet az iskolakezd\u00e9si t\u00e1mogat\u00e1s utalv\u00e1nyos form\u00e1j\u00e1nak r\u00e9szletes szab\u00e1lyait hat\u00e1rozza meg, vagyis azt, hogyan k\u00e9sz\u00fcl, k\u00e9zbes\u00edtik, haszn\u00e1lj\u00e1k fel \u00e9s v\u00e1ltj\u00e1k be az iskolakezd\u00e9si utalv\u00e1nyt.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz iskolakezd\u00e9si utalv\u00e1ny pap\u00edralap\u00fa fizet\u00e9si eszk\u00f6z, amelyet a Magyar \u00c1llamkincst\u00e1r bocs\u00e1t ki, \u00e9s csak meghat\u00e1rozott iskolaszerek, iskolakezd\u00e9shez kapcsol\u00f3d\u00f3 term\u00e9kek v\u00e1s\u00e1rl\u00e1s\u00e1ra lehet felhaszn\u00e1lni.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA jogosult f\u0151szab\u00e1ly szerint \u00f6sszesen 50 000 forint \u00e9rt\u00e9k\u0171 utalv\u00e1nyt kap, 6 darab 5000 forintos, 6 darab 2000 forintos, 8 darab 1000 forintos c\u00edmletben.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EEgyes k\u00fcl\u00f6n szab\u00e1lyozott esetekben a jogosultat 25 000 forint \u00e9rt\u00e9k\u0171 utalv\u00e1ny illeti meg, 3 darab 5000 forintos, 3 darab 2000 forintos, 4 darab 1000 forintos c\u00edmletben.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1nyok el\u0151\u00e1ll\u00edt\u00e1s\u00e1ban \u00e9s k\u00e9zbes\u00edt\u00e9sre el\u0151k\u00e9sz\u00edt\u00e9s\u00e9ben a Magyar \u00c1llamkincst\u00e1r mellett a NISZ Zrt. m\u0171k\u00f6dik k\u00f6zre, a k\u00e9zbes\u00edt\u00e9st az egyetemes postai szolg\u00e1ltat\u00f3 v\u00e9gzi.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1nyokat 2026. november 30-\u00e1ig kell k\u00e9zbes\u00edteni vagy legal\u00e1bb megk\u00eds\u00e9relni k\u00e9zbes\u00edteni a jogosultaknak.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA posta csak egyszer k\u00eds\u00e9rli meg a k\u00e9zbes\u00edt\u00e9st, sikertelen k\u00e9zbes\u00edt\u00e9s eset\u00e9n az ism\u00e9telt kik\u00fcld\u00e9st a Magyar \u00c1llamkincst\u00e1rn\u00e1l lehet k\u00e9rni, legk\u00e9s\u0151bb 2027. janu\u00e1r 8-\u00e1ig.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EHa az utalv\u00e1nyt a c\u00edmzett hal\u00e1la miatt nem lehet k\u00e9zbes\u00edteni, akkor k\u00e9relemre \u00e1tadhat\u00f3 annak, aki a gyermekr\u0151l saj\u00e1t h\u00e1ztart\u00e1s\u00e1ban gondoskodik, illetve int\u00e9zm\u00e9nyi elhelyez\u00e9s eset\u00e9n az int\u00e9zm\u00e9nyvezet\u0151nek; a k\u00e9relem hat\u00e1rideje 2027. febru\u00e1r 15.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1ny 2027. m\u00e1rcius 15-\u00e9ig haszn\u00e1lhat\u00f3 fel.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1nyt az iskolaszert \u00e1rus\u00edt\u00f3, a rendeletben meghat\u00e1rozott tev\u00e9kenys\u00e9gi k\u00f6r\u0171 keresked\u0151k k\u00f6telesek elfogadni iskolaszer v\u00e1s\u00e1rl\u00e1sa eset\u00e9n.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA keresked\u0151nek ellen\u0151riznie kell az utalv\u00e1ny formai \u00e9s biztons\u00e1gi elemeit, csak megfelel\u0151 utalv\u00e1nyt fogadhat el, az utalv\u00e1nyt n\u00e9v\u00e9rt\u00e9ken sz\u00e1m\u00edthatja be, k\u00e9szp\u00e9nzre nem v\u00e1lthatja \u00e1t.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA keresked\u0151k az elfogadott utalv\u00e1nyokat 2027. m\u00e1jus 15-\u00e9ig v\u00e1lthatj\u00e1k be p\u00e9nzforgalmi szolg\u00e1ltat\u00f3n\u00e1l.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA bev\u00e1lt\u00e1skor a p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 ellen\u0151rzi az utalv\u00e1ny eredetis\u00e9g\u00e9t, sorsz\u00e1m\u00e1t \u00e9s biztons\u00e1gi elemeit, majd az ellen\u00e9rt\u00e9ket a keresked\u0151nek kifizeti, legfeljebb 1% bev\u00e1lt\u00e1si d\u00edj levon\u00e1s\u00e1val.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA p\u00e9nzforgalmi szolg\u00e1ltat\u00f3k fel\u00e9 az utalv\u00e1nyok ellen\u00e9rt\u00e9k\u00e9t a Magyar \u00c1llamkincst\u00e1r t\u00e9r\u00edti meg, heti elsz\u00e1mol\u00e1ssal; a v\u00e9gs\u0151 elsz\u00e1mol\u00e1s hat\u00e1rideje 2027. augusztus 15.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1ny kibocs\u00e1t\u00e1s\u00e1nak, gy\u00e1rt\u00e1s\u00e1nak \u00e9s k\u00e9zbes\u00edt\u00e9s\u00e9nek k\u00f6lts\u00e9geit a k\u00f6zponti k\u00f6lts\u00e9gvet\u00e9s fedezi, az utalv\u00e1nyok ellen\u00e9rt\u00e9k\u00e9nek elsz\u00e1mol\u00e1sa a csal\u00e1di p\u00f3tl\u00e9k kifizet\u00e9s\u00e9re szolg\u00e1l\u00f3 k\u00f6lts\u00e9gvet\u00e9si el\u0151ir\u00e1nyzatb\u00f3l t\u00f6rt\u00e9nik.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EFogyaszt\u00f3v\u00e9delmi \u00fcgynek min\u0151s\u00fcl, ha a keresked\u0151 a szab\u00e1lyok ellen\u00e9re nem fogadja el az utalv\u00e1nyt, vagy nem megfelel\u0151en kezeli annak felhaszn\u00e1lhat\u00f3s\u00e1g\u00e1t.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1nnyal megv\u00e1s\u00e1rolhat\u00f3 term\u00e9kek k\u00f6r\u00e9t a Korm\u00e1nyrendelet mell\u00e9klete r\u00e9szletezi, ide tartoznak p\u00e9ld\u00e1ul pap\u00edr\u00e1ruk, f\u00fczetek, \u00edr\u00f3szerek, k\u00f6nyvek, iskolat\u00e1sk\u00e1k, rajzeszk\u00f6z\u00f6k, sz\u00e1mol\u00f3g\u00e9pek, egyes sz\u00e1m\u00edt\u00e1stechnikai eszk\u00f6z\u00f6k, ruh\u00e1zati cikkek, l\u00e1bbelik, tornafelszerel\u00e9s, fejleszt\u0151j\u00e1t\u00e9kok, valamint egyes gy\u00f3gy\u00e1szati \u00e9s fogyat\u00e9koss\u00e1got seg\u00edt\u0151 eszk\u00f6z\u00f6k.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA mell\u00e9klet t\u00f6bb term\u00e9kn\u00e9l kiz\u00e1r\u00e1sokat is tartalmaz, p\u00e9ld\u00e1ul bizonyos sporteszk\u00f6z\u00f6k, s\u00edfelszerel\u00e9sek, egyes speci\u00e1lis l\u00e1bbelik, nem iskolakezd\u00e9shez kapcsol\u00f3d\u00f3 m\u0171szaki eszk\u00f6z\u00f6k vagy nem megjel\u00f6lt kateg\u00f3ri\u00e1j\u00fa term\u00e9kek nem v\u00e1s\u00e1rolhat\u00f3k meg utalv\u00e1nnyal.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EAz utalv\u00e1ny k\u00f6telez\u0151 formai elemei k\u00f6z\u00e9 tartozik a c\u00edmlet, a sorsz\u00e1m, a vonalk\u00f3d, az egyedi v\u00edzjel, a kibocs\u00e1t\u00f3 megnevez\u00e9se, az \u00e9rv\u00e9nyess\u00e9gi id\u0151 \u00e9s a Magyar \u00c1llamkincst\u00e1r \u00e1ltal k\u00f6zz\u00e9tett biztons\u00e1gi elemek.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyrendelet m\u00f3dos\u00edtja a kor\u00e1bbi, iskolakezd\u00e9si t\u00e1mogat\u00e1sr\u00f3l sz\u00f3l\u00f3 rendeletet is: ha a p\u00e9nzbeli foly\u00f3s\u00edt\u00e1s 2026. augusztus 24-\u00e9ig nem t\u00f6rt\u00e9nt meg, a Magyar \u00c1llamkincst\u00e1r 2026. szeptember 5-i adatok alapj\u00e1n fel\u00fclvizsg\u00e1lja a jogosults\u00e1got.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA fel\u00fclvizsg\u00e1lat alapj\u00e1n a p\u00e9nzbeli t\u00e1mogat\u00e1s foly\u00f3s\u00edt\u00e1s\u00e1r\u00f3l a rendelet hat\u00e1lybal\u00e9p\u00e9s\u00e9t\u0151l sz\u00e1m\u00edtott 15 napon bel\u00fcl, az utalv\u00e1nyos t\u00e1mogat\u00e1s eljuttat\u00e1s\u00e1r\u00f3l pedig 2026. november 30-\u00e1ig kell gondoskodni.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyrendelet f\u0151szab\u00e1ly szerint a kihirdet\u00e9s\u00e9t k\u00f6vet\u0151 napon l\u00e9p hat\u00e1lyba, az utalv\u00e1nyok bev\u00e1lt\u00e1s\u00e1ra, elsz\u00e1mol\u00e1s\u00e1ra \u00e9s egyes k\u00f6lts\u00e9gvet\u00e9si szab\u00e1lyokra vonatkoz\u00f3 rendelkez\u00e9sek pedig 2026. november 1-j\u00e9n l\u00e9pnek hat\u00e1lyba.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003C\/ul\u003E\n"},"field_correction":false,"field_njt_url":null,"field_page_number":1,"field_regulation_number":"223\/2026. (X. 1.) Korm. rendelet","field_regulation_title":"Az iskolakezd\u00e9si utalv\u00e1nyr\u00f3l, valamint az\u00a0iskolakezd\u00e9si t\u00e1mogat\u00e1sr\u00f3l sz\u00f3l\u00f3 112\/2026.\u00a0(VII. 23.) Korm.\u00a0rendelet m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l","field_synonym":"kereset\nfoglalkoztatott\nfoglalkoztatott\nr\u00e1\u00edrat\u00e1s\nszem\u00e9lyg\u00e9pkocsi\nszem\u00e9lyg\u00e9pkocsi\ngyermekgondoz\u00e1si d\u00edj\ngyermekgondoz\u00e1st seg\u00edt\u0151 ell\u00e1t\u00e1s\ngyermeknevel\u00e9si t\u00e1mogat\u00e1s\nnyaral\u00f3\np\u00e9nz\nk\u00e9szp\u00e9nz\nk\u00f6z\u00e9piskola\nmozg\u00e1skorl\u00e1tozott\nmotorker\u00e9kp\u00e1r\nnyugta\npolg\u00e1ri per\nh\u00edrport\u00e1l\npap\u00edrp\u00e9nz\nterm\u00e9szetes szem\u00e9ly\nterm\u0151f\u00f6ld\nvas\u00fat\nrecept\nvillamos energia\nszocpol\nkutya\ngazdi\nf\u0151iskola\nv\u00e1s\u00e1rl\u00f3"},"relationships":{"node_type":{"data":{"type":"node_type--node_type","id":"2de4f0c4-1ed1-4766-9521-6ae4441af5d5","meta":{"drupal_internal__target_id":"issue_unit"}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/node_type?resourceVersion=id%3A218008"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/relationships\/node_type?resourceVersion=id%3A218008"}}},"revision_uid":{"data":{"type":"user--user","id":"88687bb7-61de-4013-a5bd-0bddeed53e90","meta":{"drupal_internal__target_id":38}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/revision_uid?resourceVersion=id%3A218008"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/relationships\/revision_uid?resourceVersion=id%3A218008"}}},"uid":{"data":{"type":"user--user","id":"92b0ac2c-ebb9-43b5-a02d-d1306c70a5dd","meta":{"drupal_internal__target_id":39}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/uid?resourceVersion=id%3A218008"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/relationships\/uid?resourceVersion=id%3A218008"}}},"field_file_docx":{"data":null,"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/field_file_docx?resourceVersion=id%3A218008"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/relationships\/field_file_docx?resourceVersion=id%3A218008"}}},"field_file_epub":{"data":null,"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/field_file_epub?resourceVersion=id%3A218008"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/relationships\/field_file_epub?resourceVersion=id%3A218008"}}},"field_file_pdf":{"data":null,"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/field_file_pdf?resourceVersion=id%3A218008"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/relationships\/field_file_pdf?resourceVersion=id%3A218008"}}},"field_parent_issue_ref":{"data":{"type":"node--issue","id":"c8cf8e1f-f202-4a17-8503-0a5940e908bb","meta":{"drupal_internal__target_id":94895}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/field_parent_issue_ref?resourceVersion=id%3A218008"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e\/relationships\/field_parent_issue_ref?resourceVersion=id%3A218008"}}}}},"links":{"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e?include=field_file_docx%2Cfield_file_epub%2Cfield_file_pdf\u0026ip_group=external"}}}