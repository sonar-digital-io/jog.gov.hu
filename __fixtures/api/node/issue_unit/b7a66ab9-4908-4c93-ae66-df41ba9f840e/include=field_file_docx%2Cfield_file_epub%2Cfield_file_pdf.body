{"jsonapi":{"version":"1.1","meta":{"links":{"self":{"href":"http:\/\/jsonapi.org\/format\/1.1\/"}}}},"data":{"type":"node--issue_unit","id":"b7a66ab9-4908-4c93-ae66-df41ba9f840e","links":{"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e?resourceVersion=id%3A218008"}},"attributes":{"drupal_internal__nid":94902,"drupal_internal__vid":218008,"langcode":"hu","revision_timestamp":"2026-10-02T10:22:35+00:00","status":true,"title":"Az iskolakezd\u00e9si utalv\u00e1nyr\u00f3l, valamint az\u00a0iskolakezd\u00e9si t\u00e1mogat\u00e1sr\u00f3l sz\u00f3l\u00f3 112\/2026.\u00a0(VII. 23.) Korm.\u00a0rendelet m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l","created":"2026-10-02T09:29:17+00:00","changed":"2026-10-02T10:34:45+00:00","promote":false,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":"published","path":{"alias":"\/az-iskolakezdesi-utalvanyrol-valamint-az-iskolakezdesi-tamogatasrol-szolo-1122026-vii-23-korm","pid":19558,"langcode":"hu"},"content_translation_source":"und","content_translation_outdated":false,"api_endpoint_url":[{"uri":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/b7a66ab9-4908-4c93-ae66-df41ba9f840e","title":"b7a66ab9-4908-4c93-ae66-df41ba9f840e","options":[]},{"uri":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit","title":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit","options":[]}],"body":{"value":"\u003Cp\u003E[1]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EE\u0026nbsp;rendelet c\u00e9lja, hogy az\u0026nbsp;iskolakezd\u00e9ssel kapcsolatos kiad\u00e1sok visel\u00e9s\u00e9hez hozz\u00e1j\u00e1rul\u00f3 iskolakezd\u00e9si t\u00e1mogat\u00e1s utalv\u00e1ny form\u00e1ban t\u00f6rt\u00e9n\u0151 juttat\u00e1s\u00e1hoz sz\u00fcks\u00e9ges szab\u00e1lyokat meghat\u00e1rozza.\u003C\/p\u003E\u003Cp\u003E[2]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;Korm\u00e1ny az\u0026nbsp;Alapt\u00f6rv\u00e9ny 15.\u0026nbsp;cikk (3)\u0026nbsp;bekezd\u00e9s\u00e9ben meghat\u00e1rozott eredeti jogalkot\u00f3i hat\u00e1sk\u00f6r\u00e9ben, az\u0026nbsp;Alapt\u00f6rv\u00e9ny 15.\u0026nbsp;cikk (1)\u0026nbsp;bekezd\u00e9s\u00e9ben meghat\u00e1rozott feladatk\u00f6r\u00e9ben elj\u00e1rva a\u0026nbsp;k\u00f6vetkez\u0151ket rendeli el:\u003C\/p\u003E\u003Cp\u003E1.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EE rendelet alkalmaz\u00e1s\u00e1ban\u003C\/p\u003E\u003Cp\u003E1.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E\u003Cem\u003Eiskolakezd\u00e9si utalv\u00e1ny:\u003C\/em\u003E a\u0026nbsp;Magyar \u00c1llamkincst\u00e1r (a\u0026nbsp;tov\u00e1bbiakban: kincst\u00e1r) \u00e1ltal kibocs\u00e1tott, a\u0026nbsp;kincst\u00e1rral szembeni p\u00e9nzk\u00f6vetel\u00e9st megtestes\u00edt\u0151 bankjegynek, forgathat\u00f3 utalv\u00e1nynak, a\u0026nbsp;hitelint\u00e9zetekr\u0151l \u00e9s a\u0026nbsp;p\u00e9nz\u00fcgyi v\u00e1llalkoz\u00e1sokr\u00f3l sz\u00f3l\u00f3\u0026nbsp;t\u00f6rv\u00e9ny szerinti k\u00e9szp\u00e9nz-helyettes\u00edt\u0151 fizet\u00e9si eszk\u00f6znek, valamint \u00e9rt\u00e9kpap\u00edrnak nem min\u0151s\u00fcl\u0151 \u00e9s iskolaszert \u00e1rus\u00edt\u00f3 keresked\u0151n\u00e9l, iskolaszer megv\u00e1s\u00e1rl\u00e1sa ellen\u00e9rt\u00e9k\u00e9nek kiegyenl\u00edt\u00e9s\u00e9re szolg\u00e1l\u00f3 pap\u00edralap\u00fa fizet\u00e9si eszk\u00f6z,\u003C\/p\u003E\u003Cp\u003E2.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E\u003Cem\u003Eiskolaszer:\u003C\/em\u003E az\u0026nbsp;1.\u0026nbsp;mell\u00e9kletben meghat\u00e1rozott term\u00e9k,\u003C\/p\u003E\u003Cp\u003E3.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E\u003Cem\u003Ejogosult:\u003C\/em\u003E az\u0026nbsp;iskolakezd\u00e9si t\u00e1mogat\u00e1sr\u00f3l sz\u00f3l\u00f3 112\/2026.\u0026nbsp;(VII. 23.) Korm.\u0026nbsp;rendelet (a\u0026nbsp;tov\u00e1bbiakban: R.) szerint utalv\u00e1ny form\u00e1j\u00e1ban iskolakezd\u00e9si t\u00e1mogat\u00e1sra jogosult szem\u00e9ly,\u003C\/p\u003E\u003Cp\u003E4.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E\u003Cem\u003Ekeresked\u0151:\u003C\/em\u003E a\u0026nbsp;kereskedelemr\u0151l sz\u00f3l\u00f3\u0026nbsp;t\u00f6rv\u00e9ny szerinti kiskereskedelmi tev\u00e9kenys\u00e9get\u003C\/p\u003E\u003Cp\u003Ea)\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea\u0026nbsp;Gazdas\u00e1gi Tev\u00e9kenys\u00e9gek Egys\u00e9ges \u00c1gazati Oszt\u00e1lyoz\u00e1si Rendszer\u00e9ben (a\u0026nbsp;tov\u00e1bbiakban: TE\u00c1OR\u201925) \u201e47.11 \u00c9lelmiszer jelleg\u0171 vegyes kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.12 Iparcikk jelleg\u0171 vegyes kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.40 Inform\u00e1ci\u00f3s, h\u00edrad\u00e1stechnikai term\u00e9k kiskereskedelme\u201d, TE\u00c1OR\u201925 \u201e47.61 K\u00f6nyv-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.62 \u00dajs\u00e1g-, pap\u00edr\u00e1ru-, \u00edr\u00f3szer-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.63 Sportszer-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.64\u0026nbsp;J\u00e1t\u00e9k-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.71 Ruh\u00e1zat-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.72 L\u00e1bbeli-, b\u0151r\u00e1ru-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.73 Gy\u00f3gyszer-kiskereskedelem\u201d vagy TE\u00c1OR\u201925 \u201e47.74\u0026nbsp;Gy\u00f3gy\u00e1szati \u00e9s ortop\u00e9diai term\u00e9k kiskereskedelme\u201d alatt,\u003C\/p\u003E\u003Cp\u003Eb)\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Eaz\u0026nbsp;\u00d6n\u00e1ll\u00f3 v\u00e1llalkoz\u00f3k tev\u00e9kenys\u00e9gi jegyz\u00e9k\u00e9ben (a\u0026nbsp;tov\u00e1bbiakban: \u00d6VTJ\u201925) \u201e471101 Vegyes-kiskereskedelem \u00e9lelmiszer jelleggel, \u00e9lelmiszer diszkont\u201d, \u00d6VTJ\u201925 \u201e471201 Iparcikk jelleg\u0171 vegyes kiskereskedelem m.n.s.\u201d, \u00d6VTJ\u201925 \u201e471202 \u00c1ltal\u00e1nos \u00e1ruh\u00e1zi kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e474001 Sz\u00e1m\u00edt\u00f3g\u00e9p, perif\u00e9ria, szoftver kiskereskedelme\u201d, \u00d6VTJ\u201925 \u201e476101 K\u00f6nyv-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e476201 Pap\u00edr-, \u00edr\u00f3szer-, irodaszer- \u00e9s nyomtatv\u00e1ny-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e476202 H\u00edrlap, foly\u00f3irat, id\u0151szaki kiadv\u00e1ny kiskereskedelme\u201d, \u00d6VTJ\u201925 \u201e476301 Sport\u00e1ru-, sporthorg\u00e1szati- \u00e9s kempingcikk-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e476401 J\u00e1t\u00e9k-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477101\u0026nbsp;Egy\u00e9b ruh\u00e1zati kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477102 Fels\u0151ruh\u00e1zati, munkaruha-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477103 B\u0151r-, sz\u0151rmeruh\u00e1zati-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477104 N\u00e9pm\u0171v\u00e9szeti ruh\u00e1zati kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477105 K\u00f6t\u00f6tt\u00e1ru-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477106 Feh\u00e9rnem\u0171-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477107 Gyermekruh\u00e1zati kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477108 Ruh\u00e1zati kieg\u00e9sz\u00edt\u0151k kiskereskedelme\u201d, \u00d6VTJ\u201925 \u201e477201 L\u00e1bbeli-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477202 B\u0151rd\u00edszm\u0171\u00e1ru-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477203 N\u00e9pm\u0171v\u00e9szeti l\u00e1bbeli-, b\u0151r\u00e1ru-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477301 Gy\u00f3gyszer-kiskereskedelem m.n.s.\u201d, \u00d6VTJ\u201925 \u201e477401 Gy\u00f3gy\u00e1szati seg\u00e9deszk\u00f6z kiskereskedelme (eg\u00e9szs\u00e9g\u00fcgyi szolg\u00e1ltat\u00e1sk\u00e9nt)\u201d, \u00d6VTJ\u201925 \u201e477402 Egy\u00e9b gy\u00f3gy\u00e1szati term\u00e9k kiskereskedelme\u201d vagy \u00d6VTJ\u201925 \u201e477403 L\u00e1tszer\u00e9szek tev\u00e9kenys\u00e9ge\u201d alatt\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ev\u00e9gz\u0151, iskolaszert \u00e1rus\u00edt\u00f3 keresked\u0151.\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E2.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyt a\u0026nbsp;2.\u0026nbsp;mell\u00e9klet szerinti tartalmi \u00e9s formai felt\u00e9teleknek megfelel\u0151en kell el\u0151\u00e1ll\u00edtani.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny kialak\u00edt\u00e1s\u00e1ban, el\u0151\u00e1ll\u00edt\u00e1s\u00e1ban, k\u00e9zbes\u00edt\u00e9sre t\u00f6rt\u00e9n\u0151 el\u0151k\u00e9sz\u00edt\u00e9s\u00e9ben \u00e9s az\u0026nbsp;egyetemes postai szolg\u00e1ltat\u00f3n kereszt\u00fcl annak k\u00e9zbes\u00edt\u00e9s\u00e9ben \u2013 a\u0026nbsp;kincst\u00e1r megb\u00edz\u00e1s\u00e1nak megfelel\u0151en \u2013 a\u0026nbsp;NISZ Nemzeti Infokommunik\u00e1ci\u00f3s Szolg\u00e1ltat\u00f3 Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g k\u00f6zrem\u0171k\u00f6dik, amelynek r\u00e9szleteir\u0151l a\u0026nbsp;felek egy\u00fcttm\u0171k\u00f6d\u00e9si \u00e9s adatfeldolgoz\u00e1si meg\u00e1llapod\u00e1st k\u00f6tnek.\u003C\/p\u003E\u003Cp\u003E3.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;jogosultat \u2013 a\u0026nbsp;(2)\u0026nbsp;bekezd\u00e9sben foglalt kiv\u00e9tellel \u2013 6 darab 5000\u0026nbsp;forint, 6 darab 2000\u0026nbsp;forint, 8 darab 1000\u0026nbsp;forint\u0026nbsp;c\u00edmlet\u0171, \u00f6sszesen 50\u003Cspan\u003E\u2005\u003C\/span\u003E000\u0026nbsp;forint \u00e9rt\u00e9k\u0171 iskolakezd\u00e9si utalv\u00e1ny illeti meg.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;R. 3.\u0026nbsp;\u00a7 (4)\u0026nbsp;bekezd\u00e9se szerinti esetben a\u0026nbsp;jogosultat 3 darab 5000\u0026nbsp;forint, 3 darab 2000\u0026nbsp;forint, 4 darab 1000\u0026nbsp;forint\u0026nbsp;c\u00edmlet\u0171, \u00f6sszesen 25 000\u0026nbsp;forint \u00e9rt\u00e9k\u0171 iskolakezd\u00e9si utalv\u00e1ny illeti meg.\u003C\/p\u003E\u003Cp\u003E4.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;kincst\u00e1r a\u0026nbsp;NISZ Nemzeti Infokommunik\u00e1ci\u00f3s Szolg\u00e1ltat\u00f3 Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g bevon\u00e1s\u00e1val, a\u0026nbsp;(2)\u2013(5)\u0026nbsp;bekezd\u00e9sben foglaltak szerint int\u00e9zkedik az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nynak a\u0026nbsp;jogosultak r\u00e9sz\u00e9re t\u00f6rt\u00e9n\u0151 megk\u00fcld\u00e9s\u00e9r\u0151l.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyt tartalmaz\u00f3 k\u00fcldem\u00e9ny jogosultak r\u00e9sz\u00e9re t\u00f6rt\u00e9n\u0151 k\u00e9zbes\u00edt\u00e9s\u00e9t az\u0026nbsp;egyetemes postai szolg\u00e1ltat\u00f3 v\u00e9gzi.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(3)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyt 2026. november 30-\u00e1ig kell a\u0026nbsp;jogosult r\u00e9sz\u00e9re k\u00e9zbes\u00edteni vagy a\u0026nbsp;k\u00e9zbes\u00edt\u00e9st megk\u00eds\u00e9relni.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(4)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;egyetemes postai szolg\u00e1ltat\u00f3 a\u0026nbsp;k\u00e9zbes\u00edt\u00e9st kiz\u00e1r\u00f3lag egyszer k\u00eds\u00e9rli meg. A\u0026nbsp;postai k\u00e9zbes\u00edt\u00e9s eredm\u00e9nytelens\u00e9ge eset\u00e9n az\u0026nbsp;ism\u00e9telt kik\u00fcld\u00e9s ir\u00e1nti k\u00e9relmet \u2013 a\u0026nbsp;kincst\u00e1r honlapj\u00e1n k\u00f6zz\u00e9tett m\u00f3don \u2013 a\u0026nbsp;kincst\u00e1rn\u00e1l kell el\u0151terjeszteni. A\u0026nbsp;k\u00e9relem beny\u00fajt\u00e1s\u00e1nak jogveszt\u0151 hat\u00e1rideje 2027. janu\u00e1r 8.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(5)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;m\u00e1r kik\u00fcld\u00f6tt, de a\u0026nbsp;c\u00edmzett hal\u00e1la miatt r\u00e9sz\u00e9re nem k\u00e9zbes\u00edthet\u0151 iskolakezd\u00e9si utalv\u00e1nyt a\u0026nbsp;csal\u00e1dok t\u00e1mogat\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 1998.\u0026nbsp;\u00e9vi LXXXIV.\u0026nbsp;t\u00f6rv\u00e9ny 38.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s\u00e9ben foglaltak szerint az\u0026nbsp;ell\u00e1t\u00e1sra jogos\u00edt\u00f3 gyermek nevel\u00e9s\u00e9r\u0151l saj\u00e1t h\u00e1ztart\u00e1s\u00e1ban gondoskod\u00f3 szem\u00e9ly vagy int\u00e9zm\u00e9nyi elhelyez\u00e9s eset\u00e9n az\u0026nbsp;int\u00e9zm\u00e9nyvezet\u0151 r\u00e9sz\u00e9re \u2013 k\u00e9relemre \u2013 adja \u00e1t a\u0026nbsp;kincst\u00e1r. A\u0026nbsp;k\u00e9relem beny\u00fajt\u00e1s\u00e1nak jogveszt\u0151 hat\u00e1rideje 2027. febru\u00e1r 15.\u003C\/p\u003E\u003Cp\u003E5.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny 2027. m\u00e1rcius 15-\u00e9ig haszn\u00e1lhat\u00f3 fel iskolaszer megv\u00e1s\u00e1rl\u00e1s\u00e1ra.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EIskolaszer v\u00e1s\u00e1rl\u00e1sa eset\u00e9n a\u0026nbsp;keresked\u0151 k\u00f6teles a\u0026nbsp;v\u00e1s\u00e1rl\u00e1s ellen\u00e9rt\u00e9kek\u00e9nt az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny elfogad\u00e1s\u00e1ra.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(3)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny felhaszn\u00e1l\u00e1sakor a\u0026nbsp;keresked\u0151 ellen\u0151rzi az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny 2.\u0026nbsp;mell\u00e9klet szerinti tartalmi \u00e9s formai elemeit, \u00e9s csak az\u0026nbsp;azoknak megfelel\u0151 utalv\u00e1nyt fogadja el.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(4)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyt a\u0026nbsp;keresked\u0151\u0026nbsp;c\u00edmlet\u00e9rt\u00e9ken fogadhatja el a\u0026nbsp;v\u00e1s\u00e1rl\u00e1s ellen\u00e9rt\u00e9kek\u00e9nt, azt k\u00e9szp\u00e9nzre sem r\u00e9szben, sem eg\u00e9szben nem v\u00e1lthatja \u00e1t.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(5)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;keresked\u0151 a\u0026nbsp;felhaszn\u00e1l\u00e1s sor\u00e1n \u00e1tadott iskolakezd\u00e9si utalv\u00e1ny felhaszn\u00e1l\u00e1s\u00e1nak t\u00e9ny\u00e9t az\u0026nbsp;utalv\u00e1nyon r\u00f6gz\u00edti.\u003C\/p\u003E\u003Cp\u003E6.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;keresked\u0151 az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyt 2027. m\u00e1jus 15-\u00e9ig v\u00e1lthatja be a\u0026nbsp;p\u00e9nzforgalmi sz\u00e1ml\u00e1j\u00e1t vezet\u0151 p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 fi\u00f3ki p\u00e9nzt\u00e1r\u00e1ban, ennek hi\u00e1ny\u00e1ban b\u00e1rmely p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 fi\u00f3ki p\u00e9nzt\u00e1r\u00e1ban.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 a\u0026nbsp;bev\u00e1lt\u00e1skor elv\u00e9gzi az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny eredetis\u00e9g\u00e9nek ellen\u0151rz\u00e9s\u00e9t az\u0026nbsp;utalv\u00e1ny sorsz\u00e1m\u00e1nak \u00e9s az\u0026nbsp;utalv\u00e1ny biztons\u00e1gi elemeinek ellen\u0151rz\u00e9s\u00e9vel, \u00e9s a\u0026nbsp;bev\u00e1ltott utalv\u00e1ny ellen\u00e9rt\u00e9k\u00e9t \u2013 a\u0026nbsp;(3)\u0026nbsp;bekezd\u00e9s szerinti bev\u00e1lt\u00e1si d\u00edjjal cs\u00f6kkentett \u2013 n\u00e9v\u00e9rt\u00e9kben sz\u00e1mlap\u00e9nz vagy \u2013 p\u00e9nzforgalmi sz\u00e1mla hi\u00e1ny\u00e1ban\u0026nbsp;\u2013 k\u00e9szp\u00e9nz form\u00e1j\u00e1ban biztos\u00edtja a\u0026nbsp;bev\u00e1lt\u00f3 keresked\u0151 r\u00e9sz\u00e9re, ha ellen\u0151rz\u00e9se alapj\u00e1n a\u0026nbsp;keresked\u0151 erre jogosult. A\u0026nbsp;bev\u00e1lt\u00e1s m\u00f3dj\u00e1ra vonatkoz\u00f3 t\u00e1j\u00e9koztat\u00f3t a\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 a\u0026nbsp;honlapj\u00e1n k\u00f6zz\u00e9teszi.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(3)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny bev\u00e1lt\u00e1sa sor\u00e1n a\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 legfeljebb az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny n\u00e9v\u00e9rt\u00e9k\u00e9nek 1%-\u00e1t sz\u00e1m\u00edthatja fel bev\u00e1lt\u00e1si d\u00edjk\u00e9nt a\u0026nbsp;keresked\u0151 fel\u00e9. A\u0026nbsp;bev\u00e1lt\u00e1shoz kapcsol\u00f3d\u00f3an a\u0026nbsp;keresked\u0151 r\u00e9sz\u00e9re egy\u00e9b d\u00edj vagy jutal\u00e9k nem sz\u00e1m\u00edthat\u00f3 fel.\u003C\/p\u003E\u003Cp\u003E7.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny ellen\u00e9rt\u00e9k\u00e9t a\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 r\u00e9sz\u00e9re a\u0026nbsp;kincst\u00e1r t\u00e9r\u00edti meg. A\u0026nbsp;megt\u00e9r\u00edt\u00e9sre vonatkoz\u00f3 t\u00e1j\u00e9koztat\u00f3t (a\u0026nbsp;tov\u00e1bbiakban: t\u00e1j\u00e9koztat\u00f3) a\u0026nbsp;kincst\u00e1r a\u0026nbsp;honlapj\u00e1n k\u00f6zz\u00e9teszi.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;megt\u00e9r\u00edt\u00e9s a\u0026nbsp;t\u00e1j\u00e9koztat\u00f3ban meghat\u00e1rozott adatszolg\u00e1ltat\u00e1s alapj\u00e1n, ut\u00f3lagosan, heti elsz\u00e1mol\u00e1s keret\u00e9ben t\u00f6rt\u00e9nik. Az\u0026nbsp;adatszolg\u00e1ltat\u00e1sban a\u0026nbsp;bank k\u00f6zli az\u0026nbsp;elsz\u00e1mol\u00e1si id\u0151szak alatt n\u00e1la bev\u00e1ltott utalv\u00e1ny darabsz\u00e1m\u00e1t, n\u00e9v\u00e9rt\u00e9k\u00e9t, valamint a\u0026nbsp;bev\u00e1ltott utalv\u00e1ny sorsz\u00e1m\u00e1t.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(3)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 a\u0026nbsp;keresked\u0151 \u00e1ltal bev\u00e1ltott utalv\u00e1nyt a\u0026nbsp;t\u00e1j\u00e9koztat\u00f3ban meghat\u00e1rozottak szerinti elsz\u00e1mol\u00e1si \u00f6sszes\u00edt\u0151vel havonta eljuttatja a\u0026nbsp;kincst\u00e1r sz\u00e1m\u00e1ra. A\u0026nbsp;kincst\u00e1r az\u0026nbsp;\u00e1tvett iskolakezd\u00e9si utalv\u00e1nyt a\u0026nbsp;vonatkoz\u00f3 kincst\u00e1ri elj\u00e1r\u00e1srendj\u00e9ben meghat\u00e1rozott hat\u00e1rid\u0151 letelt\u00e9t k\u00f6vet\u0151en megsemmis\u00edti.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(4)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny tekintet\u00e9ben a\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 \u00e9s a\u0026nbsp;kincst\u00e1r k\u00f6z\u00f6tti v\u00e9gs\u0151 elsz\u00e1mol\u00e1s hat\u00e1rideje 2027. augusztus 15.\u003C\/p\u003E\u003Cp\u003E8.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny kibocs\u00e1t\u00e1s\u00e1val, gy\u00e1rt\u00e1s\u00e1val \u00e9s a\u0026nbsp;jogosultaknak val\u00f3 eljuttat\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 k\u00f6lts\u00e9geket a\u0026nbsp;k\u00f6zponti k\u00f6lts\u00e9gvet\u00e9s biztos\u00edtja.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny ellen\u00e9rt\u00e9k\u00e9vel \u00e9s elsz\u00e1mol\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 \u2013 7.\u0026nbsp;\u00a7 szerinti \u2013 kifizet\u00e9sek forr\u00e1sa a\u0026nbsp;k\u00f6zponti k\u00f6lts\u00e9gvet\u00e9s csal\u00e1di p\u00f3tl\u00e9k kifizet\u00e9s\u00e9re szolg\u00e1l\u00f3 el\u0151ir\u00e1nyzata.\u003C\/p\u003E\u003Cp\u003E9.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;5.\u0026nbsp;\u00a7 (1) \u00e9s (2)\u0026nbsp;bekezd\u00e9s\u00e9ben foglalt rendelkez\u00e9sek megs\u00e9rt\u00e9se eset\u00e9n \u2013 ha a\u0026nbsp;jogs\u00e9rt\u00e9s a\u0026nbsp;fogyaszt\u00f3v\u00e9delemr\u0151l sz\u00f3l\u00f3\u0026nbsp;t\u00f6rv\u00e9ny szerinti fogyaszt\u00f3t \u00e9rint \u2013 a\u0026nbsp;fogyaszt\u00f3v\u00e9delmi hat\u00f3s\u00e1g j\u00e1r el, a\u0026nbsp;fogyaszt\u00f3v\u00e9delemr\u0151l sz\u00f3l\u00f3\u0026nbsp;t\u00f6rv\u00e9nyben meghat\u00e1rozott szab\u00e1lyok szerint.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;5.\u0026nbsp;\u00a7 (1) \u00e9s (2)\u0026nbsp;bekezd\u00e9s\u00e9ben foglalt rendelkez\u00e9sek a\u0026nbsp;fogyaszt\u00f3v\u00e9delemr\u0151l sz\u00f3l\u00f3\u0026nbsp;t\u00f6rv\u00e9ny alkalmaz\u00e1s\u00e1ban fogyaszt\u00f3v\u00e9delmi rendelkez\u00e9sek.\u003C\/p\u003E\u003Cp\u003E10.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EEz\u0026nbsp;a\u0026nbsp;rendelet \u2013 a\u0026nbsp;(2)\u0026nbsp;bekezd\u00e9sben foglalt kiv\u00e9tellel \u2013 a\u0026nbsp;kihirdet\u00e9s\u00e9t k\u00f6vet\u0151\u0026nbsp;napon l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;6.\u0026nbsp;\u00a7, a\u0026nbsp;7.\u0026nbsp;\u00a7 \u00e9s a\u0026nbsp;8.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9se 2026. november 1-j\u00e9n l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\u003Cp\u003E11.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EAz R. a\u0026nbsp;k\u00f6vetkez\u0151 8.\u0026nbsp;\u00a7-sal eg\u00e9sz\u00fcl ki:\u003C\/p\u003E\u003Cp\u003E\u201e8.\u0026nbsp;\u00a7 (1) Ha az\u0026nbsp;1.\u0026nbsp;\u00a7 szerinti jogosult r\u00e9sz\u00e9re a\u0026nbsp;4.\u0026nbsp;\u00a7 a)\u0026nbsp;pontja szerinti foly\u00f3s\u00edt\u00e1s 2026. augusztus 24-\u00e9ig nem t\u00f6rt\u00e9nt meg, a\u0026nbsp;kincst\u00e1r\u003C\/p\u003E\u003Cp\u003Ea) a\u0026nbsp;2.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s a) \u00e9s b)\u0026nbsp;pontj\u00e1ban meghat\u00e1rozott nyilv\u00e1ntart\u00e1sok \u00e9s\u003C\/p\u003E\u003Cp\u003Eb) a\u0026nbsp;2.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s c)\u0026nbsp;pontja szerinti adatszolg\u00e1ltat\u00e1s\u003C\/p\u003E\u003Cp\u003E2026. szeptember 5-ei \u00e1llapota szerinti adatai alapj\u00e1n fel\u00fclvizsg\u00e1lja az\u0026nbsp;iskolakezd\u00e9si t\u00e1mogat\u00e1sra val\u00f3 jogosults\u00e1got.\u003C\/p\u003E\u003Cp\u003E(2) A\u0026nbsp;kincst\u00e1r az\u0026nbsp;(1)\u0026nbsp;bekezd\u00e9s szerinti esetben\u003C\/p\u003E\u003Cp\u003Ea) a\u0026nbsp;4.\u0026nbsp;\u00a7 a)\u0026nbsp;pontja szerinti \u00f6sszeg foly\u00f3s\u00edt\u00e1s\u00e1r\u00f3l az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyr\u00f3l, valamint az\u0026nbsp;iskolakezd\u00e9si t\u00e1mogat\u00e1sr\u00f3l sz\u00f3l\u00f3 112\/2026.\u0026nbsp;(VII. 23.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 223\/2026. (X. 1.) Korm.\u0026nbsp;rendelet hat\u00e1lybal\u00e9p\u00e9s\u00e9t\u0151l sz\u00e1m\u00edtott 15.\u0026nbsp;napig,\u003C\/p\u003E\u003Cp\u003Eb) a\u0026nbsp;4.\u0026nbsp;\u00a7 b)\u0026nbsp;pontja szerinti \u00f6sszeg iskolakezd\u00e9si utalv\u00e1ny form\u00e1j\u00e1ban a\u0026nbsp;jogosult r\u00e9sz\u00e9re t\u00f6rt\u00e9n\u0151 eljuttat\u00e1s\u00e1r\u00f3l 2026.\u0026nbsp;november 30-\u00e1ig\u003C\/p\u003E\u003Cp\u003Egondoskodik.\u003C\/p\u003E\u003Cp\u003E(3) Az\u0026nbsp;Oktat\u00e1si Hivatal, valamint a\u0026nbsp;Nemzeti Szakk\u00e9pz\u00e9si \u00e9s Feln\u0151ttk\u00e9pz\u00e9si Hivatal az\u0026nbsp;(1)\u0026nbsp;bekezd\u00e9s b)\u0026nbsp;pontja szerinti adatokat az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyr\u00f3l, valamint az\u0026nbsp;iskolakezd\u00e9si t\u00e1mogat\u00e1sr\u00f3l sz\u00f3l\u00f3 112\/2026.\u0026nbsp;(VII. 23.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 223\/2026. (X. 1.) Korm.\u0026nbsp;rendelet hat\u00e1lybal\u00e9p\u00e9s\u00e9t k\u00f6vet\u0151\u0026nbsp;napon adja \u00e1t a\u0026nbsp;kincst\u00e1r r\u00e9sz\u00e9re.\u003C\/p\u003E\u003Cp\u003E(4) A\u0026nbsp;(2)\u0026nbsp;bekezd\u00e9s a)\u0026nbsp;pontj\u00e1t a\u0026nbsp;2.\u0026nbsp;\u00a7 (3)\u0026nbsp;bekezd\u00e9se szerinti csal\u00e1dt\u00e1mogat\u00e1si kifizet\u0151helyre is alkalmazni kell.\u201d\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E1.\u0026nbsp;mell\u00e9klet a\u0026nbsp;223\/2026. (X. 1.) Korm.\u0026nbsp;rendelethez\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003EIskolakezd\u00e9si utalv\u00e1nnyal megv\u00e1s\u00e1rolhat\u00f3 term\u00e9kek\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003EIskolaszer:\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003EA v\u00e1m- \u00e9s a\u0026nbsp;statisztikai n\u00f3menklat\u00far\u00e1r\u00f3l, valamint a\u0026nbsp;K\u00f6z\u00f6s V\u00e1mtarif\u00e1r\u00f3l sz\u00f3l\u00f3 2658\/87\/EGK tan\u00e1csi rendelet I.\u0026nbsp;mell\u00e9klet\u00e9nek m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3, 2021. okt\u00f3ber 12-i (EU)\u0026nbsp;2021\/1832\u0026nbsp;bizotts\u00e1gi v\u00e9grehajt\u00e1si rendelet 1.\u0026nbsp;mell\u00e9klet\u00e9nek m\u00e1sodik r\u00e9sze szerinti, az al\u00e1bbi \u00e1rucsoportba, illetve \u00e1rukateg\u00f3ri\u00e1ba tartoz\u00f3 term\u00e9kek:\u003C\/span\u003E\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Ctable class=\u0022table\u0022\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003E\u0026nbsp;\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EA\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EB\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EC\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003ED\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EE\u0026nbsp;\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EF\u0026nbsp;\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EG\u0026nbsp;\u003C\/span\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cspan\u003E1\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EK\u00f6znapi term\u00e9kcsoport\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EK\u00f6znapi term\u00e9kn\u00e9v\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EVTSZ \u00c1rucsoport\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EVTSZ \u00c1rukateg\u00f3ria\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EVTSZ elnevez\u00e9s\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EVTSZ \u00e1rukateg\u00f3ri\u00e1n bel\u00fcl iskolakezd\u00e9si utalv\u00e1nnyal megv\u00e1s\u00e1rolhat\u00f3\u0026nbsp;term\u00e9kek\u003C\/span\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cspan\u003EVTSZ \u00e1rukateg\u00f3ri\u00e1n bel\u00fcl iskolakezd\u00e9si utalv\u00e1nnyal nem v\u00e1s\u00e1rolhat\u00f3 term\u00e9kek\u003C\/span\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E2\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00cdr\u00f3pap\u00edr\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4802\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENem bevont pap\u00edr \u00e9s karton \u00edr\u00e1sra, nyomtat\u00e1sra vagy m\u00e1s grafikai c\u00e9lra, \u00e9s nem perfor\u00e1lt lyukk\u00e1rtya- \u00e9s lyukszalagpap\u00edr tekercsben vagy t\u00e9glalap (bele\u00e9rtve a\u0026nbsp;n\u00e9gyzet) alak\u00fa \u00edvben, b\u00e1rmilyen m\u00e9retben, a\u0026nbsp;4801\u0026nbsp;vagy a\u0026nbsp;4803 vtsz. al\u00e1\u0026nbsp;tartoz\u00f3 pap\u00edr kiv\u00e9tel\u00e9vel; k\u00e9zi mer\u00edt\u00e9s\u0171 pap\u00edr \u00e9s karton\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00e9zi mer\u00edt\u00e9s\u0171 pap\u00edr \u00e9s karton (4802\u0026nbsp;10), M\u00e1s pap\u00edr \u00e9s karton, amely nem vagy legfeljebb 10\u0026nbsp;t\u00f6megsz\u00e1zal\u00e9k mechanikai vagy vegyi-mechanikai elj\u00e1r\u00e1ssal nyert rostanyagot tartalmaz (4802 54), M\u00e1s pap\u00edr \u00e9s karton, amely t\u00f6bb mint 10\u0026nbsp;t\u00f6megsz\u00e1zal\u00e9k mechanikai vagy vegyi-mechanikai elj\u00e1r\u00e1ssal nyert rostanyagot tartalmaz (4802\u0026nbsp;61)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETap\u00e9ta alappap\u00edr (4802 40)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E3\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00c1tl\u00e1tsz\u00f3 pap\u00edrok\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4806\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u00f6v\u00e9nyi pergamen, zs\u00edrpap\u00edr, pauszpap\u00edr (\u00e1tm\u00e1sol\u00f3pap\u00edr), \u00e9s\u0026nbsp;pergamenpap\u00edr \u00e9s m\u00e1s f\u00e9nyezett, \u00e1tl\u00e1tsz\u00f3 vagy \u00e1ttetsz\u0151 pap\u00edr tekercsben vagy \u00edvben\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u00f6v\u00e9nyi pergamen (4806 10), Pauszpap\u00edr (\u00e1tm\u00e1sol\u00f3pap\u00edr) (4806 30), Pergamenpap\u00edr \u00e9s m\u00e1s f\u00e9nyezett, \u00e1tl\u00e1tsz\u00f3 vagy \u00e1ttetsz\u0151 pap\u00edr (4806\u0026nbsp;40)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EZs\u00edrpap\u00edr (4806 20)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ED\u00edszpap\u00edrok\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4810\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edr \u00e9s karton egyik vagy mindk\u00e9t oldal\u00e1n kaolinnal (k\u00ednai agyaggal) vagy m\u00e1s szervetlen anyaggal bevonva, k\u00f6t\u0151anyag felhaszn\u00e1l\u00e1s\u00e1val\u0026nbsp;is, de m\u00e1s bevonat n\u00e9lk\u00fcl, fel\u00fcletileg sz\u00ednezett, d\u00edsz\u00edtett vagy nyomtatott is, tekercsben vagy t\u00e9glalap (bele\u00e9rtve a\u0026nbsp;n\u00e9gyzet) alak\u00fa \u00edvben, b\u00e1rmilyen m\u00e9retben\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edr \u00e9s karton \u00edr\u00e1sra, nyomtat\u00e1sra vagy m\u00e1s grafikai c\u00e9lra, amely nem vagy legfeljebb 10\u0026nbsp;t\u00f6megsz\u00e1zal\u00e9k mechanikai, vagy vegyi-mechanikai elj\u00e1r\u00e1ssal nyert rostanyagot tartalmaz (4810 13), Pap\u00edr \u00e9s karton \u00edr\u00e1sra, nyomtat\u00e1sra vagy m\u00e1s grafikai c\u00e9lra, amely 10\u0026nbsp;t\u00f6megsz\u00e1zal\u00e9kn\u00e1l t\u00f6bb mechanikai vagy vegyi-mechanikai elj\u00e1r\u00e1ssal nyert rostanyagot tartalmaz (4810\u0026nbsp;22), N\u00e1tronpap\u00edr \u00e9s -karton, az\u0026nbsp;\u00edr\u00e1sra, nyomtat\u00e1sra vagy m\u00e1s grafikai c\u00e9lra haszn\u00e1lt pap\u00edr kiv\u00e9tel\u00e9vel (4810\u0026nbsp;31), M\u00e1s\u0026nbsp;pap\u00edr \u00e9s karton (4810 92)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E5\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edr bor\u00edt\u00e9k \u00e9s t\u00e1rol\u00f3\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4817\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBor\u00edt\u00e9k, z\u00e1rt levelez\u0151lap, postai levelez\u0151lap \u00e9s m\u00e1s levelez\u0151lap pap\u00edrb\u00f3l vagy kartonb\u00f3l; levelez\u0151pap\u00edr-k\u00e9szletet tartalmaz\u00f3, pap\u00edrb\u00f3l vagy kartonb\u00f3l k\u00e9sz\u00fclt doboz, tasak, t\u00e1rca \u00e9s mappa\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBor\u00edt\u00e9k (4817 10), Z\u00e1rt levelez\u0151lap, postai levelez\u0151lap \u00e9s m\u00e1s levelez\u0151lap (4817\u0026nbsp;20), Levelez\u0151pap\u00edr-k\u00e9szletet tartalmaz\u00f3, pap\u00edrb\u00f3l vagy kartonb\u00f3l k\u00e9sz\u00fclt doboz, tasak, t\u00e1rca \u00e9s mappa (4817\u0026nbsp;30)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EJegyzett\u00f6mb\u00f6k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4820\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERegiszter, \u00fczleti k\u00f6nyv, jegyzetf\u00fczet (notesz), megrendel\u0151k\u00f6nyv, orvosi v\u00e9nyt\u00f6mb, \u00edr\u00f3t\u00f6mb, el\u0151jegyz\u00e9si jegyzett\u00f6mb,\u0026nbsp;napl\u00f3 \u00e9s hasonl\u00f3 term\u00e9k, iskolai f\u00fczet, \u00edr\u00f3mappa, iratrendez\u0151 (cser\u00e9lhet\u0151 lapokkal vagy m\u00e1s), dosszi\u00e9, iratbor\u00edt\u00f3, sokszoros\u00edtott \u00fczleti \u0171rlap, karbon bet\u00e9tlapos t\u00f6mb \u00e9s m\u00e1s irodaszer pap\u00edrb\u00f3l vagy kartonb\u00f3l; album, mint\u00e1k vagy gy\u0171jtem\u00e9nyek sz\u00e1m\u00e1ra \u00e9s k\u00f6nyvbor\u00edt\u00f3 pap\u00edrb\u00f3l vagy kartonb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERegiszter, \u00fczleti k\u00f6nyv, jegyzetf\u00fczet (notesz), megrendel\u0151k\u00f6nyv, orvosi v\u00e9nyt\u00f6mb, \u00edr\u00f3t\u00f6mb, el\u0151jegyz\u00e9si t\u00f6mb,\u0026nbsp;napl\u00f3 \u00e9s hasonl\u00f3 term\u00e9k (4820\u0026nbsp;10), Iskolai f\u00fczet (4820 20), Iratrendez\u0151 (a\u0026nbsp;k\u00f6nyvbor\u00edt\u00f3 kiv\u00e9tel\u00e9vel), dosszi\u00e9 \u00e9s iratbor\u00edt\u00f3 (4820 30), Sokszoros\u00edtott \u00fczleti \u0171rlap \u00e9s karbon bet\u00e9tlapos t\u00f6mb (4820 40), Album mint\u00e1k vagy gy\u0171jtem\u00e9nyek sz\u00e1m\u00e1ra (4820\u0026nbsp;50)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E7\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EC\u00edmk\u00e9k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4821\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EMindenf\u00e9le\u0026nbsp;c\u00edmke pap\u00edrb\u00f3l vagy kartonb\u00f3l, nyomtatott is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyomtatott (4821 10)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00f6nyvek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4901\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyomtatott k\u00f6nyv, bros\u00fara, r\u00f6pirat \u00e9s hasonl\u00f3 nyomtatv\u00e1ny, egyes\u0026nbsp;lapokban is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EEgyes lapokban, hajtogatva is (4901 10), Sz\u00f3t\u00e1r \u00e9s enciklop\u00e9dia \u00e9s ilyen sorozatok folytat\u00e1sai (4901 91)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00dajs\u00e1gok\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4902\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00dajs\u00e1g, foly\u00f3irat \u00e9s id\u0151szakos kiadv\u00e1ny, illusztr\u00e1lva vagy rekl\u00e1mtartalommal is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EHetenk\u00e9nt legal\u00e1bb n\u00e9gyszer megjelen\u0151 kiadv\u00e1ny (4902 10)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E10\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGyermekk\u00f6nyvek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4903\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGyermekk\u00e9pesk\u00f6nyv, rajzol\u00f3- vagy kifest\u0151k\u00f6nyv\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E11\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKott\u00e1k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4904\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00e9z\u00edr\u00e1sos vagy nyomtatott zenem\u0171, illusztr\u00e1lva vagy bek\u00f6tve is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E12\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ET\u00e9rk\u00e9pek, f\u00f6ldg\u00f6mb\u00f6k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4905\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyomtatott t\u00e9rk\u00e9p \u00e9s v\u00edzrajzi vagy minden m\u00e1s hasonl\u00f3 nyomtatott t\u00e9rk\u00e9p, bele\u00e9rtve az\u0026nbsp;atlaszt, falit\u00e9rk\u00e9pet, helyrajzi t\u00e9rk\u00e9pet \u00e9s f\u00f6ldg\u00f6mb\u00f6t is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00f6nyv alakban (4905 20)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E13\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENapt\u00e1rak\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4910\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EB\u00e1rmilyen nyomtatott\u0026nbsp;napt\u00e1r, bele\u00e9rtve a\u0026nbsp;napt\u00e1rblokkot is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E14\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ET\u00e1sk\u00e1k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E42\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E420211\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EB\u0151r\u00f6nd, koffer, piperedoboz, diplomatat\u00e1ska, aktat\u00e1ska, iskolat\u00e1ska \u00e9s hasonl\u00f3k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E15\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9sek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E90\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9017\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERajzol\u00f3-, jel\u00f6l\u0151-, vagy matematikai sz\u00e1mol\u00f3m\u0171szer \u00e9s eszk\u00f6z (pl. rajzol\u00f3g\u00e9p, pantogr\u00e1f, sz\u00f6gm\u00e9r\u0151, rajzol\u00f3k\u00e9szlet, logarl\u00e9c, logart\u00e1rcsa); ebbe az\u0026nbsp;\u00e1rucsoportba m\u00e1s vtsz. al\u00e1 nem besorolhat\u00f3 k\u00e9zi hossz\u00fas\u00e1gm\u00e9r\u0151 eszk\u00f6z (pl.\u0026nbsp;m\u00e9r\u0151r\u00fad \u00e9s -szalag, mikrom\u00e9ter,\u0026nbsp;k\u00f6rz\u0151)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERajzasztal \u00e9s rajzg\u00e9p, automata is (9017\u0026nbsp;10), M\u00e1s\u0026nbsp;rajzol\u00f3-, jel\u00f6l\u0151- vagy matematikai sz\u00e1mol\u00f3m\u0171szer \u00e9s eszk\u00f6z (9017\u0026nbsp;20),\u0026nbsp;Mikrom\u00e9ter, k\u00f6rz\u0151 \u00e9s tol\u00f3m\u00e9rce (9017\u0026nbsp;30), Alkatr\u00e9sz\u0026nbsp;\u00e9s tartoz\u00e9k (9017\u0026nbsp;90)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E16\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00cdr\u00f3szerek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E96\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9608\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGoly\u00f3stoll, filc- \u00e9s m\u00e1s, szivacsv\u00e9g\u0171 toll \u00e9s jelz\u0151; t\u00f6lt\u0151toll, rajzol\u00f3toll \u00e9s m\u00e1s toll; m\u00e1sol\u00f3 t\u00f6lt\u0151toll (\u00e1t\u00edr\u00f3toll); t\u00f6lt\u0151ceruza vagy cs\u00fasz\u00f3bet\u00e9tes ceruza; tollsz\u00e1r, ceruzahosszabb\u00edt\u00f3 \u00e9s hasonl\u00f3; mindezek alkatr\u00e9szei (bele\u00e9rtve a\u0026nbsp;kupakot \u00e9s a\u0026nbsp;klipszet is), a\u0026nbsp;9609\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 \u00e1ru kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGoly\u00f3stoll (9608 10), Filc- \u00e9s m\u00e1s, szivacsv\u00e9g\u0171 toll \u00e9s jelz\u0151 (9608 20), T\u00f6lt\u0151toll, rajzol\u00f3toll \u00e9s m\u00e1s toll (9608\u0026nbsp;30), T\u00f6lt\u0151ceruza vagy cs\u00fasz\u00f3bet\u00e9tes ceruza (9608\u0026nbsp;40), El\u0151bbi alsz\u00e1mok al\u00e1 tartoz\u00f3 \u00e1rukb\u00f3l kett\u0151 vagy t\u00f6bb, k\u00e9szletben (9608 50), Goly\u00f3stollbet\u00e9t, amely goly\u00f3shegyb\u0151l \u00e9s tintatart\u00e1lyb\u00f3l \u00e1ll (9608\u0026nbsp;60)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E17\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00cdr\u00f3szerek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E96\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9609\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ECeruza (a 9608\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 kiv\u00e9tel\u00e9vel), rajzkr\u00e9ta, ceruzab\u00e9l, pasztellkr\u00e9ta, rajzsz\u00e9n, \u00edr\u00f3- vagy rajzkr\u00e9ta \u00e9s szab\u00f3kr\u00e9ta\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ECeruza \u00e9s rajzkr\u00e9ta h\u00fcvelybe \u00e1gyazott b\u00e9llel (9609\u0026nbsp;10), Ceruzab\u00e9l, fekete vagy sz\u00ednes (9609\u0026nbsp;20)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E18\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00cdr\u00f3szerek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E96\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9610\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPalat\u00e1bla \u00e9s t\u00e1bla, \u00edr\u00f3- vagy rajzt\u00e1bla, kerettel is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E19\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9sek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E39\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E392610\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u0171anyagb\u00f3l k\u00e9sz\u00fclt hivatali vagy iskolai felszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u0171anyagb\u00f3l k\u00e9sz\u00fclt hivatali vagy iskolai felszerel\u00e9s\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E20\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETornafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E95\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9506\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00c1ltal\u00e1nos fizikai gyakorlatokhoz, torn\u00e1hoz, atl\u00e9tik\u00e1hoz, m\u00e1s sporthoz (bele\u00e9rtve az\u0026nbsp;asztaliteniszt is) vagy szabadt\u00e9ri j\u00e1t\u00e9khoz val\u00f3, ebben az\u0026nbsp;\u00e1rucsoportban m\u00e1shol nem eml\u00edtett cikk \u00e9s felszerel\u00e9s; \u00fasz\u00f3medence \u00e9s pancsol\u00f3medence\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ELabda, a\u0026nbsp;golflabda \u00e9s az\u0026nbsp;asztalitenisz-labda kiv\u00e9tel\u00e9vel (9506 61), Tornatermi, atl\u00e9tikai, valamint \u00e1ltal\u00e1nos fizikai gyakorlathoz haszn\u00e1lt felszerel\u00e9s (9506 91)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ES\u00edtalp \u00e9s m\u00e1s s\u00edfelszerel\u00e9s (9506\u0026nbsp;11), V\u00edzis\u00edtalp, hull\u00e1mlovas-, sz\u00e9llovas- \u00e9s m\u00e1s v\u00edzisport-felszerel\u00e9s (9506\u0026nbsp;21), Golf\u00fct\u0151 \u00e9s m\u00e1s golffelszerel\u00e9s (9506\u0026nbsp;31), Asztalitenisz-felszerel\u00e9s (9506 40), Tenisz-, tollaslabda- vagy hasonl\u00f3 \u00fct\u0151, h\u00farral ell\u00e1tva is (9506\u0026nbsp;51), J\u00e9gkorcsolya \u00e9s g\u00f6rkorcsolya, bele\u00e9rtve a korcsoly\u00e1val felszerelt cip\u0151t is (9506\u0026nbsp;70)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E21\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u002216\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u002216\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00f6t\u00f6tt ruh\u00e1k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u002216\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E61\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6101\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fafels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k (bele\u00e9rtve a\u0026nbsp;s\u00edzubbonyt is), -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l, a\u0026nbsp;6103\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 \u00e1ruk\u0026nbsp;kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fafels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k, -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l, a\u0026nbsp;6103\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 \u00e1ruk kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Es\u00edzubbony\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E22\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6102\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nyka-fels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k (bele\u00e9rtve a\u0026nbsp;s\u00edzubbonyt is), -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l, a\u0026nbsp;6104\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 \u00e1ruk kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nyka-fels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k, -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l, a\u0026nbsp;6104\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 \u00e1ruk kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Es\u00edzubbony\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E23\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6103\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fa\u00f6lt\u00f6ny, -ruhaegy\u00fcttes, -zak\u00f3, -bl\u00e9zer, -hossz\u00fanadr\u00e1g, v\u00e1llp\u00e1ntos \u00e9s melles munkanadr\u00e1g (overall), -bricsesznadr\u00e1g \u00e9s -sortnadr\u00e1g (a f\u00fcrd\u0151ruha kiv\u00e9tel\u00e9vel) k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fa\u00f6lt\u00f6ny, -ruhaegy\u00fcttes, -zak\u00f3, -bl\u00e9zer, -hossz\u00fanadr\u00e1g, -bricsesznadr\u00e1g \u00e9s -sortnadr\u00e1g (a f\u00fcrd\u0151ruha kiv\u00e9tel\u00e9vel) k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Ev\u00e1llp\u00e1ntos \u00e9s melles munkanadr\u00e1g (overall)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E24\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6104\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nykakoszt\u00fcm, -ruhaegy\u00fcttes, -ujjas, -bl\u00e9zer, -ruha, -szoknya, -nadr\u00e1gszoknya, -hossz\u00fanadr\u00e1g, v\u00e1llp\u00e1ntos \u00e9s melles munkanadr\u00e1g (overall), -bricsesznadr\u00e1g \u00e9s -sortnadr\u00e1g (a\u0026nbsp;f\u00fcrd\u0151ruha kiv\u00e9tel\u00e9vel) k\u00f6t\u00f6tt\u0026nbsp;vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nykakoszt\u00fcm, -ruhaegy\u00fcttes, -ujjas, -bl\u00e9zer, -ruha, -szoknya, -nadr\u00e1gszoknya, -hossz\u00fanadr\u00e1g, -bricsesznadr\u00e1g \u00e9s -sortnadr\u00e1g (a f\u00fcrd\u0151ruha kiv\u00e9tel\u00e9vel) k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Ev\u00e1llp\u00e1ntos \u00e9s melles munkanadr\u00e1g (overall)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E25\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6105\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00faing k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00faing k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E26\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6106\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nykabl\u00faz, -ing \u00e9s -ingbl\u00faz k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nykabl\u00faz, -ing \u00e9s -ingbl\u00faz k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E27\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6107\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00faals\u00f3nadr\u00e1g, -r\u00f6vidnadr\u00e1g, -h\u00e1l\u00f3ing, -pizsama, -f\u00fcrd\u0151k\u00f6peny, -h\u00e1zik\u00f6nt\u00f6s \u00e9s hasonl\u00f3 \u00e1ru k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00faals\u00f3nadr\u00e1g, -r\u00f6vidnadr\u00e1g, -h\u00e1l\u00f3ing, -pizsama, -f\u00fcrd\u0151k\u00f6peny, -h\u00e1zik\u00f6nt\u00f6s \u00e9s hasonl\u00f3 \u00e1ru k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E28\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6108\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1ny, -als\u00f3szoknya, -r\u00f6vidnadr\u00e1g, -als\u00f3nadr\u00e1g, -h\u00e1l\u00f3ing, -pizsama, -h\u00e1l\u00f3k\u00f6nt\u00f6s, -f\u00fcrd\u0151k\u00f6peny, -h\u00e1zik\u00f6nt\u00f6s \u00e9s hasonl\u00f3 \u00e1ruk k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1ny, -als\u00f3szoknya, -r\u00f6vidnadr\u00e1g, -als\u00f3nadr\u00e1g, -h\u00e1l\u00f3ing, -pizsama, -h\u00e1l\u00f3k\u00f6nt\u00f6s, -f\u00fcrd\u0151k\u00f6peny, -h\u00e1zik\u00f6nt\u00f6s \u00e9s hasonl\u00f3 \u00e1ruk k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E29\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6109\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ET-ing, atl\u00e9ta \u00e9s m\u00e1s als\u00f3 trik\u00f3ing k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ET-ing, atl\u00e9ta \u00e9s m\u00e1s als\u00f3 trik\u00f3ing k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E30\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6110\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EUjjas mell\u00e9ny, pul\u00f3ver, kardig\u00e1n, mell\u00e9ny \u00e9s hasonl\u00f3 \u00e1ru k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EUjjas mell\u00e9ny, pul\u00f3ver, kardig\u00e1n, mell\u00e9ny \u00e9s hasonl\u00f3 \u00e1ru k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E31\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6112\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETr\u00e9ningruha, s\u00ed\u00f6lt\u00f6ny \u00e9s f\u00fcrd\u0151ruha k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETr\u00e9ningruha \u00e9s f\u00fcrd\u0151ruha k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Es\u00ed\u00f6lt\u00f6ny k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E32\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6113\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EAz 5903, 5906\u0026nbsp;vagy az\u0026nbsp;5907\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l k\u00e9sz\u00fclt ruha\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E33\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6114\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s ruha k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s ruha k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E34\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6115\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EHarisnyanadr\u00e1g, harisnya, zokni \u00e9s m\u00e1s harisnya\u00e1ru \u00e9s a\u0026nbsp;talp n\u00e9lk\u00fcli harisny\u00e1t, k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EHarisnyanadr\u00e1g, harisnya, zokni \u00e9s m\u00e1s harisnya\u00e1ru k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E35\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6116\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00f6t\u00f6tt vagy hurkolt keszty\u0171, ujjatlan \u00e9s egyujjas keszty\u0171 is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00f6t\u00f6tt vagy hurkolt keszty\u0171, ujjatlan \u00e9s egyujjas keszty\u0171 is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E36\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6117\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s konfekcion\u00e1lt ruh\u00e1zati kell\u00e9kek \u00e9s tartoz\u00e9kok k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l; ruh\u00e1k, ruh\u00e1zati kell\u00e9kek \u00e9s tartoz\u00e9kok k\u00f6t\u00f6tt vagy hurkolt\u0026nbsp;r\u00e9szei\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKend\u0151, s\u00e1l, nyaks\u00e1l (6117 10)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Emantilla, f\u00e1tyol (6117 10)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E37\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u002215\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u002215\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENem k\u00f6t\u00f6tt ruh\u00e1k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u002215\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E62\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6201\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fa fels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k (bele\u00e9rtve a\u0026nbsp;s\u00edzubbonyt is), -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk, a\u0026nbsp;6203 vtsz. al\u00e1 tartoz\u00f3 \u00e1ruk kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fafels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k, -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk, a\u0026nbsp;6203\u0026nbsp;vtsz.\u0026nbsp;al\u00e1 tartoz\u00f3 \u00e1ruk kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Es\u00edzubbony\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E38\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6202\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nyka-fels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k (bele\u00e9rtve a\u0026nbsp;s\u00edzubbonyt is), -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk, a\u0026nbsp;6204\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3k kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i- vagy le\u00e1nyka-fels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k, -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk, a\u0026nbsp;6204\u0026nbsp;vtsz.\u0026nbsp;al\u00e1 tartoz\u00f3 \u00e1ruk kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Es\u00edzubbony\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E39\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6203\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fa\u00f6lt\u00f6ny, -ruhaegy\u00fcttes, -zak\u00f3, -bl\u00e9zer, -hossz\u00fanadr\u00e1g, v\u00e1llp\u00e1ntos \u00e9s melles munkanadr\u00e1g (overall), -bricsesznadr\u00e1g \u00e9s -sortnadr\u00e1g (a f\u00fcrd\u0151ruha kiv\u00e9tel\u00e9vel)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fa\u00f6lt\u00f6ny, -ruhaegy\u00fcttes, -zak\u00f3, -bl\u00e9zer, -hossz\u00fanadr\u00e1g, -bricsesznadr\u00e1g \u00e9s -sortnadr\u00e1g\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Ev\u00e1llp\u00e1ntos \u00e9s melles munkanadr\u00e1g (overall)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E40\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6204\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nykakoszt\u00fcm, -ruhaegy\u00fcttes, -ujjas, -bl\u00e9zer, -ruha, -szoknya, -nadr\u00e1gszoknya, -hossz\u00fanadr\u00e1g, v\u00e1llp\u00e1ntos \u00e9s melles munkanadr\u00e1g (overall), -bricsesznadr\u00e1g \u00e9s -sortnadr\u00e1g (a\u0026nbsp;f\u00fcrd\u0151ruha kiv\u00e9tel\u00e9vel)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nykakoszt\u00fcm, -ruhaegy\u00fcttes, -ujjas, -bl\u00e9zer, -ruha, -szoknya, -nadr\u00e1gszoknya, -hossz\u00fanadr\u00e1g, -bricsesznadr\u00e1g \u00e9s -sortnadr\u00e1g (a f\u00fcrd\u0151ruha kiv\u00e9tel\u00e9vel)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Ev\u00e1llp\u00e1ntos \u00e9s melles munkanadr\u00e1g (overall)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E41\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6205\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00faing\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00faing\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E42\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6206\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nykabl\u00faz, -ing \u00e9s -ingbl\u00faz\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nykabl\u00faz, -ing \u00e9s -ingbl\u00faz\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E43\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6207\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00faatl\u00e9ta \u00e9s m\u00e1s -als\u00f3ing, -als\u00f3nadr\u00e1g, -r\u00f6vidnadr\u00e1g, -h\u00e1l\u00f3ing, -pizsama, -f\u00fcrd\u0151k\u00f6peny, -h\u00e1zik\u00f6nt\u00f6s \u00e9s hasonl\u00f3 \u00e1ru\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00faatl\u00e9ta \u00e9s m\u00e1s -als\u00f3ing, -als\u00f3nadr\u00e1g, -r\u00f6vidnadr\u00e1g, -h\u00e1l\u00f3ing, -pizsama, -f\u00fcrd\u0151k\u00f6peny, -h\u00e1zik\u00f6nt\u00f6s \u00e9s hasonl\u00f3 \u00e1ru\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E44\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6208\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nyka-atl\u00e9taing \u00e9s m\u00e1s -als\u00f3ing, -als\u00f3szoknya, -r\u00f6vidnadr\u00e1g, -als\u00f3nadr\u00e1g, -h\u00e1l\u00f3ing, -pizsama, -h\u00e1l\u00f3k\u00f6nt\u00f6s, -f\u00fcrd\u0151k\u00f6peny, -h\u00e1zik\u00f6nt\u00f6s \u00e9s hasonl\u00f3 \u00e1ru\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nyka-atl\u00e9taing \u00e9s m\u00e1s -als\u00f3ing, -als\u00f3szoknya, -r\u00f6vidnadr\u00e1g, -als\u00f3nadr\u00e1g, -h\u00e1l\u00f3ing, -pizsama, -h\u00e1l\u00f3k\u00f6nt\u00f6s, -f\u00fcrd\u0151k\u00f6peny, -h\u00e1zik\u00f6nt\u00f6s \u00e9s hasonl\u00f3 \u00e1ru\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E45\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6210\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EAz 5602, 5603, 5903, 5906\u0026nbsp;vagy az\u0026nbsp;5907\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 sz\u00f6vetekb\u0151l k\u00e9sz\u00fclt ruha\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E46\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6211\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETr\u00e9ningruha, s\u00ed\u00f6lt\u00f6ny \u00e9s f\u00fcrd\u0151ruha; m\u00e1s ruha\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETr\u00e9ningruha \u00e9s f\u00fcrd\u0151ruha\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Es\u00ed\u00f6lt\u00f6ny\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E47\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6212\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EMelltart\u00f3, cs\u00edp\u0151szor\u00edt\u00f3, f\u0171z\u0151, nadr\u00e1gtart\u00f3, harisnyatart\u00f3, zoknitart\u00f3 \u00e9s hasonl\u00f3 \u00e1ru \u00e9s ezek r\u00e9szei, k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Emelltart\u00f3\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Ecs\u00edp\u0151szor\u00edt\u00f3, f\u0171z\u0151, nadr\u00e1gtart\u00f3, harisnyatart\u00f3, zoknitart\u00f3\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6214\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKend\u0151, s\u00e1l, nyaks\u00e1l, mantilla, f\u00e1tyol \u00e9s hasonl\u00f3\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKend\u0151, s\u00e1l, nyaks\u00e1l\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Emantilla, f\u00e1tyol\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6215\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyakkend\u0151, csokornyakkend\u0151 \u00e9s krav\u00e1tli\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyakkend\u0151, csokornyakkend\u0151 \u00e9s krav\u00e1tli\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E50\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6216\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKeszty\u0171, ujjatlan \u00e9s egyujjas keszty\u0171 is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKeszty\u0171, ujjatlan \u00e9s egyujjas keszty\u0171 is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E51\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6217\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s konfekcion\u00e1lt ruh\u00e1zati kell\u00e9kek \u00e9s tartoz\u00e9kok; ruh\u00e1k vagy ruh\u00e1zati kell\u00e9kek \u00e9s tartoz\u00e9kok r\u00e9szei, a\u0026nbsp;6212\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3k kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E52\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u00226\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u00226\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e1bbelik\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u00226\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E64\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6401\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EV\u00edzhatlan l\u00e1bbeli gumi- vagy m\u0171anyag k\u00fcls\u0151 talppal \u00e9s fels\u0151r\u00e9sszel, ha a\u0026nbsp;fels\u0151r\u00e9sz a\u0026nbsp;talphoz sem t\u0171z\u00e9ssel, szegecsel\u00e9ssel, sz\u00f6gel\u00e9ssel, csavaroz\u00e1ssal vagy hasonl\u00f3 elj\u00e1r\u00e1ssal nincs hozz\u00e1er\u0151s\u00edtve vagy \u00f6ssze\u00e1ll\u00edtva\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E-\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E53\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6402\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s l\u00e1bbeli gumi- vagy m\u0171anyag k\u00fcls\u0151 talppal \u00e9s fels\u0151r\u00e9sszel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESportcip\u0151 (6402 12), L\u00e1bbelik, p\u00e1ntb\u00f3l vagy sz\u00edjb\u00f3l \u00e1ll\u00f3 fels\u0151r\u00e9sze a\u0026nbsp;talphoz szegeccsel er\u0151s\u00edtve (6402 20)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ES\u00edcip\u0151, s\u00edbakancs, s\u00edfut\u00f3cip\u0151 \u00e9s h\u00f3deszkacip\u0151 (6402 12)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E54\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6403\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e1bbeli gumi-, m\u0171anyag, b\u0151r- vagy mesters\u00e9ges b\u0151r k\u00fcls\u0151 talppal \u00e9s b\u0151r fels\u0151r\u00e9sszel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESportcip\u0151 (6403 12)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ES\u00edcip\u0151, s\u00edbakancs, s\u00edfut\u00f3cip\u0151 \u00e9s h\u00f3deszkacip\u0151 (6403 12)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E55\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6404\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e1bbeli gumi-, m\u0171anyag, b\u0151r- vagy mesters\u00e9ges b\u0151r k\u00fcls\u0151 talppal \u00e9s textilanyag fels\u0151r\u00e9sszel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e1bbeli, gumi- vagy m\u0171anyag k\u00fcls\u0151 talppal (6404 11) Sportcip\u0151; tornacip\u0151, edz\u0151cip\u0151 \u00e9s hasonl\u00f3 (6404 11)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETeniszcip\u0151, kos\u00e1rlabdacip\u0151 (6404\u0026nbsp;11)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E56\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6405\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s l\u00e1bbeli\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E57\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6406\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e1bbelir\u00e9sz (bele\u00e9rtve a\u0026nbsp;fels\u0151r\u00e9szt is, a\u0026nbsp;bels\u0151 talphoz er\u0151s\u00edtve is); kiemelhet\u0151 talpb\u00e9l\u00e9s, sarokemel\u0151 \u00e9s hasonl\u00f3 \u00e1ru; l\u00e1bsz\u00e1rv\u00e9d\u0151, bokav\u00e9d\u0151 \u00e9s hasonl\u00f3 \u00e1ru \u00e9s ezek r\u00e9szei\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKivehet\u0151 talpbet\u00e9t \u00e9s m\u00e1s kivehet\u0151 r\u00e9szek (6406 90 50)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EFels\u0151r\u00e9sz \u00e9s r\u00e9szei, a\u0026nbsp;k\u00e9reg kiv\u00e9tel\u00e9vel (6406 10), K\u00fcls\u0151 talp \u00e9s sarok gumib\u00f3l vagy m\u0171anyagb\u00f3l (6406 20), M\u00e1s (6406\u0026nbsp;90), Fels\u0151r\u00e9sz-\u00f6ssze\u00e1ll\u00edt\u00e1sok, a\u0026nbsp;talpb\u00e9l\u00e9shez vagy m\u00e1s talpr\u00e9szhez er\u0151s\u00edtve, de a\u0026nbsp;k\u00fcls\u0151 talp n\u00e9lk\u00fcl (6406 90 30), K\u00fcls\u0151 talp b\u0151rb\u0151l vagy mesters\u00e9ges b\u0151rb\u0151l (6406 90 60)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E58\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u00223\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u00223\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKalapok, sapk\u00e1k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd rowspan=\u00223\u0022\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E65\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6504\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EB\u00e1rmilyen anyag\u00fa szalagb\u00f3l fon\u00e1ssal vagy m\u00e1s m\u00f3don \u00f6ssze\u00e1ll\u00edtott kalap \u00e9s m\u00e1s fejfed\u0151, b\u00e9lelve vagy d\u00edsz\u00edtve is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u0026nbsp;\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E59\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6505\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKalap \u00e9s m\u00e1s fejfed\u0151 k\u00f6t\u00f6tt vagy hurkolt kelm\u00e9b\u0151l vagy csipk\u00e9b\u0151l, nemezb\u0151l vagy m\u00e1s textilanyagb\u00f3l (de nem szalagb\u00f3l) el\u0151\u00e1ll\u00edtva, b\u00e9lelve vagy d\u00edsz\u00edtve is; hajh\u00e1l\u00f3 b\u00e1rmilyen anyagb\u00f3l, b\u00e9lelve vagy d\u00edsz\u00edtve is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E60\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6506\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u0026nbsp;\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s fejfed\u0151, b\u00e9lelve vagy d\u00edsz\u00edtve is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E61\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati tartoz\u00e9kok\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E39\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E392620\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek \u00e9s ruh\u00e1zati tartoz\u00e9kok (bele\u00e9rtve a\u0026nbsp;keszty\u0171t, az\u0026nbsp;ujjatlan \u00e9s egyujjas keszty\u0171t is)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E62\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGy\u00f3gyszerek \u00e9s t\u00e1pl\u00e1l\u00e9kkieg\u00e9sz\u00edt\u0151k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ET\u00e1pl\u00e1l\u00e9kkieg\u00e9sz\u00edt\u0151k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E29\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E2936\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETerm\u00e9szetes vagy szintetikus \u00faton el\u0151\u00e1ll\u00edtott provitaminok \u00e9s vitaminok (term\u00e9szetes koncentr\u00e1tum is), ezek sz\u00e1rmaz\u00e9kai, amelyeket els\u0151dlegesen, mint vitamint haszn\u00e1lnak, valamint ezek egym\u00e1s k\u00f6zti kever\u00e9kei, b\u00e1rmilyen old\u00f3szerben is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EVitaminok \u00e9s sz\u00e1rmaz\u00e9kaik, nem kevertek (2936\u0026nbsp;21), A-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936 21), B1-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936 22), B2-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936\u0026nbsp;23), D- vagy DL-pantot\u00e9nsav (B5 vitamin) \u00e9s sz\u00e1rmaz\u00e9kai (2936\u0026nbsp;24), B6-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936 25), B12-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936 26), C-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936\u0026nbsp;27), E-vitamin \u00e9s sz\u00e1rmaz\u00e9kai (2936 28)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E63\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGy\u00f3gy\u00e1szati seg\u00e9deszk\u00f6z\u00f6k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBraille t\u00e1bla\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E39, 83\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E392690, 8310\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u0171anyagb\u00f3l k\u00e9sz\u00fclt m\u00e1s \u00e1ruk \u00e9s a\u0026nbsp;3901\u20133914 vtsz. al\u00e1 tartoz\u00f3 m\u00e1s anyagokb\u00f3l k\u00e9sz\u00fclt \u00e1ruk.\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EJelz\u0151t\u00e1bla, n\u00e9vt\u00e1bla,\u0026nbsp;c\u00edmt\u00e1bla \u00e9s hasonl\u00f3 t\u00e1bla, sz\u00e1m, bet\u0171 \u00e9s m\u00e1s jel nem nemesf\u00e9mb\u0151l, a\u0026nbsp;9405 vtsz. al\u00e1 tartoz\u00f3 kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u0171anyag Braille t\u00e1bla (3926 90 97 90),\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9m Braille t\u00e1bla (8310 00 00 00)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EA megnevezett term\u00e9ken k\u00edv\u00fcl b\u00e1rmi m\u00e1s, a\u0026nbsp;kateg\u00f3ri\u00e1ba tartoz\u00f3 term\u00e9k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E64\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGy\u00f3gy\u00e1szati seg\u00e9deszk\u00f6z\u00f6k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00e9zi\u0026nbsp;pontoz\u00f3\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E82\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8205\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1shol nem eml\u00edtett k\u00e9ziszersz\u00e1m (bele\u00e9rtve a\u0026nbsp;gy\u00e9m\u00e1nthegy\u0171 \u00fcvegv\u00e1g\u00f3t is); forraszt\u00f3l\u00e1mpa; satu, befog\u00f3pofa \u00e9s hasonl\u00f3, a\u0026nbsp;szersz\u00e1mg\u00e9p vagy v\u00edzsugaras v\u00e1g\u00f3g\u00e9p tartoz\u00e9ka \u00e9s alkatr\u00e9sze kiv\u00e9tel\u00e9vel; \u00fcll\u0151; hordozhat\u00f3 kov\u00e1cst\u0171zhely; \u00e1llv\u00e1nyra szerelt, k\u00e9zi vagy l\u00e1bmeghajt\u00e1ssal m\u0171k\u00f6d\u0151 k\u00f6sz\u00f6r\u0171k\u0151\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00e9zi\u0026nbsp;pontoz\u00f3 vakoknak (8205 59 80 00)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EA megnevezett term\u00e9ken k\u00edv\u00fcl b\u00e1rmi m\u00e1s, a\u0026nbsp;kateg\u00f3ri\u00e1ba tartoz\u00f3 term\u00e9k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E65\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGy\u00f3gy\u00e1szati seg\u00e9deszk\u00f6z\u00f6k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EOrtop\u00e9diai eszk\u00f6z, fogyat\u00e9koss\u00e1g korrig\u00e1l\u00e1s\u00e1ra szolg\u00e1l\u00f3 eszk\u00f6z\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E90\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9021\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EOrtop\u00e9diai berendez\u00e9s, mank\u00f3, seb\u00e9szeti \u00f6v \u00e9s s\u00e9rvk\u00f6t\u0151; s\u00edn \u00e9s t\u00f6r\u00e9sn\u00e9l alkalmazhat\u00f3 m\u00e1s eszk\u00f6z; m\u0171testr\u00e9sz; hall\u00f3k\u00e9sz\u00fcl\u00e9k, tov\u00e1bb\u00e1 fogyat\u00e9koss\u00e1g vagy rokkants\u00e1g korrig\u00e1l\u00e1s\u00e1ra szolg\u00e1l\u00f3 \u00e9s testen viselhet\u0151 vagy hordozhat\u00f3, vagy szervezetbe be\u00fcltethet\u0151 m\u00e1s k\u00e9sz\u00fcl\u00e9k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EOrtop\u00e9diai vagy csontt\u00f6r\u00e9sn\u00e9l alkalmazott berendez\u00e9sek (9021 10), M\u00e1s m\u0171testr\u00e9sz (9021 31), Nagyothall\u00f3-k\u00e9sz\u00fcl\u00e9k, az\u0026nbsp;alkatr\u00e9sz \u00e9s tartoz\u00e9k kiv\u00e9tel\u00e9vel (9021 40), Sz\u00edvritmus-szab\u00e1lyoz\u00f3 k\u00e9sz\u00fcl\u00e9k (pacemaker), az\u0026nbsp;alkatr\u00e9sz \u00e9s tartoz\u00e9k kiv\u00e9tel\u00e9vel (9021 50)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u0171fog \u00e9s fogp\u00f3tl\u00e1s (9021 21)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E66\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGy\u00f3gy\u00e1szati seg\u00e9deszk\u00f6z\u00f6k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESzem\u00fcveg\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E90\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9004\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESzem\u00fcveg, v\u00e9d\u0151szem\u00fcveg \u00e9s hasonl\u00f3, l\u00e1t\u00e1sjav\u00edt\u00f3, v\u00e9d\u0151- vagy m\u00e1s szem\u00fcveg\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENapszem\u00fcveg optikailag megmunk\u00e1lt lencs\u00e9vel (9004 10)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E67\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EOptikai eszk\u00f6z\u00f6k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENagy\u00edt\u00f3\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E90\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EL\u00e9zer, a\u0026nbsp;l\u00e9zerdi\u00f3da kiv\u00e9tel\u00e9vel; ebben az\u0026nbsp;\u00e1rucsoportban m\u00e1shol nem eml\u00edtett m\u00e1s optikai k\u00e9sz\u00fcl\u00e9k \u00e9s m\u0171szer\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00e9zi nagy\u00edt\u00f3 (9013 80 80 00)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ET\u00e1vcs\u0151, teleszk\u00f3p, l\u00e9zer\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E68\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis \u00e9s m\u0171szaki cikkek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESz\u00e1mol\u00f3g\u00e9p\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E84\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E847010, 847021, 847030\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EElektronikus sz\u00e1mol\u00f3g\u00e9p, k\u00fcls\u0151 elektromos \u00e1ramforr\u00e1s n\u00e9lk\u00fcl m\u0171k\u00f6d\u0151 \u00e9s sz\u00e1mol\u00f3 funkci\u00f3val ell\u00e1tott zsebm\u00e9ret\u0171 adatr\u00f6gz\u00edt\u0151, el\u0151h\u00edv\u00f3 \u00e9s megjelen\u00edt\u0151g\u00e9p, M\u00e1s elektronikus sz\u00e1mol\u00f3g\u00e9p, M\u00e1s sz\u00e1mol\u00f3g\u00e9p\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E69\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis \u00e9s m\u0171szaki cikkek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis nagy\u00edt\u00f3\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E85\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8528\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EMonitorok \u00e9s kivet\u00edt\u0151k, be\u00e9p\u00edtett telev\u00edzi\u00f3vev\u0151-k\u00e9sz\u00fcl\u00e9k n\u00e9lk\u00fcl; telev\u00edzi\u00f3s ad\u00e1s v\u00e9tel\u00e9re alkalmas k\u00e9sz\u00fcl\u00e9k, r\u00e1di\u00f3m\u0171sor-vev\u0151k\u00e9sz\u00fcl\u00e9ket vagy hang- vagy k\u00e9pfelvev\u0151 vagy -lej\u00e1tsz\u00f3 k\u00e9sz\u00fcl\u00e9ket mag\u00e1ban\u0026nbsp;foglal\u00f3\u0026nbsp;is\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis nagy\u00edt\u00f3 (8528)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u0026nbsp;Telev\u00edzi\u00f3 k\u00e9sz\u00fcl\u00e9kek, sz\u00e1m\u00edt\u00f3g\u00e9p monitorok, projektorok\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E70\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis \u00e9s m\u0171szaki cikkek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EHangosk\u00f6nyv lej\u00e1tsz\u00f3\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E85\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8519\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EHangfelvev\u0151- vagy hanglej\u00e1tsz\u00f3 k\u00e9sz\u00fcl\u00e9k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EHangosk\u00f6nyv lej\u00e1tsz\u00f3 (8518 81)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EZeneg\u00e9pek, zenelej\u00e1tsz\u00f3k (8519\u0026nbsp;20), lemezj\u00e1tsz\u00f3k (8519 30)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E71\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis \u00e9s m\u0171szaki cikkek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPendrive, hangosk\u00f6nyv\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E85\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8523, 8543\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ELemezek, szalagok, szil\u00e1rd, \u00e1lland\u00f3 nem felejt\u0151 t\u00e1rol\u00f3 eszk\u00f6z\u00f6k, \u201cintelligens k\u00e1rty\u00e1k\u201d \u00e9s m\u00e1s adathordoz\u00f3k hang vagy m\u00e1s jel r\u00f6gz\u00edt\u00e9s\u00e9re, r\u00f6gz\u00edtett is, bele\u00e9rtve a\u0026nbsp;matric\u00e1t \u00e9s a\u0026nbsp;mesterlemezt lemezek gy\u00e1rt\u00e1s\u00e1hoz, a\u0026nbsp;37. \u00e1rucsoportba tartoz\u00f3 term\u00e9kek kiv\u00e9tel\u00e9vel.\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EEbben az\u0026nbsp;\u00e1rucsoportban m\u00e1shol nem eml\u00edtett elektromos g\u00e9p \u00e9s k\u00e9sz\u00fcl\u00e9k egyedi feladatokra\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9lvezet\u0151 adathordoz\u00f3 (8523 51),\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBraille kijelz\u0151 (8543)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EOptikai adathordoz\u00f3 (8523\u0026nbsp;41), M\u00e1gneses adathordoz\u00f3 (8523\u0026nbsp;21)\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EA megnevezett term\u00e9ken k\u00edv\u00fcl b\u00e1rmi m\u00e1s, a\u0026nbsp;kateg\u00f3ri\u00e1ba tartoz\u00f3 term\u00e9k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E72\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EDigit\u00e1lis \u00e9s m\u0171szaki cikkek\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESz\u00e1m\u00edt\u00f3g\u00e9p \u00e9s perif\u00e9ri\u00e1i\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E84\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8471\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EAutomatikus adatfeldolgoz\u00f3 g\u00e9p \u00e9s egys\u00e9gei; m\u00e1gneses vagy optikai leolvas\u00f3, adat\u00e1t\u00edr\u00f3 g\u00e9p a\u0026nbsp;k\u00f3dolt adat adathordoz\u00f3ra t\u00f6rt\u00e9n\u0151 \u00e1t\u00edr\u00e1s\u00e1ra \u00e9s m\u00e1shol nem eml\u00edtett g\u00e9p ilyen adatok feldolgoz\u00e1s\u00e1hoz\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E10 kg-n\u00e1l nem nehezebb hordozhat\u00f3 automatikus adatfeldolgoz\u00f3 g\u00e9p, amely legal\u00e1bb egy k\u00f6zponti feldolgoz\u00f3egys\u00e9get, egy billenty\u0171zetet \u00e9s egy megjelen\u00edt\u0151 egys\u00e9get tartalmaz (8471 30), M\u00e1s automatikus adatfeldolgoz\u00f3 g\u00e9p (8471 41), Feldolgoz\u00f3egys\u00e9g a\u0026nbsp;8471\u0026nbsp;41\u0026nbsp;vagy a\u0026nbsp;8471 49 alsz\u00e1m al\u00e1 tartoz\u00f3k kiv\u00e9tel\u00e9vel, ak\u00e1r tartalmaz egy burkolaton bel\u00fcl a\u0026nbsp;k\u00f6vetkez\u0151 egys\u00e9gekb\u0151l egyet vagy kett\u0151t, ak\u00e1r nem: t\u00e1rol\u00f3egys\u00e9g, inputegys\u00e9g, outputegys\u00e9g (8471\u0026nbsp;50), Input- vagy outputegys\u00e9g, t\u00e1rol\u00f3egys\u00e9ggel egy\u0026nbsp;burkolatban is (8471\u0026nbsp;60), T\u00e1rol\u00f3egys\u00e9g (8471 70), M\u00e1s\u0026nbsp;egys\u00e9g automatikus adatfeldolgoz\u00f3 g\u00e9pekhez (8471 80)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E73\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIrodai g\u00e9p\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBraille nyomtat\u00f3\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ESpeci\u00e1lis Braille \u00edr\u00f3g\u00e9p\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E84\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8443, 84729080\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyomdaipari g\u00e9p, amely nyom\u00f3lapok, nyom\u00f3hengerek \u00e9s m\u00e1s, a\u0026nbsp;8442 vtsz. al\u00e1 tartoz\u00f3 nyom\u00f3alkatr\u00e9szek seg\u00edts\u00e9g\u00e9vel m\u0171k\u00f6dik; m\u00e1s\u0026nbsp;nyomtat\u00f3k, m\u00e1sol\u00f3g\u00e9pek \u00e9s faxg\u00e9pek, kombin\u00e1lva is; ezek\u0026nbsp;alkatr\u00e9szei \u00e9s tartoz\u00e9kai. M\u00e1s irodai g\u00e9p-M\u00e1s-M\u00e1s\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBraille nyomtat\u00f3 (8443)\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s (84729080)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EA megnevezett term\u00e9ken k\u00edv\u00fcl b\u00e1rmi m\u00e1s, a\u0026nbsp;kateg\u00f3ri\u00e1ba tartoz\u00f3 term\u00e9k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E74\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EJ\u00e1t\u00e9kok\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EFejleszt\u0151j\u00e1t\u00e9kok\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E95\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9503, 95049080\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETriciklik, rollerek, ped\u00e1los aut\u00f3k \u00e9s hasonl\u00f3 kerekes j\u00e1t\u00e9kok; j\u00e1t\u00e9k babakocsik; bab\u00e1k; m\u00e1s j\u00e1t\u00e9kok; cs\u00f6kkentett m\u00e9ret\u0171 (\u201cm\u00e9retar\u00e1nyos\u201d) modellek \u00e9s sz\u00f3rakoz\u00e1sra sz\u00e1nt hasonl\u00f3 modellek, m\u0171k\u00f6d\u0151 is; mindenf\u00e9le kirak\u00f3s j\u00e1t\u00e9kok (puzzle).\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EAsztali vagy t\u00e1rsasj\u00e1t\u00e9k\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKiz\u00e1r\u00f3lag embert \u00e1br\u00e1zol\u00f3 j\u00e1t\u00e9kbaba, \u00e9s r\u00e9sz \u00e9s tartoz\u00e9k (9503 00 21), M\u00e1s \u00e9p\u00edt\u0151k\u00e9szlet \u00e9s \u00e9p\u00edt\u0151j\u00e1t\u00e9k (9503 00\u0026nbsp;35), J\u00e1t\u00e9k hangszer \u00e9s k\u00e9sz\u00fcl\u00e9k (9503 00 55), Kirak\u00f3s j\u00e1t\u00e9k (puzzle) (9503 00 61), M\u00e1s j\u00e1t\u00e9k k\u00e9szletben (9503 00 70),\u003C\/span\u003E\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u00e1s (95049080)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003E\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETriciklik, rollerek, ped\u00e1los aut\u00f3k \u00e9s hasonl\u00f3 kerekes j\u00e1t\u00e9kok; j\u00e1t\u00e9k babakocsik (9503 00 10), Villanyvonat, v\u00e1g\u00e1ny, jelz\u0151l\u00e1mpa \u00e9s m\u00e1s tartoz\u00e9kai; cs\u00f6kkentett m\u00e9ret\u0171 \u201cm\u00e9retar\u00e1nyos\u201d \u00f6sszeszerelhet\u0151 modell k\u00e9szletben, m\u0171k\u00f6d\u0151\u0026nbsp;is (9503\u0026nbsp;00\u0026nbsp;30), \u00c1llatot vagy nem embert \u00e1br\u00e1zol\u00f3 j\u00e1t\u00e9k (9503\u0026nbsp;00\u0026nbsp;41), Be\u00e9p\u00edtett motorral m\u0171k\u00f6d\u0151 m\u00e1s j\u00e1t\u00e9k \u00e9s modell (9503 00\u0026nbsp;75)\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003C\/tbody\u003E\u003C\/table\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E2. mell\u00e9klet a 223\/2026. (X. 1.) Korm. rendelethez\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp class=\u0022text-align-center\u0022\u003EAz iskolakezd\u00e9si utalv\u00e1ny tartalmi \u00e9s formai felt\u00e9telei\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003EAz iskolakezd\u00e9si utalv\u00e1ny\u003C\/p\u003E\u003Cp\u003E1.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E6 darab 5000, 6 darab 2000, 8 darab 1000 forintos c\u00edmlet\u0171 vagy az R. 3. \u00a7 (4) bekezd\u00e9se szerinti esetben 3\u0026nbsp;darab 5000 forint, 3 darab 2000 forint, 4 darab 1000 forint c\u00edmlet\u0171,\u003C\/p\u003E\u003Cp\u003E2.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Esorsz\u00e1mozott \u00e9s vonalk\u00f3ddal ell\u00e1tott,\u003C\/p\u003E\u003Cp\u003E3.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Eegyedi v\u00edzjelet tartalmaz,\u003C\/p\u003E\u003Cp\u003E4.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Etartalmazza a kibocs\u00e1t\u00f3 megnevez\u00e9s\u00e9t,\u003C\/p\u003E\u003Cp\u003E5.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Etartalmazza az \u00e9rv\u00e9nyess\u00e9gi idej\u00e9t,\u003C\/p\u003E\u003Cp\u003E6.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea kincst\u00e1r \u00e1ltal meghat\u00e1rozott \u00e9s a honlapj\u00e1n nyilv\u00e1noss\u00e1gra hozott biztons\u00e1gi elemekkel rendelkezik.\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E","format":"full_html","processed":"\u003Cp\u003E[1]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EE\u0026nbsp;rendelet c\u00e9lja, hogy az\u0026nbsp;iskolakezd\u00e9ssel kapcsolatos kiad\u00e1sok visel\u00e9s\u00e9hez hozz\u00e1j\u00e1rul\u00f3 iskolakezd\u00e9si t\u00e1mogat\u00e1s utalv\u00e1ny form\u00e1ban t\u00f6rt\u00e9n\u0151 juttat\u00e1s\u00e1hoz sz\u00fcks\u00e9ges szab\u00e1lyokat meghat\u00e1rozza.\u003C\/p\u003E\n\u003Cp\u003E[2]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;Korm\u00e1ny az\u0026nbsp;Alapt\u00f6rv\u00e9ny 15.\u0026nbsp;cikk (3)\u0026nbsp;bekezd\u00e9s\u00e9ben meghat\u00e1rozott eredeti jogalkot\u00f3i hat\u00e1sk\u00f6r\u00e9ben, az\u0026nbsp;Alapt\u00f6rv\u00e9ny 15.\u0026nbsp;cikk (1)\u0026nbsp;bekezd\u00e9s\u00e9ben meghat\u00e1rozott feladatk\u00f6r\u00e9ben elj\u00e1rva a\u0026nbsp;k\u00f6vetkez\u0151ket rendeli el:\u003C\/p\u003E\n\u003Cp\u003E1.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EE rendelet alkalmaz\u00e1s\u00e1ban\u003C\/p\u003E\n\u003Cp\u003E1.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E\u003Cem\u003Eiskolakezd\u00e9si utalv\u00e1ny:\u003C\/em\u003E a\u0026nbsp;Magyar \u00c1llamkincst\u00e1r (a\u0026nbsp;tov\u00e1bbiakban: kincst\u00e1r) \u00e1ltal kibocs\u00e1tott, a\u0026nbsp;kincst\u00e1rral szembeni p\u00e9nzk\u00f6vetel\u00e9st megtestes\u00edt\u0151 bankjegynek, forgathat\u00f3 utalv\u00e1nynak, a\u0026nbsp;hitelint\u00e9zetekr\u0151l \u00e9s a\u0026nbsp;p\u00e9nz\u00fcgyi v\u00e1llalkoz\u00e1sokr\u00f3l sz\u00f3l\u00f3\u0026nbsp;t\u00f6rv\u00e9ny szerinti k\u00e9szp\u00e9nz-helyettes\u00edt\u0151 fizet\u00e9si eszk\u00f6znek, valamint \u00e9rt\u00e9kpap\u00edrnak nem min\u0151s\u00fcl\u0151 \u00e9s iskolaszert \u00e1rus\u00edt\u00f3 keresked\u0151n\u00e9l, iskolaszer megv\u00e1s\u00e1rl\u00e1sa ellen\u00e9rt\u00e9k\u00e9nek kiegyenl\u00edt\u00e9s\u00e9re szolg\u00e1l\u00f3 pap\u00edralap\u00fa fizet\u00e9si eszk\u00f6z,\u003C\/p\u003E\n\u003Cp\u003E2.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E\u003Cem\u003Eiskolaszer:\u003C\/em\u003E az\u0026nbsp;1.\u0026nbsp;mell\u00e9kletben meghat\u00e1rozott term\u00e9k,\u003C\/p\u003E\n\u003Cp\u003E3.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E\u003Cem\u003Ejogosult:\u003C\/em\u003E az\u0026nbsp;iskolakezd\u00e9si t\u00e1mogat\u00e1sr\u00f3l sz\u00f3l\u00f3 112\/2026.\u0026nbsp;(VII. 23.) Korm.\u0026nbsp;rendelet (a\u0026nbsp;tov\u00e1bbiakban: R.) szerint utalv\u00e1ny form\u00e1j\u00e1ban iskolakezd\u00e9si t\u00e1mogat\u00e1sra jogosult szem\u00e9ly,\u003C\/p\u003E\n\u003Cp\u003E4.\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E\u003Cem\u003Ekeresked\u0151:\u003C\/em\u003E a\u0026nbsp;kereskedelemr\u0151l sz\u00f3l\u00f3\u0026nbsp;t\u00f6rv\u00e9ny szerinti kiskereskedelmi tev\u00e9kenys\u00e9get\u003C\/p\u003E\n\u003Cp\u003Ea)\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea\u0026nbsp;Gazdas\u00e1gi Tev\u00e9kenys\u00e9gek Egys\u00e9ges \u00c1gazati Oszt\u00e1lyoz\u00e1si Rendszer\u00e9ben (a\u0026nbsp;tov\u00e1bbiakban: TE\u00c1OR\u201925) \u201e47.11 \u00c9lelmiszer jelleg\u0171 vegyes kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.12 Iparcikk jelleg\u0171 vegyes kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.40 Inform\u00e1ci\u00f3s, h\u00edrad\u00e1stechnikai term\u00e9k kiskereskedelme\u201d, TE\u00c1OR\u201925 \u201e47.61 K\u00f6nyv-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.62 \u00dajs\u00e1g-, pap\u00edr\u00e1ru-, \u00edr\u00f3szer-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.63 Sportszer-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.64\u0026nbsp;J\u00e1t\u00e9k-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.71 Ruh\u00e1zat-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.72 L\u00e1bbeli-, b\u0151r\u00e1ru-kiskereskedelem\u201d, TE\u00c1OR\u201925 \u201e47.73 Gy\u00f3gyszer-kiskereskedelem\u201d vagy TE\u00c1OR\u201925 \u201e47.74\u0026nbsp;Gy\u00f3gy\u00e1szati \u00e9s ortop\u00e9diai term\u00e9k kiskereskedelme\u201d alatt,\u003C\/p\u003E\n\u003Cp\u003Eb)\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Eaz\u0026nbsp;\u00d6n\u00e1ll\u00f3 v\u00e1llalkoz\u00f3k tev\u00e9kenys\u00e9gi jegyz\u00e9k\u00e9ben (a\u0026nbsp;tov\u00e1bbiakban: \u00d6VTJ\u201925) \u201e471101 Vegyes-kiskereskedelem \u00e9lelmiszer jelleggel, \u00e9lelmiszer diszkont\u201d, \u00d6VTJ\u201925 \u201e471201 Iparcikk jelleg\u0171 vegyes kiskereskedelem m.n.s.\u201d, \u00d6VTJ\u201925 \u201e471202 \u00c1ltal\u00e1nos \u00e1ruh\u00e1zi kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e474001 Sz\u00e1m\u00edt\u00f3g\u00e9p, perif\u00e9ria, szoftver kiskereskedelme\u201d, \u00d6VTJ\u201925 \u201e476101 K\u00f6nyv-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e476201 Pap\u00edr-, \u00edr\u00f3szer-, irodaszer- \u00e9s nyomtatv\u00e1ny-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e476202 H\u00edrlap, foly\u00f3irat, id\u0151szaki kiadv\u00e1ny kiskereskedelme\u201d, \u00d6VTJ\u201925 \u201e476301 Sport\u00e1ru-, sporthorg\u00e1szati- \u00e9s kempingcikk-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e476401 J\u00e1t\u00e9k-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477101\u0026nbsp;Egy\u00e9b ruh\u00e1zati kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477102 Fels\u0151ruh\u00e1zati, munkaruha-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477103 B\u0151r-, sz\u0151rmeruh\u00e1zati-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477104 N\u00e9pm\u0171v\u00e9szeti ruh\u00e1zati kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477105 K\u00f6t\u00f6tt\u00e1ru-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477106 Feh\u00e9rnem\u0171-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477107 Gyermekruh\u00e1zati kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477108 Ruh\u00e1zati kieg\u00e9sz\u00edt\u0151k kiskereskedelme\u201d, \u00d6VTJ\u201925 \u201e477201 L\u00e1bbeli-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477202 B\u0151rd\u00edszm\u0171\u00e1ru-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477203 N\u00e9pm\u0171v\u00e9szeti l\u00e1bbeli-, b\u0151r\u00e1ru-kiskereskedelem\u201d, \u00d6VTJ\u201925 \u201e477301 Gy\u00f3gyszer-kiskereskedelem m.n.s.\u201d, \u00d6VTJ\u201925 \u201e477401 Gy\u00f3gy\u00e1szati seg\u00e9deszk\u00f6z kiskereskedelme (eg\u00e9szs\u00e9g\u00fcgyi szolg\u00e1ltat\u00e1sk\u00e9nt)\u201d, \u00d6VTJ\u201925 \u201e477402 Egy\u00e9b gy\u00f3gy\u00e1szati term\u00e9k kiskereskedelme\u201d vagy \u00d6VTJ\u201925 \u201e477403 L\u00e1tszer\u00e9szek tev\u00e9kenys\u00e9ge\u201d alatt\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ev\u00e9gz\u0151, iskolaszert \u00e1rus\u00edt\u00f3 keresked\u0151.\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E2.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyt a\u0026nbsp;2.\u0026nbsp;mell\u00e9klet szerinti tartalmi \u00e9s formai felt\u00e9teleknek megfelel\u0151en kell el\u0151\u00e1ll\u00edtani.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny kialak\u00edt\u00e1s\u00e1ban, el\u0151\u00e1ll\u00edt\u00e1s\u00e1ban, k\u00e9zbes\u00edt\u00e9sre t\u00f6rt\u00e9n\u0151 el\u0151k\u00e9sz\u00edt\u00e9s\u00e9ben \u00e9s az\u0026nbsp;egyetemes postai szolg\u00e1ltat\u00f3n kereszt\u00fcl annak k\u00e9zbes\u00edt\u00e9s\u00e9ben \u2013 a\u0026nbsp;kincst\u00e1r megb\u00edz\u00e1s\u00e1nak megfelel\u0151en \u2013 a\u0026nbsp;NISZ Nemzeti Infokommunik\u00e1ci\u00f3s Szolg\u00e1ltat\u00f3 Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g k\u00f6zrem\u0171k\u00f6dik, amelynek r\u00e9szleteir\u0151l a\u0026nbsp;felek egy\u00fcttm\u0171k\u00f6d\u00e9si \u00e9s adatfeldolgoz\u00e1si meg\u00e1llapod\u00e1st k\u00f6tnek.\u003C\/p\u003E\n\u003Cp\u003E3.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;jogosultat \u2013 a\u0026nbsp;(2)\u0026nbsp;bekezd\u00e9sben foglalt kiv\u00e9tellel \u2013 6 darab 5000\u0026nbsp;forint, 6 darab 2000\u0026nbsp;forint, 8 darab 1000\u0026nbsp;forint\u0026nbsp;c\u00edmlet\u0171, \u00f6sszesen 50\u003Cspan\u003E\u2005\u003C\/span\u003E000\u0026nbsp;forint \u00e9rt\u00e9k\u0171 iskolakezd\u00e9si utalv\u00e1ny illeti meg.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;R. 3.\u0026nbsp;\u00a7 (4)\u0026nbsp;bekezd\u00e9se szerinti esetben a\u0026nbsp;jogosultat 3 darab 5000\u0026nbsp;forint, 3 darab 2000\u0026nbsp;forint, 4 darab 1000\u0026nbsp;forint\u0026nbsp;c\u00edmlet\u0171, \u00f6sszesen 25 000\u0026nbsp;forint \u00e9rt\u00e9k\u0171 iskolakezd\u00e9si utalv\u00e1ny illeti meg.\u003C\/p\u003E\n\u003Cp\u003E4.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;kincst\u00e1r a\u0026nbsp;NISZ Nemzeti Infokommunik\u00e1ci\u00f3s Szolg\u00e1ltat\u00f3 Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g bevon\u00e1s\u00e1val, a\u0026nbsp;(2)\u2013(5)\u0026nbsp;bekezd\u00e9sben foglaltak szerint int\u00e9zkedik az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nynak a\u0026nbsp;jogosultak r\u00e9sz\u00e9re t\u00f6rt\u00e9n\u0151 megk\u00fcld\u00e9s\u00e9r\u0151l.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyt tartalmaz\u00f3 k\u00fcldem\u00e9ny jogosultak r\u00e9sz\u00e9re t\u00f6rt\u00e9n\u0151 k\u00e9zbes\u00edt\u00e9s\u00e9t az\u0026nbsp;egyetemes postai szolg\u00e1ltat\u00f3 v\u00e9gzi.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(3)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyt 2026. november 30-\u00e1ig kell a\u0026nbsp;jogosult r\u00e9sz\u00e9re k\u00e9zbes\u00edteni vagy a\u0026nbsp;k\u00e9zbes\u00edt\u00e9st megk\u00eds\u00e9relni.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(4)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;egyetemes postai szolg\u00e1ltat\u00f3 a\u0026nbsp;k\u00e9zbes\u00edt\u00e9st kiz\u00e1r\u00f3lag egyszer k\u00eds\u00e9rli meg. A\u0026nbsp;postai k\u00e9zbes\u00edt\u00e9s eredm\u00e9nytelens\u00e9ge eset\u00e9n az\u0026nbsp;ism\u00e9telt kik\u00fcld\u00e9s ir\u00e1nti k\u00e9relmet \u2013 a\u0026nbsp;kincst\u00e1r honlapj\u00e1n k\u00f6zz\u00e9tett m\u00f3don \u2013 a\u0026nbsp;kincst\u00e1rn\u00e1l kell el\u0151terjeszteni. A\u0026nbsp;k\u00e9relem beny\u00fajt\u00e1s\u00e1nak jogveszt\u0151 hat\u00e1rideje 2027. janu\u00e1r 8.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(5)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;m\u00e1r kik\u00fcld\u00f6tt, de a\u0026nbsp;c\u00edmzett hal\u00e1la miatt r\u00e9sz\u00e9re nem k\u00e9zbes\u00edthet\u0151 iskolakezd\u00e9si utalv\u00e1nyt a\u0026nbsp;csal\u00e1dok t\u00e1mogat\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 1998.\u0026nbsp;\u00e9vi LXXXIV.\u0026nbsp;t\u00f6rv\u00e9ny 38.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s\u00e9ben foglaltak szerint az\u0026nbsp;ell\u00e1t\u00e1sra jogos\u00edt\u00f3 gyermek nevel\u00e9s\u00e9r\u0151l saj\u00e1t h\u00e1ztart\u00e1s\u00e1ban gondoskod\u00f3 szem\u00e9ly vagy int\u00e9zm\u00e9nyi elhelyez\u00e9s eset\u00e9n az\u0026nbsp;int\u00e9zm\u00e9nyvezet\u0151 r\u00e9sz\u00e9re \u2013 k\u00e9relemre \u2013 adja \u00e1t a\u0026nbsp;kincst\u00e1r. A\u0026nbsp;k\u00e9relem beny\u00fajt\u00e1s\u00e1nak jogveszt\u0151 hat\u00e1rideje 2027. febru\u00e1r 15.\u003C\/p\u003E\n\u003Cp\u003E5.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny 2027. m\u00e1rcius 15-\u00e9ig haszn\u00e1lhat\u00f3 fel iskolaszer megv\u00e1s\u00e1rl\u00e1s\u00e1ra.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EIskolaszer v\u00e1s\u00e1rl\u00e1sa eset\u00e9n a\u0026nbsp;keresked\u0151 k\u00f6teles a\u0026nbsp;v\u00e1s\u00e1rl\u00e1s ellen\u00e9rt\u00e9kek\u00e9nt az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny elfogad\u00e1s\u00e1ra.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(3)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny felhaszn\u00e1l\u00e1sakor a\u0026nbsp;keresked\u0151 ellen\u0151rzi az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny 2.\u0026nbsp;mell\u00e9klet szerinti tartalmi \u00e9s formai elemeit, \u00e9s csak az\u0026nbsp;azoknak megfelel\u0151 utalv\u00e1nyt fogadja el.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(4)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyt a\u0026nbsp;keresked\u0151\u0026nbsp;c\u00edmlet\u00e9rt\u00e9ken fogadhatja el a\u0026nbsp;v\u00e1s\u00e1rl\u00e1s ellen\u00e9rt\u00e9kek\u00e9nt, azt k\u00e9szp\u00e9nzre sem r\u00e9szben, sem eg\u00e9szben nem v\u00e1lthatja \u00e1t.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(5)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;keresked\u0151 a\u0026nbsp;felhaszn\u00e1l\u00e1s sor\u00e1n \u00e1tadott iskolakezd\u00e9si utalv\u00e1ny felhaszn\u00e1l\u00e1s\u00e1nak t\u00e9ny\u00e9t az\u0026nbsp;utalv\u00e1nyon r\u00f6gz\u00edti.\u003C\/p\u003E\n\u003Cp\u003E6.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;keresked\u0151 az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyt 2027. m\u00e1jus 15-\u00e9ig v\u00e1lthatja be a\u0026nbsp;p\u00e9nzforgalmi sz\u00e1ml\u00e1j\u00e1t vezet\u0151 p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 fi\u00f3ki p\u00e9nzt\u00e1r\u00e1ban, ennek hi\u00e1ny\u00e1ban b\u00e1rmely p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 fi\u00f3ki p\u00e9nzt\u00e1r\u00e1ban.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 a\u0026nbsp;bev\u00e1lt\u00e1skor elv\u00e9gzi az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny eredetis\u00e9g\u00e9nek ellen\u0151rz\u00e9s\u00e9t az\u0026nbsp;utalv\u00e1ny sorsz\u00e1m\u00e1nak \u00e9s az\u0026nbsp;utalv\u00e1ny biztons\u00e1gi elemeinek ellen\u0151rz\u00e9s\u00e9vel, \u00e9s a\u0026nbsp;bev\u00e1ltott utalv\u00e1ny ellen\u00e9rt\u00e9k\u00e9t \u2013 a\u0026nbsp;(3)\u0026nbsp;bekezd\u00e9s szerinti bev\u00e1lt\u00e1si d\u00edjjal cs\u00f6kkentett \u2013 n\u00e9v\u00e9rt\u00e9kben sz\u00e1mlap\u00e9nz vagy \u2013 p\u00e9nzforgalmi sz\u00e1mla hi\u00e1ny\u00e1ban\u0026nbsp;\u2013 k\u00e9szp\u00e9nz form\u00e1j\u00e1ban biztos\u00edtja a\u0026nbsp;bev\u00e1lt\u00f3 keresked\u0151 r\u00e9sz\u00e9re, ha ellen\u0151rz\u00e9se alapj\u00e1n a\u0026nbsp;keresked\u0151 erre jogosult. A\u0026nbsp;bev\u00e1lt\u00e1s m\u00f3dj\u00e1ra vonatkoz\u00f3 t\u00e1j\u00e9koztat\u00f3t a\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 a\u0026nbsp;honlapj\u00e1n k\u00f6zz\u00e9teszi.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(3)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny bev\u00e1lt\u00e1sa sor\u00e1n a\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 legfeljebb az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny n\u00e9v\u00e9rt\u00e9k\u00e9nek 1%-\u00e1t sz\u00e1m\u00edthatja fel bev\u00e1lt\u00e1si d\u00edjk\u00e9nt a\u0026nbsp;keresked\u0151 fel\u00e9. A\u0026nbsp;bev\u00e1lt\u00e1shoz kapcsol\u00f3d\u00f3an a\u0026nbsp;keresked\u0151 r\u00e9sz\u00e9re egy\u00e9b d\u00edj vagy jutal\u00e9k nem sz\u00e1m\u00edthat\u00f3 fel.\u003C\/p\u003E\n\u003Cp\u003E7.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny ellen\u00e9rt\u00e9k\u00e9t a\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 r\u00e9sz\u00e9re a\u0026nbsp;kincst\u00e1r t\u00e9r\u00edti meg. A\u0026nbsp;megt\u00e9r\u00edt\u00e9sre vonatkoz\u00f3 t\u00e1j\u00e9koztat\u00f3t (a\u0026nbsp;tov\u00e1bbiakban: t\u00e1j\u00e9koztat\u00f3) a\u0026nbsp;kincst\u00e1r a\u0026nbsp;honlapj\u00e1n k\u00f6zz\u00e9teszi.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;megt\u00e9r\u00edt\u00e9s a\u0026nbsp;t\u00e1j\u00e9koztat\u00f3ban meghat\u00e1rozott adatszolg\u00e1ltat\u00e1s alapj\u00e1n, ut\u00f3lagosan, heti elsz\u00e1mol\u00e1s keret\u00e9ben t\u00f6rt\u00e9nik. Az\u0026nbsp;adatszolg\u00e1ltat\u00e1sban a\u0026nbsp;bank k\u00f6zli az\u0026nbsp;elsz\u00e1mol\u00e1si id\u0151szak alatt n\u00e1la bev\u00e1ltott utalv\u00e1ny darabsz\u00e1m\u00e1t, n\u00e9v\u00e9rt\u00e9k\u00e9t, valamint a\u0026nbsp;bev\u00e1ltott utalv\u00e1ny sorsz\u00e1m\u00e1t.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(3)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 a\u0026nbsp;keresked\u0151 \u00e1ltal bev\u00e1ltott utalv\u00e1nyt a\u0026nbsp;t\u00e1j\u00e9koztat\u00f3ban meghat\u00e1rozottak szerinti elsz\u00e1mol\u00e1si \u00f6sszes\u00edt\u0151vel havonta eljuttatja a\u0026nbsp;kincst\u00e1r sz\u00e1m\u00e1ra. A\u0026nbsp;kincst\u00e1r az\u0026nbsp;\u00e1tvett iskolakezd\u00e9si utalv\u00e1nyt a\u0026nbsp;vonatkoz\u00f3 kincst\u00e1ri elj\u00e1r\u00e1srendj\u00e9ben meghat\u00e1rozott hat\u00e1rid\u0151 letelt\u00e9t k\u00f6vet\u0151en megsemmis\u00edti.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(4)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny tekintet\u00e9ben a\u0026nbsp;p\u00e9nzforgalmi szolg\u00e1ltat\u00f3 \u00e9s a\u0026nbsp;kincst\u00e1r k\u00f6z\u00f6tti v\u00e9gs\u0151 elsz\u00e1mol\u00e1s hat\u00e1rideje 2027. augusztus 15.\u003C\/p\u003E\n\u003Cp\u003E8.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny kibocs\u00e1t\u00e1s\u00e1val, gy\u00e1rt\u00e1s\u00e1val \u00e9s a\u0026nbsp;jogosultaknak val\u00f3 eljuttat\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 k\u00f6lts\u00e9geket a\u0026nbsp;k\u00f6zponti k\u00f6lts\u00e9gvet\u00e9s biztos\u00edtja.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;iskolakezd\u00e9si utalv\u00e1ny ellen\u00e9rt\u00e9k\u00e9vel \u00e9s elsz\u00e1mol\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 \u2013 7.\u0026nbsp;\u00a7 szerinti \u2013 kifizet\u00e9sek forr\u00e1sa a\u0026nbsp;k\u00f6zponti k\u00f6lts\u00e9gvet\u00e9s csal\u00e1di p\u00f3tl\u00e9k kifizet\u00e9s\u00e9re szolg\u00e1l\u00f3 el\u0151ir\u00e1nyzata.\u003C\/p\u003E\n\u003Cp\u003E9.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;5.\u0026nbsp;\u00a7 (1) \u00e9s (2)\u0026nbsp;bekezd\u00e9s\u00e9ben foglalt rendelkez\u00e9sek megs\u00e9rt\u00e9se eset\u00e9n \u2013 ha a\u0026nbsp;jogs\u00e9rt\u00e9s a\u0026nbsp;fogyaszt\u00f3v\u00e9delemr\u0151l sz\u00f3l\u00f3\u0026nbsp;t\u00f6rv\u00e9ny szerinti fogyaszt\u00f3t \u00e9rint \u2013 a\u0026nbsp;fogyaszt\u00f3v\u00e9delmi hat\u00f3s\u00e1g j\u00e1r el, a\u0026nbsp;fogyaszt\u00f3v\u00e9delemr\u0151l sz\u00f3l\u00f3\u0026nbsp;t\u00f6rv\u00e9nyben meghat\u00e1rozott szab\u00e1lyok szerint.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz\u0026nbsp;5.\u0026nbsp;\u00a7 (1) \u00e9s (2)\u0026nbsp;bekezd\u00e9s\u00e9ben foglalt rendelkez\u00e9sek a\u0026nbsp;fogyaszt\u00f3v\u00e9delemr\u0151l sz\u00f3l\u00f3\u0026nbsp;t\u00f6rv\u00e9ny alkalmaz\u00e1s\u00e1ban fogyaszt\u00f3v\u00e9delmi rendelkez\u00e9sek.\u003C\/p\u003E\n\u003Cp\u003E10.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EEz\u0026nbsp;a\u0026nbsp;rendelet \u2013 a\u0026nbsp;(2)\u0026nbsp;bekezd\u00e9sben foglalt kiv\u00e9tellel \u2013 a\u0026nbsp;kihirdet\u00e9s\u00e9t k\u00f6vet\u0151\u0026nbsp;napon l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;6.\u0026nbsp;\u00a7, a\u0026nbsp;7.\u0026nbsp;\u00a7 \u00e9s a\u0026nbsp;8.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9se 2026. november 1-j\u00e9n l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\n\u003Cp\u003E11.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EAz R. a\u0026nbsp;k\u00f6vetkez\u0151 8.\u0026nbsp;\u00a7-sal eg\u00e9sz\u00fcl ki:\u003C\/p\u003E\n\u003Cp\u003E\u201e8.\u0026nbsp;\u00a7 (1) Ha az\u0026nbsp;1.\u0026nbsp;\u00a7 szerinti jogosult r\u00e9sz\u00e9re a\u0026nbsp;4.\u0026nbsp;\u00a7 a)\u0026nbsp;pontja szerinti foly\u00f3s\u00edt\u00e1s 2026. augusztus 24-\u00e9ig nem t\u00f6rt\u00e9nt meg, a\u0026nbsp;kincst\u00e1r\u003C\/p\u003E\n\u003Cp\u003Ea) a\u0026nbsp;2.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s a) \u00e9s b)\u0026nbsp;pontj\u00e1ban meghat\u00e1rozott nyilv\u00e1ntart\u00e1sok \u00e9s\u003C\/p\u003E\n\u003Cp\u003Eb) a\u0026nbsp;2.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s c)\u0026nbsp;pontja szerinti adatszolg\u00e1ltat\u00e1s\u003C\/p\u003E\n\u003Cp\u003E2026. szeptember 5-ei \u00e1llapota szerinti adatai alapj\u00e1n fel\u00fclvizsg\u00e1lja az\u0026nbsp;iskolakezd\u00e9si t\u00e1mogat\u00e1sra val\u00f3 jogosults\u00e1got.\u003C\/p\u003E\n\u003Cp\u003E(2) A\u0026nbsp;kincst\u00e1r az\u0026nbsp;(1)\u0026nbsp;bekezd\u00e9s szerinti esetben\u003C\/p\u003E\n\u003Cp\u003Ea) a\u0026nbsp;4.\u0026nbsp;\u00a7 a)\u0026nbsp;pontja szerinti \u00f6sszeg foly\u00f3s\u00edt\u00e1s\u00e1r\u00f3l az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyr\u00f3l, valamint az\u0026nbsp;iskolakezd\u00e9si t\u00e1mogat\u00e1sr\u00f3l sz\u00f3l\u00f3 112\/2026.\u0026nbsp;(VII. 23.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 223\/2026. (X. 1.) Korm.\u0026nbsp;rendelet hat\u00e1lybal\u00e9p\u00e9s\u00e9t\u0151l sz\u00e1m\u00edtott 15.\u0026nbsp;napig,\u003C\/p\u003E\n\u003Cp\u003Eb) a\u0026nbsp;4.\u0026nbsp;\u00a7 b)\u0026nbsp;pontja szerinti \u00f6sszeg iskolakezd\u00e9si utalv\u00e1ny form\u00e1j\u00e1ban a\u0026nbsp;jogosult r\u00e9sz\u00e9re t\u00f6rt\u00e9n\u0151 eljuttat\u00e1s\u00e1r\u00f3l 2026.\u0026nbsp;november 30-\u00e1ig\u003C\/p\u003E\n\u003Cp\u003Egondoskodik.\u003C\/p\u003E\n\u003Cp\u003E(3) Az\u0026nbsp;Oktat\u00e1si Hivatal, valamint a\u0026nbsp;Nemzeti Szakk\u00e9pz\u00e9si \u00e9s Feln\u0151ttk\u00e9pz\u00e9si Hivatal az\u0026nbsp;(1)\u0026nbsp;bekezd\u00e9s b)\u0026nbsp;pontja szerinti adatokat az\u0026nbsp;iskolakezd\u00e9si utalv\u00e1nyr\u00f3l, valamint az\u0026nbsp;iskolakezd\u00e9si t\u00e1mogat\u00e1sr\u00f3l sz\u00f3l\u00f3 112\/2026.\u0026nbsp;(VII. 23.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 223\/2026. (X. 1.) Korm.\u0026nbsp;rendelet hat\u00e1lybal\u00e9p\u00e9s\u00e9t k\u00f6vet\u0151\u0026nbsp;napon adja \u00e1t a\u0026nbsp;kincst\u00e1r r\u00e9sz\u00e9re.\u003C\/p\u003E\n\u003Cp\u003E(4) A\u0026nbsp;(2)\u0026nbsp;bekezd\u00e9s a)\u0026nbsp;pontj\u00e1t a\u0026nbsp;2.\u0026nbsp;\u00a7 (3)\u0026nbsp;bekezd\u00e9se szerinti csal\u00e1dt\u00e1mogat\u00e1si kifizet\u0151helyre is alkalmazni kell.\u201d\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E1.\u0026nbsp;mell\u00e9klet a\u0026nbsp;223\/2026. (X. 1.) Korm.\u0026nbsp;rendelethez\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003EIskolakezd\u00e9si utalv\u00e1nnyal megv\u00e1s\u00e1rolhat\u00f3 term\u00e9kek\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003EIskolaszer:\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003EA v\u00e1m- \u00e9s a\u0026nbsp;statisztikai n\u00f3menklat\u00far\u00e1r\u00f3l, valamint a\u0026nbsp;K\u00f6z\u00f6s V\u00e1mtarif\u00e1r\u00f3l sz\u00f3l\u00f3 2658\/87\/EGK tan\u00e1csi rendelet I.\u0026nbsp;mell\u00e9klet\u00e9nek m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3, 2021. okt\u00f3ber 12-i (EU)\u0026nbsp;2021\/1832\u0026nbsp;bizotts\u00e1gi v\u00e9grehajt\u00e1si rendelet 1.\u0026nbsp;mell\u00e9klet\u00e9nek m\u00e1sodik r\u00e9sze szerinti, az al\u00e1bbi \u00e1rucsoportba, illetve \u00e1rukateg\u00f3ri\u00e1ba tartoz\u00f3 term\u00e9kek:\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Ctable\u003E\n\u003Ctbody\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\u0026nbsp;\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EA\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EB\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EC\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003ED\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EE\u0026nbsp;\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EF\u0026nbsp;\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EG\u0026nbsp;\u003C\/span\u003E\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\u003Cspan\u003E1\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EK\u00f6znapi term\u00e9kcsoport\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EK\u00f6znapi term\u00e9kn\u00e9v\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EVTSZ \u00c1rucsoport\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EVTSZ \u00c1rukateg\u00f3ria\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EVTSZ elnevez\u00e9s\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EVTSZ \u00e1rukateg\u00f3ri\u00e1n bel\u00fcl iskolakezd\u00e9si utalv\u00e1nnyal megv\u00e1s\u00e1rolhat\u00f3\u0026nbsp;term\u00e9kek\u003C\/span\u003E\u003C\/td\u003E\n\u003Ctd\u003E\u003Cspan\u003EVTSZ \u00e1rukateg\u00f3ri\u00e1n bel\u00fcl iskolakezd\u00e9si utalv\u00e1nnyal nem v\u00e1s\u00e1rolhat\u00f3 term\u00e9kek\u003C\/span\u003E\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E2\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00cdr\u00f3pap\u00edr\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4802\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENem bevont pap\u00edr \u00e9s karton \u00edr\u00e1sra, nyomtat\u00e1sra vagy m\u00e1s grafikai c\u00e9lra, \u00e9s nem perfor\u00e1lt lyukk\u00e1rtya- \u00e9s lyukszalagpap\u00edr tekercsben vagy t\u00e9glalap (bele\u00e9rtve a\u0026nbsp;n\u00e9gyzet) alak\u00fa \u00edvben, b\u00e1rmilyen m\u00e9retben, a\u0026nbsp;4801\u0026nbsp;vagy a\u0026nbsp;4803 vtsz. al\u00e1\u0026nbsp;tartoz\u00f3 pap\u00edr kiv\u00e9tel\u00e9vel; k\u00e9zi mer\u00edt\u00e9s\u0171 pap\u00edr \u00e9s karton\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00e9zi mer\u00edt\u00e9s\u0171 pap\u00edr \u00e9s karton (4802\u0026nbsp;10), M\u00e1s pap\u00edr \u00e9s karton, amely nem vagy legfeljebb 10\u0026nbsp;t\u00f6megsz\u00e1zal\u00e9k mechanikai vagy vegyi-mechanikai elj\u00e1r\u00e1ssal nyert rostanyagot tartalmaz (4802 54), M\u00e1s pap\u00edr \u00e9s karton, amely t\u00f6bb mint 10\u0026nbsp;t\u00f6megsz\u00e1zal\u00e9k mechanikai vagy vegyi-mechanikai elj\u00e1r\u00e1ssal nyert rostanyagot tartalmaz (4802\u0026nbsp;61)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETap\u00e9ta alappap\u00edr (4802 40)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E3\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00c1tl\u00e1tsz\u00f3 pap\u00edrok\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4806\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u00f6v\u00e9nyi pergamen, zs\u00edrpap\u00edr, pauszpap\u00edr (\u00e1tm\u00e1sol\u00f3pap\u00edr), \u00e9s\u0026nbsp;pergamenpap\u00edr \u00e9s m\u00e1s f\u00e9nyezett, \u00e1tl\u00e1tsz\u00f3 vagy \u00e1ttetsz\u0151 pap\u00edr tekercsben vagy \u00edvben\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u00f6v\u00e9nyi pergamen (4806 10), Pauszpap\u00edr (\u00e1tm\u00e1sol\u00f3pap\u00edr) (4806 30), Pergamenpap\u00edr \u00e9s m\u00e1s f\u00e9nyezett, \u00e1tl\u00e1tsz\u00f3 vagy \u00e1ttetsz\u0151 pap\u00edr (4806\u0026nbsp;40)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EZs\u00edrpap\u00edr (4806 20)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ED\u00edszpap\u00edrok\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4810\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edr \u00e9s karton egyik vagy mindk\u00e9t oldal\u00e1n kaolinnal (k\u00ednai agyaggal) vagy m\u00e1s szervetlen anyaggal bevonva, k\u00f6t\u0151anyag felhaszn\u00e1l\u00e1s\u00e1val\u0026nbsp;is, de m\u00e1s bevonat n\u00e9lk\u00fcl, fel\u00fcletileg sz\u00ednezett, d\u00edsz\u00edtett vagy nyomtatott is, tekercsben vagy t\u00e9glalap (bele\u00e9rtve a\u0026nbsp;n\u00e9gyzet) alak\u00fa \u00edvben, b\u00e1rmilyen m\u00e9retben\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edr \u00e9s karton \u00edr\u00e1sra, nyomtat\u00e1sra vagy m\u00e1s grafikai c\u00e9lra, amely nem vagy legfeljebb 10\u0026nbsp;t\u00f6megsz\u00e1zal\u00e9k mechanikai, vagy vegyi-mechanikai elj\u00e1r\u00e1ssal nyert rostanyagot tartalmaz (4810 13), Pap\u00edr \u00e9s karton \u00edr\u00e1sra, nyomtat\u00e1sra vagy m\u00e1s grafikai c\u00e9lra, amely 10\u0026nbsp;t\u00f6megsz\u00e1zal\u00e9kn\u00e1l t\u00f6bb mechanikai vagy vegyi-mechanikai elj\u00e1r\u00e1ssal nyert rostanyagot tartalmaz (4810\u0026nbsp;22), N\u00e1tronpap\u00edr \u00e9s -karton, az\u0026nbsp;\u00edr\u00e1sra, nyomtat\u00e1sra vagy m\u00e1s grafikai c\u00e9lra haszn\u00e1lt pap\u00edr kiv\u00e9tel\u00e9vel (4810\u0026nbsp;31), M\u00e1s\u0026nbsp;pap\u00edr \u00e9s karton (4810 92)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E5\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edr bor\u00edt\u00e9k \u00e9s t\u00e1rol\u00f3\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4817\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBor\u00edt\u00e9k, z\u00e1rt levelez\u0151lap, postai levelez\u0151lap \u00e9s m\u00e1s levelez\u0151lap pap\u00edrb\u00f3l vagy kartonb\u00f3l; levelez\u0151pap\u00edr-k\u00e9szletet tartalmaz\u00f3, pap\u00edrb\u00f3l vagy kartonb\u00f3l k\u00e9sz\u00fclt doboz, tasak, t\u00e1rca \u00e9s mappa\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EBor\u00edt\u00e9k (4817 10), Z\u00e1rt levelez\u0151lap, postai levelez\u0151lap \u00e9s m\u00e1s levelez\u0151lap (4817\u0026nbsp;20), Levelez\u0151pap\u00edr-k\u00e9szletet tartalmaz\u00f3, pap\u00edrb\u00f3l vagy kartonb\u00f3l k\u00e9sz\u00fclt doboz, tasak, t\u00e1rca \u00e9s mappa (4817\u0026nbsp;30)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EJegyzett\u00f6mb\u00f6k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4820\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERegiszter, \u00fczleti k\u00f6nyv, jegyzetf\u00fczet (notesz), megrendel\u0151k\u00f6nyv, orvosi v\u00e9nyt\u00f6mb, \u00edr\u00f3t\u00f6mb, el\u0151jegyz\u00e9si jegyzett\u00f6mb,\u0026nbsp;napl\u00f3 \u00e9s hasonl\u00f3 term\u00e9k, iskolai f\u00fczet, \u00edr\u00f3mappa, iratrendez\u0151 (cser\u00e9lhet\u0151 lapokkal vagy m\u00e1s), dosszi\u00e9, iratbor\u00edt\u00f3, sokszoros\u00edtott \u00fczleti \u0171rlap, karbon bet\u00e9tlapos t\u00f6mb \u00e9s m\u00e1s irodaszer pap\u00edrb\u00f3l vagy kartonb\u00f3l; album, mint\u00e1k vagy gy\u0171jtem\u00e9nyek sz\u00e1m\u00e1ra \u00e9s k\u00f6nyvbor\u00edt\u00f3 pap\u00edrb\u00f3l vagy kartonb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERegiszter, \u00fczleti k\u00f6nyv, jegyzetf\u00fczet (notesz), megrendel\u0151k\u00f6nyv, orvosi v\u00e9nyt\u00f6mb, \u00edr\u00f3t\u00f6mb, el\u0151jegyz\u00e9si t\u00f6mb,\u0026nbsp;napl\u00f3 \u00e9s hasonl\u00f3 term\u00e9k (4820\u0026nbsp;10), Iskolai f\u00fczet (4820 20), Iratrendez\u0151 (a\u0026nbsp;k\u00f6nyvbor\u00edt\u00f3 kiv\u00e9tel\u00e9vel), dosszi\u00e9 \u00e9s iratbor\u00edt\u00f3 (4820 30), Sokszoros\u00edtott \u00fczleti \u0171rlap \u00e9s karbon bet\u00e9tlapos t\u00f6mb (4820 40), Album mint\u00e1k vagy gy\u0171jtem\u00e9nyek sz\u00e1m\u00e1ra (4820\u0026nbsp;50)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E7\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EC\u00edmk\u00e9k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E48\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4821\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EMindenf\u00e9le\u0026nbsp;c\u00edmke pap\u00edrb\u00f3l vagy kartonb\u00f3l, nyomtatott is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyomtatott (4821 10)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E8\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00f6nyvek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4901\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyomtatott k\u00f6nyv, bros\u00fara, r\u00f6pirat \u00e9s hasonl\u00f3 nyomtatv\u00e1ny, egyes\u0026nbsp;lapokban is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EEgyes lapokban, hajtogatva is (4901 10), Sz\u00f3t\u00e1r \u00e9s enciklop\u00e9dia \u00e9s ilyen sorozatok folytat\u00e1sai (4901 91)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00dajs\u00e1gok\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4902\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00dajs\u00e1g, foly\u00f3irat \u00e9s id\u0151szakos kiadv\u00e1ny, illusztr\u00e1lva vagy rekl\u00e1mtartalommal is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EHetenk\u00e9nt legal\u00e1bb n\u00e9gyszer megjelen\u0151 kiadv\u00e1ny (4902 10)\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E10\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGyermekk\u00f6nyvek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4903\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGyermekk\u00e9pesk\u00f6nyv, rajzol\u00f3- vagy kifest\u0151k\u00f6nyv\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E11\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EKott\u00e1k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4904\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00e9z\u00edr\u00e1sos vagy nyomtatott zenem\u0171, illusztr\u00e1lva vagy bek\u00f6tve is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E12\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ET\u00e9rk\u00e9pek, f\u00f6ldg\u00f6mb\u00f6k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4905\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENyomtatott t\u00e9rk\u00e9p \u00e9s v\u00edzrajzi vagy minden m\u00e1s hasonl\u00f3 nyomtatott t\u00e9rk\u00e9p, bele\u00e9rtve az\u0026nbsp;atlaszt, falit\u00e9rk\u00e9pet, helyrajzi t\u00e9rk\u00e9pet \u00e9s f\u00f6ldg\u00f6mb\u00f6t is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00f6nyv alakban (4905 20)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E13\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPap\u00edrterm\u00e9kek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ENapt\u00e1rak\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E49\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E4910\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EB\u00e1rmilyen nyomtatott\u0026nbsp;napt\u00e1r, bele\u00e9rtve a\u0026nbsp;napt\u00e1rblokkot is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E14\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ET\u00e1sk\u00e1k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E42\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E420211\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EB\u0151r\u00f6nd, koffer, piperedoboz, diplomatat\u00e1ska, aktat\u00e1ska, iskolat\u00e1ska \u00e9s hasonl\u00f3k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E15\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9sek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E90\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9017\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERajzol\u00f3-, jel\u00f6l\u0151-, vagy matematikai sz\u00e1mol\u00f3m\u0171szer \u00e9s eszk\u00f6z (pl. rajzol\u00f3g\u00e9p, pantogr\u00e1f, sz\u00f6gm\u00e9r\u0151, rajzol\u00f3k\u00e9szlet, logarl\u00e9c, logart\u00e1rcsa); ebbe az\u0026nbsp;\u00e1rucsoportba m\u00e1s vtsz. al\u00e1 nem besorolhat\u00f3 k\u00e9zi hossz\u00fas\u00e1gm\u00e9r\u0151 eszk\u00f6z (pl.\u0026nbsp;m\u00e9r\u0151r\u00fad \u00e9s -szalag, mikrom\u00e9ter,\u0026nbsp;k\u00f6rz\u0151)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERajzasztal \u00e9s rajzg\u00e9p, automata is (9017\u0026nbsp;10), M\u00e1s\u0026nbsp;rajzol\u00f3-, jel\u00f6l\u0151- vagy matematikai sz\u00e1mol\u00f3m\u0171szer \u00e9s eszk\u00f6z (9017\u0026nbsp;20),\u0026nbsp;Mikrom\u00e9ter, k\u00f6rz\u0151 \u00e9s tol\u00f3m\u00e9rce (9017\u0026nbsp;30), Alkatr\u00e9sz\u0026nbsp;\u00e9s tartoz\u00e9k (9017\u0026nbsp;90)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E16\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00cdr\u00f3szerek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E96\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9608\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGoly\u00f3stoll, filc- \u00e9s m\u00e1s, szivacsv\u00e9g\u0171 toll \u00e9s jelz\u0151; t\u00f6lt\u0151toll, rajzol\u00f3toll \u00e9s m\u00e1s toll; m\u00e1sol\u00f3 t\u00f6lt\u0151toll (\u00e1t\u00edr\u00f3toll); t\u00f6lt\u0151ceruza vagy cs\u00fasz\u00f3bet\u00e9tes ceruza; tollsz\u00e1r, ceruzahosszabb\u00edt\u00f3 \u00e9s hasonl\u00f3; mindezek alkatr\u00e9szei (bele\u00e9rtve a\u0026nbsp;kupakot \u00e9s a\u0026nbsp;klipszet is), a\u0026nbsp;9609\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 \u00e1ru kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EGoly\u00f3stoll (9608 10), Filc- \u00e9s m\u00e1s, szivacsv\u00e9g\u0171 toll \u00e9s jelz\u0151 (9608 20), T\u00f6lt\u0151toll, rajzol\u00f3toll \u00e9s m\u00e1s toll (9608\u0026nbsp;30), T\u00f6lt\u0151ceruza vagy cs\u00fasz\u00f3bet\u00e9tes ceruza (9608\u0026nbsp;40), El\u0151bbi alsz\u00e1mok al\u00e1 tartoz\u00f3 \u00e1rukb\u00f3l kett\u0151 vagy t\u00f6bb, k\u00e9szletben (9608 50), Goly\u00f3stollbet\u00e9t, amely goly\u00f3shegyb\u0151l \u00e9s tintatart\u00e1lyb\u00f3l \u00e1ll (9608\u0026nbsp;60)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E17\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00cdr\u00f3szerek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E96\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9609\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ECeruza (a 9608\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 kiv\u00e9tel\u00e9vel), rajzkr\u00e9ta, ceruzab\u00e9l, pasztellkr\u00e9ta, rajzsz\u00e9n, \u00edr\u00f3- vagy rajzkr\u00e9ta \u00e9s szab\u00f3kr\u00e9ta\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ECeruza \u00e9s rajzkr\u00e9ta h\u00fcvelybe \u00e1gyazott b\u00e9llel (9609\u0026nbsp;10), Ceruzab\u00e9l, fekete vagy sz\u00ednes (9609\u0026nbsp;20)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E18\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00cdr\u00f3szerek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E96\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9610\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EPalat\u00e1bla \u00e9s t\u00e1bla, \u00edr\u00f3- vagy rajzt\u00e1bla, kerettel is\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E19\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9sek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E39\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E392610\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u0171anyagb\u00f3l k\u00e9sz\u00fclt hivatali vagy iskolai felszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EM\u0171anyagb\u00f3l k\u00e9sz\u00fclt hivatali vagy iskolai felszerel\u00e9s\u0026nbsp;\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u2013\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E20\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EIskolafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ETornafelszerel\u00e9s\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E95\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E9506\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E\u00c1ltal\u00e1nos fizikai gyakorlatokhoz, torn\u00e1hoz, atl\u00e9tik\u00e1hoz, m\u00e1s sporthoz (bele\u00e9rtve az\u0026nbsp;asztaliteniszt is) vagy szabadt\u00e9ri j\u00e1t\u00e9khoz val\u00f3, ebben az\u0026nbsp;\u00e1rucsoportban m\u00e1shol nem eml\u00edtett cikk \u00e9s felszerel\u00e9s; \u00fasz\u00f3medence \u00e9s pancsol\u00f3medence\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ELabda, a\u0026nbsp;golflabda \u00e9s az\u0026nbsp;asztalitenisz-labda kiv\u00e9tel\u00e9vel (9506 61), Tornatermi, atl\u00e9tikai, valamint \u00e1ltal\u00e1nos fizikai gyakorlathoz haszn\u00e1lt felszerel\u00e9s (9506 91)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ES\u00edtalp \u00e9s m\u00e1s s\u00edfelszerel\u00e9s (9506\u0026nbsp;11), V\u00edzis\u00edtalp, hull\u00e1mlovas-, sz\u00e9llovas- \u00e9s m\u00e1s v\u00edzisport-felszerel\u00e9s (9506\u0026nbsp;21), Golf\u00fct\u0151 \u00e9s m\u00e1s golffelszerel\u00e9s (9506\u0026nbsp;31), Asztalitenisz-felszerel\u00e9s (9506 40), Tenisz-, tollaslabda- vagy hasonl\u00f3 \u00fct\u0151, h\u00farral ell\u00e1tva is (9506\u0026nbsp;51), J\u00e9gkorcsolya \u00e9s g\u00f6rkorcsolya, bele\u00e9rtve a korcsoly\u00e1val felszerelt cip\u0151t is (9506\u0026nbsp;70)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E21\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd rowspan=\u002216\u0022\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003ERuh\u00e1zati cikkek\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd rowspan=\u002216\u0022\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EK\u00f6t\u00f6tt ruh\u00e1k\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd rowspan=\u002216\u0022\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E61\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6101\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fafels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k (bele\u00e9rtve a\u0026nbsp;s\u00edzubbonyt is), -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l, a\u0026nbsp;6103\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 \u00e1ruk\u0026nbsp;kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fafels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k, -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l, a\u0026nbsp;6103\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 \u00e1ruk kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Es\u00edzubbony\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E22\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6102\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nyka-fels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k (bele\u00e9rtve a\u0026nbsp;s\u00edzubbonyt is), -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l, a\u0026nbsp;6104\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 \u00e1ruk kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nyka-fels\u0151kab\u00e1t, -aut\u00f3skab\u00e1t, -pelerin, -k\u00f6peny, -anor\u00e1k, -viharkab\u00e1t, -sz\u00e9ldzseki \u00e9s hasonl\u00f3 \u00e1ruk k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l, a\u0026nbsp;6104\u0026nbsp;vtsz. al\u00e1 tartoz\u00f3 \u00e1ruk kiv\u00e9tel\u00e9vel\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Es\u00edzubbony\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E23\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6103\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fa\u00f6lt\u00f6ny, -ruhaegy\u00fcttes, -zak\u00f3, -bl\u00e9zer, -hossz\u00fanadr\u00e1g, v\u00e1llp\u00e1ntos \u00e9s melles munkanadr\u00e1g (overall), -bricsesznadr\u00e1g \u00e9s -sortnadr\u00e1g (a f\u00fcrd\u0151ruha kiv\u00e9tel\u00e9vel) k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EF\u00e9rfi- vagy fi\u00fa\u00f6lt\u00f6ny, -ruhaegy\u00fcttes, -zak\u00f3, -bl\u00e9zer, -hossz\u00fanadr\u00e1g, -bricsesznadr\u00e1g \u00e9s -sortnadr\u00e1g (a f\u00fcrd\u0151ruha kiv\u00e9tel\u00e9vel) k\u00f6t\u00f6tt vagy hurkolt anyagb\u00f3l\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003Ev\u00e1llp\u00e1ntos \u00e9s melles munkanadr\u00e1g (overall)\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003C\/tr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E24\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003E6104\u003C\/span\u003E\u003C\/p\u003E\n\u003C\/td\u003E\n\u003Ctd\u003E\n\u003Cp class=\u0022text-align-center\u0022\u003E\u003Cspan\u003EN\u0151i vagy le\u00e1nykakoszt\u00fcm, -ruhaegy\u00fcttes, -ujjas, -bl\u00e9zer, -ruha, -szoknya, -nadr\u00e1gszoknya, 