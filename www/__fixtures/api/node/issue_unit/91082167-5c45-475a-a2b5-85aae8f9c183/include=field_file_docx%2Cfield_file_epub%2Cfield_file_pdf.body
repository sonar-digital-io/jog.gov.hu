{"jsonapi":{"version":"1.1","meta":{"links":{"self":{"href":"http:\/\/jsonapi.org\/format\/1.1\/"}}}},"data":{"type":"node--issue_unit","id":"91082167-5c45-475a-a2b5-85aae8f9c183","links":{"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183?resourceVersion=id%3A218006"}},"attributes":{"drupal_internal__nid":94904,"drupal_internal__vid":218006,"langcode":"hu","revision_timestamp":"2026-10-02T10:26:02+00:00","status":true,"title":"A \u201ePumi\u201d r\u00e9z\u00f6tv\u00f6zet\u0171 eml\u00e9k\u00e9rme kibocs\u00e1t\u00e1s\u00e1r\u00f3l","created":"2026-10-02T09:37:57+00:00","changed":"2026-10-02T10:34:45+00:00","promote":false,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":"published","path":{"alias":"\/pumi-rezotvozetu-emlekerme-kibocsatasarol","pid":19562,"langcode":"hu"},"content_translation_source":"und","content_translation_outdated":false,"api_endpoint_url":[{"uri":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183","title":"91082167-5c45-475a-a2b5-85aae8f9c183","options":[]},{"uri":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit","title":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit","options":[]}],"body":{"value":"\u003Cp\u003E[1]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;Magyar Nemzeti Bank \u2013 p\u00e9nzkibocs\u00e1t\u00e1si jogk\u00f6r\u00e9ben elj\u00e1rva \u2013 rendszeresen bocs\u00e1t ki eml\u00e9k\u00e9rm\u00e9ket, amelyeknek els\u0151dleges szerepe nem a\u0026nbsp;k\u00e9szp\u00e9nzben teljes\u00edtend\u0151 fizet\u00e9sekhez t\u00f6rt\u00e9n\u0151 felhaszn\u00e1l\u00e1s, hanem t\u00f6rt\u00e9nelmi \u00e9s kultur\u00e1lis \u00e9rt\u00e9kek k\u00f6zvet\u00edt\u00e9se, a\u0026nbsp;k\u00f6zfigyelem ezen \u00e9rt\u00e9kekre val\u00f3 r\u00e1ir\u00e1ny\u00edt\u00e1sa, ismeretterjeszt\u00e9s \u00e9s a\u0026nbsp;rajtuk meg\u00f6r\u00f6k\u00edtett szem\u00e9lyr\u0151l, esem\u00e9nyr\u0151l, kiemelked\u0151 \u00e9vfordul\u00f3r\u00f3l val\u00f3 megeml\u00e9kez\u00e9s, tisztelg\u00e9s.\u003C\/p\u003E\u003Cp\u003E[2]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EE\u0026nbsp;rendelet c\u00e9lja a\u0026nbsp;\u201ePumi\u201d r\u00e9z\u00f6tv\u00f6zet\u0171 eml\u00e9k\u00e9rme kibocs\u00e1t\u00e1sa, a\u0026nbsp;magyar p\u00e1sztor- \u00e9s vad\u00e1szkutyafajt\u00e1kat bemutat\u00f3 eml\u00e9k\u00e9rme-sorozat folytat\u00e1sak\u00e9nt.\u003C\/p\u003E\u003Cp\u003E[3]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;Magyar Nemzeti Bankr\u00f3l sz\u00f3l\u00f3 2013.\u0026nbsp;\u00e9vi CXXXIX.\u0026nbsp;t\u00f6rv\u00e9ny 171.\u0026nbsp;\u00a7 (1)\u0026nbsp;bekezd\u00e9s d)\u0026nbsp;pontj\u00e1ban kapott felhatalmaz\u00e1s alapj\u00e1n, a\u0026nbsp;Magyar Nemzeti Bankr\u00f3l sz\u00f3l\u00f3 2013.\u0026nbsp;\u00e9vi CXXXIX.\u0026nbsp;t\u00f6rv\u00e9ny 4.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s\u00e9ben meghat\u00e1rozott feladatk\u00f6r\u00f6mben elj\u00e1rva a\u0026nbsp;k\u00f6vetkez\u0151ket rendelem el:\u003C\/p\u003E\u003Cp\u003E1.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA Magyar Nemzeti Bank \u201ePumi\u201d megnevez\u00e9ssel 5000\u0026nbsp;forintos\u0026nbsp;c\u00edmlet\u0171 r\u00e9z\u00f6tv\u00f6zet\u0171 eml\u00e9k\u00e9rm\u00e9t bocs\u00e1t ki.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA kibocs\u00e1t\u00e1s id\u0151pontja: 2026. okt\u00f3ber 4.\u003C\/p\u003E\u003Cp\u003E2.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz eml\u00e9k\u00e9rme 75% r\u00e9z, 4% nikkel \u00e9s 21% cink \u00f6tv\u00f6zet\u00e9b\u0151l k\u00e9sz\u00fclt, s\u00falya 16 gramm, \u00e1tm\u00e9r\u0151je 34\u0026nbsp;mm, sz\u00e9le rec\u00e9zett.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz eml\u00e9k\u00e9rme el\u0151lapj\u00e1n egy pumi f\u00e9lalakos \u00e1br\u00e1zol\u00e1sa l\u00e1that\u00f3. Az\u0026nbsp;el\u0151lap sz\u00e9l\u00e9n, fent, k\u00f6riratban a\u0026nbsp;\u201eMAGYARORSZ\u00c1G\u201d felirat, a\u0026nbsp;pumi \u00e1br\u00e1zol\u00e1s\u00e1t\u00f3l jobbra, n\u00e9gy egym\u00e1s alatti v\u00edzszintes sorban az\u0026nbsp;\u201e5000\u201d \u00e9rt\u00e9kjelz\u00e9s, a\u0026nbsp;\u201eFORINT\u201d felirat, a\u0026nbsp;\u201e2026\u201d ver\u00e9si \u00e9vsz\u00e1m \u00e9s a\u0026nbsp;\u201eBP.\u201d verdejel olvashat\u00f3. Az\u0026nbsp;eml\u00e9k\u00e9rme el\u0151lapj\u00e1nak k\u00e9p\u00e9t az\u0026nbsp;1.\u0026nbsp;mell\u00e9klet tartalmazza.\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(3)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz eml\u00e9k\u00e9rme h\u00e1tlapj\u00e1n egy \u00e1ll\u00f3 \u00e9s egy rackajuhny\u00e1jat terel\u0151 pumi eg\u00e9sz alakos \u00e1br\u00e1zol\u00e1sa l\u00e1that\u00f3, f\u00fcves pusztai k\u00f6rnyezetben. A\u0026nbsp;h\u00e1tlap sz\u00e9l\u00e9n, fent, v\u00edzszintesen a\u0026nbsp;\u201ePUMI\u201d felirat olvashat\u00f3, az\u0026nbsp;\u00e1ll\u00f3 pumi \u00e1br\u00e1zol\u00e1s\u00e1t\u00f3l jobbra, lent \u2013 a\u0026nbsp;f\u00fcves puszta \u00e1br\u00e1zol\u00e1s\u00e1ba illesztve \u2013 Imrei Bogl\u00e1rka tervez\u0151m\u0171v\u00e9sz mesterjegye l\u00e1that\u00f3. Az\u0026nbsp;eml\u00e9k\u00e9rme h\u00e1tlapj\u00e1nak k\u00e9p\u00e9t a\u0026nbsp;2.\u0026nbsp;mell\u00e9klet tartalmazza.\u003C\/p\u003E\u003Cp\u003E3.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EAz eml\u00e9k\u00e9rm\u00e9b\u0151l 20 000 darab k\u00e9sz\u00edthet\u0151, k\u00fcl\u00f6nleges \u2013 \u00fan. proof-like \u2013 technol\u00f3gi\u00e1val.\u003C\/p\u003E\u003Cp\u003E4.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EEz a\u0026nbsp;rendelet 2026. okt\u00f3ber 4-\u00e9n l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E1.\u0026nbsp;mell\u00e9klet a\u0026nbsp;34\/2026. (X. 1.) MNB rendelethez\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003EAz eml\u00e9k\u00e9rme el\u0151lapj\u00e1nak k\u00e9pe:\u003C\/p\u003E\u003Cimg data-entity-uuid=\u0022251b80e9-8144-4805-906c-d24d9effc77e\u0022 data-entity-type=\u0022file\u0022 src=\u0022\/files\/inline-images\/764f6f9992_3_1_pumi1.jpg\u0022 width=\u0022711\u0022 height=\u0022702\u0022\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E2.\u0026nbsp;mell\u00e9klet a\u0026nbsp;34\/2026. (X. 1.) MNB rendelethez\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003EAz eml\u00e9k\u00e9rme h\u00e1tlapj\u00e1nak k\u00e9pe:\u003C\/p\u003E\u003Cimg data-entity-uuid=\u0022f27e0507-9802-40e1-b2b9-05de3c5fd238\u0022 data-entity-type=\u0022file\u0022 src=\u0022\/files\/inline-images\/45af0d4019_3_2_pumi2.jpg\u0022 width=\u0022755\u0022 height=\u0022693\u0022\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E","format":"full_html","processed":"\u003Cp\u003E[1]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;Magyar Nemzeti Bank \u2013 p\u00e9nzkibocs\u00e1t\u00e1si jogk\u00f6r\u00e9ben elj\u00e1rva \u2013 rendszeresen bocs\u00e1t ki eml\u00e9k\u00e9rm\u00e9ket, amelyeknek els\u0151dleges szerepe nem a\u0026nbsp;k\u00e9szp\u00e9nzben teljes\u00edtend\u0151 fizet\u00e9sekhez t\u00f6rt\u00e9n\u0151 felhaszn\u00e1l\u00e1s, hanem t\u00f6rt\u00e9nelmi \u00e9s kultur\u00e1lis \u00e9rt\u00e9kek k\u00f6zvet\u00edt\u00e9se, a\u0026nbsp;k\u00f6zfigyelem ezen \u00e9rt\u00e9kekre val\u00f3 r\u00e1ir\u00e1ny\u00edt\u00e1sa, ismeretterjeszt\u00e9s \u00e9s a\u0026nbsp;rajtuk meg\u00f6r\u00f6k\u00edtett szem\u00e9lyr\u0151l, esem\u00e9nyr\u0151l, kiemelked\u0151 \u00e9vfordul\u00f3r\u00f3l val\u00f3 megeml\u00e9kez\u00e9s, tisztelg\u00e9s.\u003C\/p\u003E\n\u003Cp\u003E[2]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EE\u0026nbsp;rendelet c\u00e9lja a\u0026nbsp;\u201ePumi\u201d r\u00e9z\u00f6tv\u00f6zet\u0171 eml\u00e9k\u00e9rme kibocs\u00e1t\u00e1sa, a\u0026nbsp;magyar p\u00e1sztor- \u00e9s vad\u00e1szkutyafajt\u00e1kat bemutat\u00f3 eml\u00e9k\u00e9rme-sorozat folytat\u00e1sak\u00e9nt.\u003C\/p\u003E\n\u003Cp\u003E[3]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;Magyar Nemzeti Bankr\u00f3l sz\u00f3l\u00f3 2013.\u0026nbsp;\u00e9vi CXXXIX.\u0026nbsp;t\u00f6rv\u00e9ny 171.\u0026nbsp;\u00a7 (1)\u0026nbsp;bekezd\u00e9s d)\u0026nbsp;pontj\u00e1ban kapott felhatalmaz\u00e1s alapj\u00e1n, a\u0026nbsp;Magyar Nemzeti Bankr\u00f3l sz\u00f3l\u00f3 2013.\u0026nbsp;\u00e9vi CXXXIX.\u0026nbsp;t\u00f6rv\u00e9ny 4.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s\u00e9ben meghat\u00e1rozott feladatk\u00f6r\u00f6mben elj\u00e1rva a\u0026nbsp;k\u00f6vetkez\u0151ket rendelem el:\u003C\/p\u003E\n\u003Cp\u003E1.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA Magyar Nemzeti Bank \u201ePumi\u201d megnevez\u00e9ssel 5000\u0026nbsp;forintos\u0026nbsp;c\u00edmlet\u0171 r\u00e9z\u00f6tv\u00f6zet\u0171 eml\u00e9k\u00e9rm\u00e9t bocs\u00e1t ki.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EA kibocs\u00e1t\u00e1s id\u0151pontja: 2026. okt\u00f3ber 4.\u003C\/p\u003E\n\u003Cp\u003E2.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(1)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz eml\u00e9k\u00e9rme 75% r\u00e9z, 4% nikkel \u00e9s 21% cink \u00f6tv\u00f6zet\u00e9b\u0151l k\u00e9sz\u00fclt, s\u00falya 16 gramm, \u00e1tm\u00e9r\u0151je 34\u0026nbsp;mm, sz\u00e9le rec\u00e9zett.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(2)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz eml\u00e9k\u00e9rme el\u0151lapj\u00e1n egy pumi f\u00e9lalakos \u00e1br\u00e1zol\u00e1sa l\u00e1that\u00f3. Az\u0026nbsp;el\u0151lap sz\u00e9l\u00e9n, fent, k\u00f6riratban a\u0026nbsp;\u201eMAGYARORSZ\u00c1G\u201d felirat, a\u0026nbsp;pumi \u00e1br\u00e1zol\u00e1s\u00e1t\u00f3l jobbra, n\u00e9gy egym\u00e1s alatti v\u00edzszintes sorban az\u0026nbsp;\u201e5000\u201d \u00e9rt\u00e9kjelz\u00e9s, a\u0026nbsp;\u201eFORINT\u201d felirat, a\u0026nbsp;\u201e2026\u201d ver\u00e9si \u00e9vsz\u00e1m \u00e9s a\u0026nbsp;\u201eBP.\u201d verdejel olvashat\u00f3. Az\u0026nbsp;eml\u00e9k\u00e9rme el\u0151lapj\u00e1nak k\u00e9p\u00e9t az\u0026nbsp;1.\u0026nbsp;mell\u00e9klet tartalmazza.\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003E(3)\u003Cspan\u003E\u0026nbsp; \u003C\/span\u003EAz eml\u00e9k\u00e9rme h\u00e1tlapj\u00e1n egy \u00e1ll\u00f3 \u00e9s egy rackajuhny\u00e1jat terel\u0151 pumi eg\u00e9sz alakos \u00e1br\u00e1zol\u00e1sa l\u00e1that\u00f3, f\u00fcves pusztai k\u00f6rnyezetben. A\u0026nbsp;h\u00e1tlap sz\u00e9l\u00e9n, fent, v\u00edzszintesen a\u0026nbsp;\u201ePUMI\u201d felirat olvashat\u00f3, az\u0026nbsp;\u00e1ll\u00f3 pumi \u00e1br\u00e1zol\u00e1s\u00e1t\u00f3l jobbra, lent \u2013 a\u0026nbsp;f\u00fcves puszta \u00e1br\u00e1zol\u00e1s\u00e1ba illesztve \u2013 Imrei Bogl\u00e1rka tervez\u0151m\u0171v\u00e9sz mesterjegye l\u00e1that\u00f3. Az\u0026nbsp;eml\u00e9k\u00e9rme h\u00e1tlapj\u00e1nak k\u00e9p\u00e9t a\u0026nbsp;2.\u0026nbsp;mell\u00e9klet tartalmazza.\u003C\/p\u003E\n\u003Cp\u003E3.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EAz eml\u00e9k\u00e9rm\u00e9b\u0151l 20 000 darab k\u00e9sz\u00edthet\u0151, k\u00fcl\u00f6nleges \u2013 \u00fan. proof-like \u2013 technol\u00f3gi\u00e1val.\u003C\/p\u003E\n\u003Cp\u003E4.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EEz a\u0026nbsp;rendelet 2026. okt\u00f3ber 4-\u00e9n l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E1.\u0026nbsp;mell\u00e9klet a\u0026nbsp;34\/2026. (X. 1.) MNB rendelethez\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003EAz eml\u00e9k\u00e9rme el\u0151lapj\u00e1nak k\u00e9pe:\u003C\/p\u003E\n\u003Cp\u003E\u003Cimg data-entity-uuid=\u0022251b80e9-8144-4805-906c-d24d9effc77e\u0022 data-entity-type=\u0022file\u0022 src=\u0022\/files\/inline-images\/764f6f9992_3_1_pumi1.jpg\u0022 width=\u0022711\u0022 height=\u0022702\u0022 loading=\u0022lazy\u0022\u003E\n\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E2.\u0026nbsp;mell\u00e9klet a\u0026nbsp;34\/2026. (X. 1.) MNB rendelethez\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003EAz eml\u00e9k\u00e9rme h\u00e1tlapj\u00e1nak k\u00e9pe:\u003C\/p\u003E\n\u003Cp\u003E\u003Cimg data-entity-uuid=\u0022f27e0507-9802-40e1-b2b9-05de3c5fd238\u0022 data-entity-type=\u0022file\u0022 src=\u0022\/files\/inline-images\/45af0d4019_3_2_pumi2.jpg\u0022 width=\u0022755\u0022 height=\u0022693\u0022 loading=\u0022lazy\u0022\u003E\n\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n","summary":""},"field_ai_summary":{"value":"\u003Cul\u003E\n\u003Cli\u003EAz MNB rendelet c\u00e9lja a \u201ePumi\u201d nev\u0171, 5000 forintos c\u00edmlet\u0171 r\u00e9z\u00f6tv\u00f6zet\u0171 eml\u00e9k\u00e9rme kibocs\u00e1t\u00e1sa, a magyar p\u00e1sztor- \u00e9s vad\u00e1szkutyafajt\u00e1kat bemutat\u00f3 sorozat r\u00e9szek\u00e9nt.\u003C\/li\u003E\n\u003Cli\u003EA kibocs\u00e1t\u00e1s id\u0151pontja 2026. okt\u00f3ber 4.\u003C\/li\u003E\n\u003Cli\u003EAz \u00e9rme anyaga 75% r\u00e9z, 4% nikkel, 21% cink, s\u00falya 16 gramm, \u00e1tm\u00e9r\u0151je 34 mm, sz\u00e9le rec\u00e9zett.\u003C\/li\u003E\n\u003Cli\u003EAz el\u0151lapj\u00e1n egy pumi f\u00e9lalakos k\u00e9pe l\u00e1that\u00f3, valamint a \u201eMAGYARORSZ\u00c1G\u201d felirat, az \u201e5000 FORINT\u201d \u00e9rt\u00e9kjelz\u00e9s, a \u201e2026\u201d \u00e9vsz\u00e1m \u00e9s a \u201eBP.\u201d verdejel.\u003C\/li\u003E\n\u003Cli\u003EA h\u00e1tlapj\u00e1n egy \u00e1ll\u00f3 pumi \u00e9s egy rackajuhny\u00e1jat terel\u0151 pumi szerepel f\u00fcves pusztai k\u00f6rnyezetben, a \u201ePUMI\u201d felirattal \u00e9s Imrei Bogl\u00e1rka tervez\u0151m\u0171v\u00e9sz mesterjegy\u00e9vel.\u003C\/li\u003E\n\u003Cli\u003EAz eml\u00e9k\u00e9rm\u00e9b\u0151l legfeljebb 20 000 darab k\u00e9sz\u00fclhet, k\u00fcl\u00f6nleges, \u00fagynevezett proof-like technol\u00f3gi\u00e1val.\u003C\/li\u003E\n\u003Cli\u003EA rendelet 2026. okt\u00f3ber 4-\u00e9n l\u00e9p hat\u00e1lyba.\u003C\/li\u003E\n\u003C\/ul\u003E\n","format":"full_html","processed":"\u003Cul\u003E\n\u003Cli\u003EAz MNB rendelet c\u00e9lja a \u201ePumi\u201d nev\u0171, 5000 forintos c\u00edmlet\u0171 r\u00e9z\u00f6tv\u00f6zet\u0171 eml\u00e9k\u00e9rme kibocs\u00e1t\u00e1sa, a magyar p\u00e1sztor- \u00e9s vad\u00e1szkutyafajt\u00e1kat bemutat\u00f3 sorozat r\u00e9szek\u00e9nt.\u003C\/li\u003E\n\u003Cli\u003EA kibocs\u00e1t\u00e1s id\u0151pontja 2026. okt\u00f3ber 4.\u003C\/li\u003E\n\u003Cli\u003EAz \u00e9rme anyaga 75% r\u00e9z, 4% nikkel, 21% cink, s\u00falya 16 gramm, \u00e1tm\u00e9r\u0151je 34 mm, sz\u00e9le rec\u00e9zett.\u003C\/li\u003E\n\u003Cli\u003EAz el\u0151lapj\u00e1n egy pumi f\u00e9lalakos k\u00e9pe l\u00e1that\u00f3, valamint a \u201eMAGYARORSZ\u00c1G\u201d felirat, az \u201e5000 FORINT\u201d \u00e9rt\u00e9kjelz\u00e9s, a \u201e2026\u201d \u00e9vsz\u00e1m \u00e9s a \u201eBP.\u201d verdejel.\u003C\/li\u003E\n\u003Cli\u003EA h\u00e1tlapj\u00e1n egy \u00e1ll\u00f3 pumi \u00e9s egy rackajuhny\u00e1jat terel\u0151 pumi szerepel f\u00fcves pusztai k\u00f6rnyezetben, a \u201ePUMI\u201d felirattal \u00e9s Imrei Bogl\u00e1rka tervez\u0151m\u0171v\u00e9sz mesterjegy\u00e9vel.\u003C\/li\u003E\n\u003Cli\u003EAz eml\u00e9k\u00e9rm\u00e9b\u0151l legfeljebb 20 000 darab k\u00e9sz\u00fclhet, k\u00fcl\u00f6nleges, \u00fagynevezett proof-like technol\u00f3gi\u00e1val.\u003C\/li\u003E\n\u003Cli\u003EA rendelet 2026. okt\u00f3ber 4-\u00e9n l\u00e9p hat\u00e1lyba.\u003C\/li\u003E\n\u003C\/ul\u003E\n"},"field_correction":false,"field_njt_url":null,"field_page_number":3,"field_regulation_number":"34\/2026. (X. 1.) MNB rendelet","field_regulation_title":"A \u201ePumi\u201d r\u00e9z\u00f6tv\u00f6zet\u0171 eml\u00e9k\u00e9rme kibocs\u00e1t\u00e1s\u00e1r\u00f3l","field_synonym":"kereset\np\u00e9nz\nk\u00e9szp\u00e9nz\nrecept\neb\napr\u00f3p\u00e9nz"},"relationships":{"node_type":{"data":{"type":"node_type--node_type","id":"2de4f0c4-1ed1-4766-9521-6ae4441af5d5","meta":{"drupal_internal__target_id":"issue_unit"}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/node_type?resourceVersion=id%3A218006"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/relationships\/node_type?resourceVersion=id%3A218006"}}},"revision_uid":{"data":{"type":"user--user","id":"88687bb7-61de-4013-a5bd-0bddeed53e90","meta":{"drupal_internal__target_id":38}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/revision_uid?resourceVersion=id%3A218006"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/relationships\/revision_uid?resourceVersion=id%3A218006"}}},"uid":{"data":{"type":"user--user","id":"92b0ac2c-ebb9-43b5-a02d-d1306c70a5dd","meta":{"drupal_internal__target_id":39}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/uid?resourceVersion=id%3A218006"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/relationships\/uid?resourceVersion=id%3A218006"}}},"field_file_docx":{"data":null,"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/field_file_docx?resourceVersion=id%3A218006"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/relationships\/field_file_docx?resourceVersion=id%3A218006"}}},"field_file_epub":{"data":null,"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/field_file_epub?resourceVersion=id%3A218006"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/relationships\/field_file_epub?resourceVersion=id%3A218006"}}},"field_file_pdf":{"data":null,"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/field_file_pdf?resourceVersion=id%3A218006"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/relationships\/field_file_pdf?resourceVersion=id%3A218006"}}},"field_parent_issue_ref":{"data":{"type":"node--issue","id":"c8cf8e1f-f202-4a17-8503-0a5940e908bb","meta":{"drupal_internal__target_id":94895}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/field_parent_issue_ref?resourceVersion=id%3A218006"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183\/relationships\/field_parent_issue_ref?resourceVersion=id%3A218006"}}}}},"links":{"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/91082167-5c45-475a-a2b5-85aae8f9c183?include=field_file_docx%2Cfield_file_epub%2Cfield_file_pdf\u0026ip_group=external"}}}