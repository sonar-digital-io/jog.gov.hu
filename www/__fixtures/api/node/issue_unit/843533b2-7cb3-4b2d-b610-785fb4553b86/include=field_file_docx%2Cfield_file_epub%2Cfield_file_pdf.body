{"jsonapi":{"version":"1.1","meta":{"links":{"self":{"href":"http:\/\/jsonapi.org\/format\/1.1\/"}}}},"data":{"type":"node--issue_unit","id":"843533b2-7cb3-4b2d-b610-785fb4553b86","links":{"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/843533b2-7cb3-4b2d-b610-785fb4553b86?resourceVersion=id%3A218007"}},"attributes":{"drupal_internal__nid":94903,"drupal_internal__vid":218007,"langcode":"hu","revision_timestamp":"2026-10-02T10:24:04+00:00","status":true,"title":"A tudom\u00e1nyos \u00e9s technol\u00f3giai miniszter feladat- \u00e9s hat\u00e1sk\u00f6r\u00e9vel \u00f6sszef\u00fcgg\u0151 egyes korm\u00e1nyrendeletek m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l","created":"2026-10-02T09:33:24+00:00","changed":"2026-10-02T10:34:45+00:00","promote":false,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"moderation_state":"published","path":{"alias":"\/tudomanyos-es-technologiai-miniszter-feladat-es-hataskorevel-osszefuggo-egyes-kormanyrendeletek","pid":19560,"langcode":"hu"},"content_translation_source":"und","content_translation_outdated":false,"api_endpoint_url":[{"uri":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/843533b2-7cb3-4b2d-b610-785fb4553b86","title":"843533b2-7cb3-4b2d-b610-785fb4553b86","options":[]},{"uri":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit","title":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit","options":[]}],"body":{"value":"\u003Cp\u003E[1]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;Korm\u00e1ny tagjainak feladat- \u00e9s hat\u00e1sk\u00f6r\u00e9r\u0151l sz\u00f3l\u00f3 90\/2026.\u0026nbsp;(V. 13.) Korm.\u0026nbsp;rendelet 2026. szeptember 1-jei hat\u00e1lybal\u00e9p\u00e9s\u00e9vel bek\u00f6vetkezett hat\u00e1sk\u00f6ri v\u00e1ltoz\u00e1sra tekintettel sz\u00fcks\u00e9gess\u00e9 v\u00e1lt a\u0026nbsp;tudom\u00e1nyos \u00e9s technol\u00f3giai miniszter feladat- \u00e9s hat\u00e1sk\u00f6r\u00e9be tartoz\u00f3 egyes korm\u00e1nyrendeletek m\u00f3dos\u00edt\u00e1sa.\u003C\/p\u003E\u003Cp\u003E[2]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;Korm\u00e1ny\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea magyar \u00e9p\u00edt\u00e9szetr\u0151l sz\u00f3l\u00f3 2023.\u0026nbsp;\u00e9vi C.\u0026nbsp;t\u00f6rv\u00e9ny 225.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s a)\u0026nbsp;pontj\u00e1ban kapott felhatalmaz\u00e1s alapj\u00e1n,\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea 2.\u0026nbsp;alc\u00edm tekintet\u00e9ben a\u0026nbsp;Nemzeti H\u00edrk\u00f6zl\u00e9si \u00e9s Informatikai Tan\u00e1csr\u00f3l sz\u00f3l\u00f3 2018.\u0026nbsp;\u00e9vi CII.\u0026nbsp;t\u00f6rv\u00e9ny 2.\u0026nbsp;\u00a7 (3)\u0026nbsp;bekezd\u00e9s\u00e9ben kapott felhatalmaz\u00e1s alapj\u00e1n,\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea 3.\u0026nbsp;alc\u00edm tekintet\u00e9ben a\u0026nbsp;Magyarorsz\u00e1g 2023.\u0026nbsp;\u00e9vi k\u00f6zponti k\u00f6lts\u00e9gvet\u00e9s\u00e9nek megalapoz\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2022.\u0026nbsp;\u00e9vi XXIV.\u0026nbsp;t\u00f6rv\u00e9ny 252.\u0026nbsp;\u00a7 a) \u00e9s b)\u0026nbsp;pontj\u00e1ban kapott felhatalmaz\u00e1s alapj\u00e1n,\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea 4.\u0026nbsp;alc\u00edm tekintet\u00e9ben a\u0026nbsp;korm\u00e1nyzati igazgat\u00e1sr\u00f3l sz\u00f3l\u00f3 2018.\u0026nbsp;\u00e9vi CXXV.\u0026nbsp;t\u00f6rv\u00e9ny 281.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s 2.\u0026nbsp;pontj\u00e1ban kapott felhatalmaz\u00e1s alapj\u00e1n,\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Eaz 5.\u0026nbsp;alc\u00edm tekintet\u00e9ben az\u0026nbsp;Eur\u00f3pai Uni\u00f3 mesters\u00e9ges intelligenci\u00e1r\u00f3l sz\u00f3l\u00f3 rendelet\u00e9nek magyarorsz\u00e1gi v\u00e9grehajt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2025.\u0026nbsp;\u00e9vi LXXV.\u0026nbsp;t\u00f6rv\u00e9ny 11.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s f)\u0026nbsp;pontj\u00e1ban kapott felhatalmaz\u00e1s alapj\u00e1n,\u003C\/p\u003E\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Eaz Alapt\u00f6rv\u00e9ny 15.\u0026nbsp;cikk (1)\u0026nbsp;bekezd\u00e9s\u00e9ben meghat\u00e1rozott feladatk\u00f6r\u00e9ben elj\u00e1rva a\u0026nbsp;k\u00f6vetkez\u0151ket rendeli el:\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E1. A\u0026nbsp;nagy sebess\u00e9g\u0171 mobil h\u00edrk\u00f6zl\u00e9si h\u00e1l\u00f3zatfejleszt\u00e9si beruh\u00e1z\u00e1sok megval\u00f3s\u00edt\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 k\u00f6zigazgat\u00e1si hat\u00f3s\u00e1gi \u00fcgyek nemzetgazdas\u00e1gi szempontb\u00f3l kiemelt jelent\u0151s\u00e9g\u0171 \u00fcggy\u00e9 nyilv\u00e1n\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 484\/2017.\u0026nbsp;(XII. 28.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1sa\u003C\/p\u003E\u003Cp\u003E1.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA nagy sebess\u00e9g\u0171 mobil h\u00edrk\u00f6zl\u00e9si h\u00e1l\u00f3zatfejleszt\u00e9si beruh\u00e1z\u00e1sok megval\u00f3s\u00edt\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 k\u00f6zigazgat\u00e1si hat\u00f3s\u00e1gi \u00fcgyek nemzetgazdas\u00e1gi szempontb\u00f3l kiemelt jelent\u0151s\u00e9g\u0171 \u00fcggy\u00e9 nyilv\u00e1n\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3\u0026nbsp;\u003Cbr\u003E484\/2017.\u0026nbsp;(XII. 28.) Korm.\u0026nbsp;rendelet 1\/A.\u0026nbsp;\u00a7-\u00e1ban az\u0026nbsp;\u201eaz Energia\u00fcgyi Miniszt\u00e9rium\u201d sz\u00f6vegr\u00e9sz hely\u00e9be az\u0026nbsp;\u201ea\u201d sz\u00f6veg l\u00e9p.\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E2. A\u0026nbsp;Nemzeti H\u00edrk\u00f6zl\u00e9si \u00e9s Informatikai Tan\u00e1csr\u00f3l, valamint a\u0026nbsp;Digit\u00e1lis Korm\u00e1nyzati \u00dcgyn\u00f6ks\u00e9g Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g \u00e9s a\u0026nbsp;korm\u00e1nyzati informatikai beszerz\u00e9sek k\u00f6zpontos\u00edtott k\u00f6zbeszerz\u00e9si rendszer\u00e9r\u0151l sz\u00f3l\u00f3 301\/2018.\u0026nbsp;(XII. 27.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1sa\u003C\/p\u003E\u003Cp\u003E2.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA Nemzeti H\u00edrk\u00f6zl\u00e9si \u00e9s Informatikai Tan\u00e1csr\u00f3l, valamint a\u0026nbsp;Digit\u00e1lis Korm\u00e1nyzati \u00dcgyn\u00f6ks\u00e9g Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g \u00e9s a\u0026nbsp;korm\u00e1nyzati informatikai beszerz\u00e9sek k\u00f6zpontos\u00edtott k\u00f6zbeszerz\u00e9si rendszer\u00e9r\u0151l sz\u00f3l\u00f3 301\/2018.\u0026nbsp;(XII. 27.) Korm.\u0026nbsp;rendelet 15.\u0026nbsp;\u00a7 (5)\u0026nbsp;bekezd\u00e9se hely\u00e9be a\u0026nbsp;k\u00f6vetkez\u0151 rendelkez\u00e9s l\u00e9p:\u003C\/p\u003E\u003Cp\u003E\u201e(5) Az\u0026nbsp;NHIT tev\u00e9kenys\u00e9g\u00e9nek t\u00e1mogat\u00e1s\u00e1ra a\u0026nbsp;Korm\u00e1ny az\u0026nbsp;e-k\u00f6zigazgat\u00e1si \u00e9s informatikai fejleszt\u00e9sek egys\u00e9ges\u00edt\u00e9s\u00e9\u00e9rt felel\u0151s miniszter \u00e1ltal vezetett miniszt\u00e9riumot jel\u00f6li ki.\u201d\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E3. A\u0026nbsp;Digit\u00e1lis Magyarorsz\u00e1g \u00dcgyn\u00f6ks\u00e9g Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g kijel\u00f6l\u00e9s\u00e9r\u0151l \u00e9s egyes feladatainak meghat\u00e1roz\u00e1s\u00e1r\u00f3l, valamint a\u0026nbsp;nemzeti informatikai \u00e9s e-k\u00f6zigazgat\u00e1si tev\u00e9kenys\u00e9g \u00f6sszehangolt biztos\u00edt\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 r\u00e9szletszab\u00e1lyokr\u00f3l sz\u00f3l\u00f3 307\/2022.\u0026nbsp;(VIII. 11.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1sa\u003C\/p\u003E\u003Cp\u003E3.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA Digit\u00e1lis Magyarorsz\u00e1g \u00dcgyn\u00f6ks\u00e9g Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g kijel\u00f6l\u00e9s\u00e9r\u0151l \u00e9s egyes feladatainak meghat\u00e1roz\u00e1s\u00e1r\u00f3l, valamint a\u0026nbsp;nemzeti informatikai \u00e9s e-k\u00f6zigazgat\u00e1si tev\u00e9kenys\u00e9g \u00f6sszehangolt biztos\u00edt\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 r\u00e9szletszab\u00e1lyokr\u00f3l sz\u00f3l\u00f3 307\/2022.\u0026nbsp;(VIII. 11.) Korm.\u0026nbsp;rendelet (a\u0026nbsp;tov\u00e1bbiakban: R1.) 2.\u0026nbsp;\u00a7-a hely\u00e9be a\u0026nbsp;k\u00f6vetkez\u0151 rendelkez\u00e9s l\u00e9p:\u003C\/p\u003E\u003Cp\u003E\u201e2.\u0026nbsp;\u00a7 Az e-k\u00f6zigazgat\u00e1ssal, az\u0026nbsp;informatik\u00e1val, az\u0026nbsp;e-k\u00f6zigazgat\u00e1si \u00e9s informatikai fejleszt\u00e9sek egys\u00e9ges\u00edt\u00e9s\u00e9vel, a\u0026nbsp;korm\u00e1nyzati c\u00e9l\u00fa elektronikus h\u00edrk\u00f6zl\u00e9si tev\u00e9kenys\u00e9ggel, valamint a\u0026nbsp;k\u00f6zigazgat\u00e1si informatika infrastruktur\u00e1lis megval\u00f3s\u00edthat\u00f3s\u00e1g\u00e1nak biztos\u00edt\u00e1s\u00e1val kapcsolatos miniszteri felel\u0151ss\u00e9gbe tartoz\u00f3 egyes \u00e1llami feladatok ell\u00e1t\u00e1s\u00e1ra a\u0026nbsp;Korm\u00e1ny a\u0026nbsp;Digit\u00e1lis Magyarorsz\u00e1g \u00dcgyn\u00f6ks\u00e9g Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1got (a\u0026nbsp;tov\u00e1bbiakban: DM\u00dc) jel\u00f6li ki.\u201d\u003C\/p\u003E\u003Cp\u003E4.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EAz R1. 4.\u0026nbsp;\u00a7-\u00e1ban a\u0026nbsp;\u201eminiszter\u201d sz\u00f6vegr\u00e9sz hely\u00e9be a\u0026nbsp;\u201efelette az\u0026nbsp;\u00e1llamot megillet\u0151 tulajdonosi jogok \u00e9s k\u00f6telezetts\u00e9gek \u00f6sszess\u00e9g\u00e9t gyakorl\u00f3 miniszter (a\u0026nbsp;tov\u00e1bbiakban: miniszter)\u201d sz\u00f6veg l\u00e9p.\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E4. A\u0026nbsp;f\u0151v\u00e1rosi \u00e9s v\u00e1rmegyei korm\u00e1nyhivatalokr\u00f3l, valamint a\u0026nbsp;j\u00e1r\u00e1si (f\u0151v\u00e1rosi ker\u00fcleti) hivatalokr\u00f3l sz\u00f3l\u00f3 568\/2022.\u0026nbsp;(XII.\u0026nbsp;23.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1sa\u003C\/p\u003E\u003Cp\u003E5.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA f\u0151v\u00e1rosi \u00e9s v\u00e1rmegyei korm\u00e1nyhivatalokr\u00f3l, valamint a\u0026nbsp;j\u00e1r\u00e1si (f\u0151v\u00e1rosi ker\u00fcleti) hivatalokr\u00f3l sz\u00f3l\u00f3 568\/2022.\u0026nbsp;(XII.\u0026nbsp;23.) Korm.\u0026nbsp;rendelet (a\u0026nbsp;tov\u00e1bbiakban: R2.) 6.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9se hely\u00e9be a\u0026nbsp;k\u00f6vetkez\u0151 rendelkez\u00e9s l\u00e9p:\u003C\/p\u003E\u003Cp\u003E\u201e(2) A\u0026nbsp;Korm\u00e1ny a\u0026nbsp;korm\u00e1nyhivatali feladatok ell\u00e1t\u00e1s\u00e1hoz sz\u00fcks\u00e9ges informatikai rendszerekre vonatkoz\u00f3an az\u0026nbsp;e-k\u00f6zigazgat\u00e1s\u00e9rt felel\u0151s minisztert jel\u00f6li ki az\u0026nbsp;informatikai rendszerekkel szembeni k\u00f6vetelm\u00e9nyek meghat\u00e1roz\u00e1s\u00e1ra, valamint a\u0026nbsp;Minisztereln\u00f6ks\u00e9g, illetve a\u0026nbsp;korm\u00e1nyhivatalok \u00e1ltal ind\u00edtott projektek keret\u00e9ben megval\u00f3sul\u00f3 informatikai alkalmaz\u00e1sfejleszt\u00e9sek ir\u00e1ny\u00edt\u00e1s\u00e1ra.\u201d\u003C\/p\u003E\u003Cp\u003E6.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EAz R2. 11.\u0026nbsp;\u00a7-a hely\u00e9be a\u0026nbsp;k\u00f6vetkez\u0151 rendelkez\u00e9s l\u00e9p:\u003C\/p\u003E\u003Cp\u003E\u201e11.\u0026nbsp;\u00a7 A miniszter a\u0026nbsp;10.\u0026nbsp;\u00a7 b)\u0026nbsp;pontja szerinti feladat\u00e1t, valamint az\u0026nbsp;e-k\u00f6zigazgat\u00e1s\u00e9rt felel\u0151s miniszter a\u0026nbsp;6.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9se szerinti feladat\u00e1t a\u0026nbsp;Lechner Tud\u00e1sk\u00f6zpont Nonprofit Korl\u00e1tolt Felel\u0151ss\u00e9g\u0171 T\u00e1rsas\u00e1g bevon\u00e1s\u00e1val l\u00e1tja\u0026nbsp;el.\u201d\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E5. Az\u0026nbsp;Eur\u00f3pai Uni\u00f3 mesters\u00e9ges intelligenci\u00e1r\u00f3l sz\u00f3l\u00f3 rendelet\u00e9nek magyarorsz\u00e1gi v\u00e9grehajt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2025.\u0026nbsp;\u00e9vi LXXV.\u0026nbsp;t\u00f6rv\u00e9ny v\u00e9grehajt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 344\/2025.\u0026nbsp;(X. 31.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1sa\u003C\/p\u003E\u003Cp\u003E7.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EHat\u00e1ly\u00e1t veszti az\u0026nbsp;Eur\u00f3pai Uni\u00f3 mesters\u00e9ges intelligenci\u00e1r\u00f3l sz\u00f3l\u00f3 rendelet\u00e9nek magyarorsz\u00e1gi v\u00e9grehajt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2025.\u0026nbsp;\u00e9vi LXXV.\u0026nbsp;t\u00f6rv\u00e9ny v\u00e9grehajt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 344\/2025.\u0026nbsp;(X. 31.) Korm.\u0026nbsp;rendelet 5.\u0026nbsp;\u00a7 (1)\u0026nbsp;bekezd\u00e9s e)\u0026nbsp;pontja.\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\u003Cp\u003E6. Z\u00e1r\u00f3 rendelkez\u00e9sek\u003C\/p\u003E\u003Cp\u003E8.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EEz a\u0026nbsp;rendelet a\u0026nbsp;kihirdet\u00e9s\u00e9t k\u00f6vet\u0151\u0026nbsp;napon l\u00e9p hat\u00e1lyba.\u003C\/p\u003E","format":"full_html","processed":"\u003Cp\u003E[1]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;Korm\u00e1ny tagjainak feladat- \u00e9s hat\u00e1sk\u00f6r\u00e9r\u0151l sz\u00f3l\u00f3 90\/2026.\u0026nbsp;(V. 13.) Korm.\u0026nbsp;rendelet 2026. szeptember 1-jei hat\u00e1lybal\u00e9p\u00e9s\u00e9vel bek\u00f6vetkezett hat\u00e1sk\u00f6ri v\u00e1ltoz\u00e1sra tekintettel sz\u00fcks\u00e9gess\u00e9 v\u00e1lt a\u0026nbsp;tudom\u00e1nyos \u00e9s technol\u00f3giai miniszter feladat- \u00e9s hat\u00e1sk\u00f6r\u00e9be tartoz\u00f3 egyes korm\u00e1nyrendeletek m\u00f3dos\u00edt\u00e1sa.\u003C\/p\u003E\n\u003Cp\u003E[2]\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA\u0026nbsp;Korm\u00e1ny\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea magyar \u00e9p\u00edt\u00e9szetr\u0151l sz\u00f3l\u00f3 2023.\u0026nbsp;\u00e9vi C.\u0026nbsp;t\u00f6rv\u00e9ny 225.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s a)\u0026nbsp;pontj\u00e1ban kapott felhatalmaz\u00e1s alapj\u00e1n,\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea 2.\u0026nbsp;alc\u00edm tekintet\u00e9ben a\u0026nbsp;Nemzeti H\u00edrk\u00f6zl\u00e9si \u00e9s Informatikai Tan\u00e1csr\u00f3l sz\u00f3l\u00f3 2018.\u0026nbsp;\u00e9vi CII.\u0026nbsp;t\u00f6rv\u00e9ny 2.\u0026nbsp;\u00a7 (3)\u0026nbsp;bekezd\u00e9s\u00e9ben kapott felhatalmaz\u00e1s alapj\u00e1n,\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea 3.\u0026nbsp;alc\u00edm tekintet\u00e9ben a\u0026nbsp;Magyarorsz\u00e1g 2023.\u0026nbsp;\u00e9vi k\u00f6zponti k\u00f6lts\u00e9gvet\u00e9s\u00e9nek megalapoz\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2022.\u0026nbsp;\u00e9vi XXIV.\u0026nbsp;t\u00f6rv\u00e9ny 252.\u0026nbsp;\u00a7 a) \u00e9s b)\u0026nbsp;pontj\u00e1ban kapott felhatalmaz\u00e1s alapj\u00e1n,\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Ea 4.\u0026nbsp;alc\u00edm tekintet\u00e9ben a\u0026nbsp;korm\u00e1nyzati igazgat\u00e1sr\u00f3l sz\u00f3l\u00f3 2018.\u0026nbsp;\u00e9vi CXXV.\u0026nbsp;t\u00f6rv\u00e9ny 281.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s 2.\u0026nbsp;pontj\u00e1ban kapott felhatalmaz\u00e1s alapj\u00e1n,\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Eaz 5.\u0026nbsp;alc\u00edm tekintet\u00e9ben az\u0026nbsp;Eur\u00f3pai Uni\u00f3 mesters\u00e9ges intelligenci\u00e1r\u00f3l sz\u00f3l\u00f3 rendelet\u00e9nek magyarorsz\u00e1gi v\u00e9grehajt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2025.\u0026nbsp;\u00e9vi LXXV.\u0026nbsp;t\u00f6rv\u00e9ny 11.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9s f)\u0026nbsp;pontj\u00e1ban kapott felhatalmaz\u00e1s alapj\u00e1n,\u003C\/p\u003E\n\u003Cp\u003E\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003Eaz Alapt\u00f6rv\u00e9ny 15.\u0026nbsp;cikk (1)\u0026nbsp;bekezd\u00e9s\u00e9ben meghat\u00e1rozott feladatk\u00f6r\u00e9ben elj\u00e1rva a\u0026nbsp;k\u00f6vetkez\u0151ket rendeli el:\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E1. A\u0026nbsp;nagy sebess\u00e9g\u0171 mobil h\u00edrk\u00f6zl\u00e9si h\u00e1l\u00f3zatfejleszt\u00e9si beruh\u00e1z\u00e1sok megval\u00f3s\u00edt\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 k\u00f6zigazgat\u00e1si hat\u00f3s\u00e1gi \u00fcgyek nemzetgazdas\u00e1gi szempontb\u00f3l kiemelt jelent\u0151s\u00e9g\u0171 \u00fcggy\u00e9 nyilv\u00e1n\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 484\/2017.\u0026nbsp;(XII. 28.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1sa\u003C\/p\u003E\n\u003Cp\u003E1.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA nagy sebess\u00e9g\u0171 mobil h\u00edrk\u00f6zl\u00e9si h\u00e1l\u00f3zatfejleszt\u00e9si beruh\u00e1z\u00e1sok megval\u00f3s\u00edt\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 k\u00f6zigazgat\u00e1si hat\u00f3s\u00e1gi \u00fcgyek nemzetgazdas\u00e1gi szempontb\u00f3l kiemelt jelent\u0151s\u00e9g\u0171 \u00fcggy\u00e9 nyilv\u00e1n\u00edt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3\u0026nbsp;\u003Cbr\u003E484\/2017.\u0026nbsp;(XII. 28.) Korm.\u0026nbsp;rendelet 1\/A.\u0026nbsp;\u00a7-\u00e1ban az\u0026nbsp;\u201eaz Energia\u00fcgyi Miniszt\u00e9rium\u201d sz\u00f6vegr\u00e9sz hely\u00e9be az\u0026nbsp;\u201ea\u201d sz\u00f6veg l\u00e9p.\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E2. A\u0026nbsp;Nemzeti H\u00edrk\u00f6zl\u00e9si \u00e9s Informatikai Tan\u00e1csr\u00f3l, valamint a\u0026nbsp;Digit\u00e1lis Korm\u00e1nyzati \u00dcgyn\u00f6ks\u00e9g Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g \u00e9s a\u0026nbsp;korm\u00e1nyzati informatikai beszerz\u00e9sek k\u00f6zpontos\u00edtott k\u00f6zbeszerz\u00e9si rendszer\u00e9r\u0151l sz\u00f3l\u00f3 301\/2018.\u0026nbsp;(XII. 27.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1sa\u003C\/p\u003E\n\u003Cp\u003E2.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA Nemzeti H\u00edrk\u00f6zl\u00e9si \u00e9s Informatikai Tan\u00e1csr\u00f3l, valamint a\u0026nbsp;Digit\u00e1lis Korm\u00e1nyzati \u00dcgyn\u00f6ks\u00e9g Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g \u00e9s a\u0026nbsp;korm\u00e1nyzati informatikai beszerz\u00e9sek k\u00f6zpontos\u00edtott k\u00f6zbeszerz\u00e9si rendszer\u00e9r\u0151l sz\u00f3l\u00f3 301\/2018.\u0026nbsp;(XII. 27.) Korm.\u0026nbsp;rendelet 15.\u0026nbsp;\u00a7 (5)\u0026nbsp;bekezd\u00e9se hely\u00e9be a\u0026nbsp;k\u00f6vetkez\u0151 rendelkez\u00e9s l\u00e9p:\u003C\/p\u003E\n\u003Cp\u003E\u201e(5) Az\u0026nbsp;NHIT tev\u00e9kenys\u00e9g\u00e9nek t\u00e1mogat\u00e1s\u00e1ra a\u0026nbsp;Korm\u00e1ny az\u0026nbsp;e-k\u00f6zigazgat\u00e1si \u00e9s informatikai fejleszt\u00e9sek egys\u00e9ges\u00edt\u00e9s\u00e9\u00e9rt felel\u0151s miniszter \u00e1ltal vezetett miniszt\u00e9riumot jel\u00f6li ki.\u201d\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E3. A\u0026nbsp;Digit\u00e1lis Magyarorsz\u00e1g \u00dcgyn\u00f6ks\u00e9g Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g kijel\u00f6l\u00e9s\u00e9r\u0151l \u00e9s egyes feladatainak meghat\u00e1roz\u00e1s\u00e1r\u00f3l, valamint a\u0026nbsp;nemzeti informatikai \u00e9s e-k\u00f6zigazgat\u00e1si tev\u00e9kenys\u00e9g \u00f6sszehangolt biztos\u00edt\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 r\u00e9szletszab\u00e1lyokr\u00f3l sz\u00f3l\u00f3 307\/2022.\u0026nbsp;(VIII. 11.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1sa\u003C\/p\u003E\n\u003Cp\u003E3.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA Digit\u00e1lis Magyarorsz\u00e1g \u00dcgyn\u00f6ks\u00e9g Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1g kijel\u00f6l\u00e9s\u00e9r\u0151l \u00e9s egyes feladatainak meghat\u00e1roz\u00e1s\u00e1r\u00f3l, valamint a\u0026nbsp;nemzeti informatikai \u00e9s e-k\u00f6zigazgat\u00e1si tev\u00e9kenys\u00e9g \u00f6sszehangolt biztos\u00edt\u00e1s\u00e1val \u00f6sszef\u00fcgg\u0151 r\u00e9szletszab\u00e1lyokr\u00f3l sz\u00f3l\u00f3 307\/2022.\u0026nbsp;(VIII. 11.) Korm.\u0026nbsp;rendelet (a\u0026nbsp;tov\u00e1bbiakban: R1.) 2.\u0026nbsp;\u00a7-a hely\u00e9be a\u0026nbsp;k\u00f6vetkez\u0151 rendelkez\u00e9s l\u00e9p:\u003C\/p\u003E\n\u003Cp\u003E\u201e2.\u0026nbsp;\u00a7 Az e-k\u00f6zigazgat\u00e1ssal, az\u0026nbsp;informatik\u00e1val, az\u0026nbsp;e-k\u00f6zigazgat\u00e1si \u00e9s informatikai fejleszt\u00e9sek egys\u00e9ges\u00edt\u00e9s\u00e9vel, a\u0026nbsp;korm\u00e1nyzati c\u00e9l\u00fa elektronikus h\u00edrk\u00f6zl\u00e9si tev\u00e9kenys\u00e9ggel, valamint a\u0026nbsp;k\u00f6zigazgat\u00e1si informatika infrastruktur\u00e1lis megval\u00f3s\u00edthat\u00f3s\u00e1g\u00e1nak biztos\u00edt\u00e1s\u00e1val kapcsolatos miniszteri felel\u0151ss\u00e9gbe tartoz\u00f3 egyes \u00e1llami feladatok ell\u00e1t\u00e1s\u00e1ra a\u0026nbsp;Korm\u00e1ny a\u0026nbsp;Digit\u00e1lis Magyarorsz\u00e1g \u00dcgyn\u00f6ks\u00e9g Z\u00e1rtk\u00f6r\u0171en M\u0171k\u00f6d\u0151 R\u00e9szv\u00e9nyt\u00e1rsas\u00e1got (a\u0026nbsp;tov\u00e1bbiakban: DM\u00dc) jel\u00f6li ki.\u201d\u003C\/p\u003E\n\u003Cp\u003E4.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EAz R1. 4.\u0026nbsp;\u00a7-\u00e1ban a\u0026nbsp;\u201eminiszter\u201d sz\u00f6vegr\u00e9sz hely\u00e9be a\u0026nbsp;\u201efelette az\u0026nbsp;\u00e1llamot megillet\u0151 tulajdonosi jogok \u00e9s k\u00f6telezetts\u00e9gek \u00f6sszess\u00e9g\u00e9t gyakorl\u00f3 miniszter (a\u0026nbsp;tov\u00e1bbiakban: miniszter)\u201d sz\u00f6veg l\u00e9p.\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E4. A\u0026nbsp;f\u0151v\u00e1rosi \u00e9s v\u00e1rmegyei korm\u00e1nyhivatalokr\u00f3l, valamint a\u0026nbsp;j\u00e1r\u00e1si (f\u0151v\u00e1rosi ker\u00fcleti) hivatalokr\u00f3l sz\u00f3l\u00f3 568\/2022.\u0026nbsp;(XII.\u0026nbsp;23.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1sa\u003C\/p\u003E\n\u003Cp\u003E5.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EA f\u0151v\u00e1rosi \u00e9s v\u00e1rmegyei korm\u00e1nyhivatalokr\u00f3l, valamint a\u0026nbsp;j\u00e1r\u00e1si (f\u0151v\u00e1rosi ker\u00fcleti) hivatalokr\u00f3l sz\u00f3l\u00f3 568\/2022.\u0026nbsp;(XII.\u0026nbsp;23.) Korm.\u0026nbsp;rendelet (a\u0026nbsp;tov\u00e1bbiakban: R2.) 6.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9se hely\u00e9be a\u0026nbsp;k\u00f6vetkez\u0151 rendelkez\u00e9s l\u00e9p:\u003C\/p\u003E\n\u003Cp\u003E\u201e(2) A\u0026nbsp;Korm\u00e1ny a\u0026nbsp;korm\u00e1nyhivatali feladatok ell\u00e1t\u00e1s\u00e1hoz sz\u00fcks\u00e9ges informatikai rendszerekre vonatkoz\u00f3an az\u0026nbsp;e-k\u00f6zigazgat\u00e1s\u00e9rt felel\u0151s minisztert jel\u00f6li ki az\u0026nbsp;informatikai rendszerekkel szembeni k\u00f6vetelm\u00e9nyek meghat\u00e1roz\u00e1s\u00e1ra, valamint a\u0026nbsp;Minisztereln\u00f6ks\u00e9g, illetve a\u0026nbsp;korm\u00e1nyhivatalok \u00e1ltal ind\u00edtott projektek keret\u00e9ben megval\u00f3sul\u00f3 informatikai alkalmaz\u00e1sfejleszt\u00e9sek ir\u00e1ny\u00edt\u00e1s\u00e1ra.\u201d\u003C\/p\u003E\n\u003Cp\u003E6.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EAz R2. 11.\u0026nbsp;\u00a7-a hely\u00e9be a\u0026nbsp;k\u00f6vetkez\u0151 rendelkez\u00e9s l\u00e9p:\u003C\/p\u003E\n\u003Cp\u003E\u201e11.\u0026nbsp;\u00a7 A miniszter a\u0026nbsp;10.\u0026nbsp;\u00a7 b)\u0026nbsp;pontja szerinti feladat\u00e1t, valamint az\u0026nbsp;e-k\u00f6zigazgat\u00e1s\u00e9rt felel\u0151s miniszter a\u0026nbsp;6.\u0026nbsp;\u00a7 (2)\u0026nbsp;bekezd\u00e9se szerinti feladat\u00e1t a\u0026nbsp;Lechner Tud\u00e1sk\u00f6zpont Nonprofit Korl\u00e1tolt Felel\u0151ss\u00e9g\u0171 T\u00e1rsas\u00e1g bevon\u00e1s\u00e1val l\u00e1tja\u0026nbsp;el.\u201d\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E5. Az\u0026nbsp;Eur\u00f3pai Uni\u00f3 mesters\u00e9ges intelligenci\u00e1r\u00f3l sz\u00f3l\u00f3 rendelet\u00e9nek magyarorsz\u00e1gi v\u00e9grehajt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2025.\u0026nbsp;\u00e9vi LXXV.\u0026nbsp;t\u00f6rv\u00e9ny v\u00e9grehajt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 344\/2025.\u0026nbsp;(X. 31.) Korm.\u0026nbsp;rendelet m\u00f3dos\u00edt\u00e1sa\u003C\/p\u003E\n\u003Cp\u003E7.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EHat\u00e1ly\u00e1t veszti az\u0026nbsp;Eur\u00f3pai Uni\u00f3 mesters\u00e9ges intelligenci\u00e1r\u00f3l sz\u00f3l\u00f3 rendelet\u00e9nek magyarorsz\u00e1gi v\u00e9grehajt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 2025.\u0026nbsp;\u00e9vi LXXV.\u0026nbsp;t\u00f6rv\u00e9ny v\u00e9grehajt\u00e1s\u00e1r\u00f3l sz\u00f3l\u00f3 344\/2025.\u0026nbsp;(X. 31.) Korm.\u0026nbsp;rendelet 5.\u0026nbsp;\u00a7 (1)\u0026nbsp;bekezd\u00e9s e)\u0026nbsp;pontja.\u003C\/p\u003E\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\n\u003Cp\u003E6. Z\u00e1r\u00f3 rendelkez\u00e9sek\u003C\/p\u003E\n\u003Cp\u003E8.\u0026nbsp;\u00a7\u003Cspan\u003E\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003C\/span\u003EEz a\u0026nbsp;rendelet a\u0026nbsp;kihirdet\u00e9s\u00e9t k\u00f6vet\u0151\u0026nbsp;napon l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\n","summary":""},"field_ai_summary":{"value":"\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyrendelet c\u00e9lja a 2026. szeptember 1-j\u00e9t\u0151l hat\u00e1lyos miniszt\u00e9riumi feladat- \u00e9s hat\u00e1sk\u00f6ri v\u00e1ltoz\u00e1sok \u00e1tvezet\u00e9se t\u00f6bb, digit\u00e1lis, informatikai, h\u00edrk\u00f6zl\u00e9si \u00e9s mesters\u00e9ges intelligenci\u00e1val kapcsolatos korm\u00e1nyrendeletben.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA nagy sebess\u00e9g\u0171 mobil h\u00edrk\u00f6zl\u00e9si h\u00e1l\u00f3zatfejleszt\u00e9si beruh\u00e1z\u00e1sokra vonatkoz\u00f3 szab\u00e1lyokban technikai sz\u00f6vegm\u00f3dos\u00edt\u00e1s t\u00f6rt\u00e9nik, az Energia\u00fcgyi Miniszt\u00e9riumra utal\u00f3 megnevez\u00e9st m\u00f3dos\u00edtj\u00e1k.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Nemzeti H\u00edrk\u00f6zl\u00e9si \u00e9s Informatikai Tan\u00e1cs t\u00e1mogat\u00e1s\u00e1ra a Korm\u00e1ny az e-k\u00f6zigazgat\u00e1si \u00e9s informatikai fejleszt\u00e9sek egys\u00e9ges\u00edt\u00e9s\u00e9\u00e9rt felel\u0151s miniszter \u00e1ltal vezetett miniszt\u00e9riumot jel\u00f6li ki.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Digit\u00e1lis Magyarorsz\u00e1g \u00dcgyn\u00f6ks\u00e9g feladatk\u00f6re pontos\u00edt\u00e1sra ker\u00fcl, az \u00fcgyn\u00f6ks\u00e9g az e-k\u00f6zigazgat\u00e1s, informatika, egys\u00e9ges informatikai fejleszt\u00e9sek, korm\u00e1nyzati c\u00e9l\u00fa elektronikus h\u00edrk\u00f6zl\u00e9s \u00e9s k\u00f6zigazgat\u00e1si informatikai infrastrukt\u00fara ter\u00fclet\u00e9n l\u00e1t el kijel\u00f6lt \u00e1llami feladatokat.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Digit\u00e1lis Magyarorsz\u00e1g \u00dcgyn\u00f6ks\u00e9gn\u00e9l pontos\u00edtj\u00e1k, hogy melyik miniszter gyakorolja az \u00e1llami tulajdonosi jogokat \u00e9s k\u00f6telezetts\u00e9geket.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA korm\u00e1nyhivatalok informatikai rendszereivel kapcsolatban az e-k\u00f6zigazgat\u00e1s\u00e9rt felel\u0151s miniszter kap szerepet a k\u00f6vetelm\u00e9nyek meghat\u00e1roz\u00e1s\u00e1ban \u00e9s az informatikai alkalmaz\u00e1sfejleszt\u00e9sek ir\u00e1ny\u00edt\u00e1s\u00e1ban.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA korm\u00e1nyhivatali \u00e9s e-k\u00f6zigazgat\u00e1si informatikai feladatok ell\u00e1t\u00e1s\u00e1ban tov\u00e1bbra is k\u00f6zrem\u0171k\u00f6dik a Lechner Tud\u00e1sk\u00f6zpont Nonprofit Kft.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA mesters\u00e9ges intelligenci\u00e1r\u00f3l sz\u00f3l\u00f3 uni\u00f3s rendelet hazai v\u00e9grehajt\u00e1si szab\u00e1lyai k\u00f6z\u00fcl hat\u00e1lyon k\u00edv\u00fcl helyeznek egy rendelkez\u00e9st.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyrendelet a kihirdet\u00e9s\u00e9t k\u00f6vet\u0151 napon l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003C\/ul\u003E\n","format":"full_html","processed":"\u003Cul\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyrendelet c\u00e9lja a 2026. szeptember 1-j\u00e9t\u0151l hat\u00e1lyos miniszt\u00e9riumi feladat- \u00e9s hat\u00e1sk\u00f6ri v\u00e1ltoz\u00e1sok \u00e1tvezet\u00e9se t\u00f6bb, digit\u00e1lis, informatikai, h\u00edrk\u00f6zl\u00e9si \u00e9s mesters\u00e9ges intelligenci\u00e1val kapcsolatos korm\u00e1nyrendeletben.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA nagy sebess\u00e9g\u0171 mobil h\u00edrk\u00f6zl\u00e9si h\u00e1l\u00f3zatfejleszt\u00e9si beruh\u00e1z\u00e1sokra vonatkoz\u00f3 szab\u00e1lyokban technikai sz\u00f6vegm\u00f3dos\u00edt\u00e1s t\u00f6rt\u00e9nik, az Energia\u00fcgyi Miniszt\u00e9riumra utal\u00f3 megnevez\u00e9st m\u00f3dos\u00edtj\u00e1k.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Nemzeti H\u00edrk\u00f6zl\u00e9si \u00e9s Informatikai Tan\u00e1cs t\u00e1mogat\u00e1s\u00e1ra a Korm\u00e1ny az e-k\u00f6zigazgat\u00e1si \u00e9s informatikai fejleszt\u00e9sek egys\u00e9ges\u00edt\u00e9s\u00e9\u00e9rt felel\u0151s miniszter \u00e1ltal vezetett miniszt\u00e9riumot jel\u00f6li ki.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Digit\u00e1lis Magyarorsz\u00e1g \u00dcgyn\u00f6ks\u00e9g feladatk\u00f6re pontos\u00edt\u00e1sra ker\u00fcl, az \u00fcgyn\u00f6ks\u00e9g az e-k\u00f6zigazgat\u00e1s, informatika, egys\u00e9ges informatikai fejleszt\u00e9sek, korm\u00e1nyzati c\u00e9l\u00fa elektronikus h\u00edrk\u00f6zl\u00e9s \u00e9s k\u00f6zigazgat\u00e1si informatikai infrastrukt\u00fara ter\u00fclet\u00e9n l\u00e1t el kijel\u00f6lt \u00e1llami feladatokat.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Digit\u00e1lis Magyarorsz\u00e1g \u00dcgyn\u00f6ks\u00e9gn\u00e9l pontos\u00edtj\u00e1k, hogy melyik miniszter gyakorolja az \u00e1llami tulajdonosi jogokat \u00e9s k\u00f6telezetts\u00e9geket.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA korm\u00e1nyhivatalok informatikai rendszereivel kapcsolatban az e-k\u00f6zigazgat\u00e1s\u00e9rt felel\u0151s miniszter kap szerepet a k\u00f6vetelm\u00e9nyek meghat\u00e1roz\u00e1s\u00e1ban \u00e9s az informatikai alkalmaz\u00e1sfejleszt\u00e9sek ir\u00e1ny\u00edt\u00e1s\u00e1ban.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA korm\u00e1nyhivatali \u00e9s e-k\u00f6zigazgat\u00e1si informatikai feladatok ell\u00e1t\u00e1s\u00e1ban tov\u00e1bbra is k\u00f6zrem\u0171k\u00f6dik a Lechner Tud\u00e1sk\u00f6zpont Nonprofit Kft.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA mesters\u00e9ges intelligenci\u00e1r\u00f3l sz\u00f3l\u00f3 uni\u00f3s rendelet hazai v\u00e9grehajt\u00e1si szab\u00e1lyai k\u00f6z\u00fcl hat\u00e1lyon k\u00edv\u00fcl helyeznek egy rendelkez\u00e9st.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\n\u003Cp\u003EA Korm\u00e1nyrendelet a kihirdet\u00e9s\u00e9t k\u00f6vet\u0151 napon l\u00e9p hat\u00e1lyba.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003C\/ul\u003E\n"},"field_correction":false,"field_njt_url":null,"field_page_number":2,"field_regulation_number":"224\/2026. (X. 1.) Korm. rendelet","field_regulation_title":"A tudom\u00e1nyos \u00e9s technol\u00f3giai miniszter feladat- \u00e9s hat\u00e1sk\u00f6r\u00e9vel \u00f6sszef\u00fcgg\u0151 egyes korm\u00e1nyrendeletek m\u00f3dos\u00edt\u00e1s\u00e1r\u00f3l","field_synonym":"gyermekgondoz\u00e1st seg\u00edt\u0151 ell\u00e1t\u00e1s\nnyaral\u00f3\nk\u00e1eft\u00e9\nkorm\u00e1nyf\u0151\nr\u00e1di\u00f3t\u00e1vk\u00f6zl\u00e9s\nterm\u00e9szetes szem\u00e9ly\nvas\u00fat\nrecept\nkutya\ngazdi\ntelefon"},"relationships":{"node_type":{"data":{"type":"node_type--node_type","id":"2de4f0c4-1ed1-4766-9521-6ae4441af5d5","meta":{"drupal_internal__target_id":"issue_unit"}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/843533b2-7cb3-4b2d-b610-785fb4553b86\/node_type?resourceVersion=id%3A218007"},"self":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/issue_unit\/843533b2-7cb3-4b2d-b610-785fb4553b86\/relationships\/node_type?resourceVersion=id%3A218007"}}},"revision_uid":{"data":{"type":"user--user","id":"88687bb7-61de-4013-a5bd-0bddeed53e90","meta":{"drupal_internal__target_id":38}},"links":{"related":{"href":"https:\/\/jog.gov.hu:80\/jsonapi\/node\/i